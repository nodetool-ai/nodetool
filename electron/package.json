{
  "name": "nodetool-electron",
  "version": "0.8.2",
  "private": true,
  "description": "node-based AI development tool",
  "homepage": "https://nodetool.ai",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:devmode": "electron .",
    "chat": "electron . --chat",
    "prepare-backend": "node ../scripts/bundle-backend.mjs",
    "prepare-mcpb": "node ../scripts/build-mcpb.mjs --out mcpb/nodetool.mcpb",
    "prepare-chrome-extension": "npm --prefix ../chrome-extension ci && npm --prefix ../chrome-extension run build",
    "verify:python-packages": "node scripts/verify-python-packages.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:backend-bundle": "node ../scripts/verify-backend-bundle.mjs",
    "build": "node ../scripts/run-tsc.mjs && vite build && node scripts/fetch-node-runtime.mjs && npm run prepare-backend && npm run prepare-mcpb && npm run prepare-chrome-extension && npm run verify:bundle && electron-builder",
    "vite:build": "vite build && node scripts/verify-bundle.mjs",
    "typecheck": "node ../scripts/run-tsc.mjs --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "check": "node ../scripts/run-tsc.mjs && eslint . && jest",
    "dev": "vite",
    "preview": "vite preview",
    "predist": "npm run build",
    "dist": "electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "rebuild:native": "node scripts/rebuild-native.mjs"
  },
  "author": "matti.georgi@gmail.com",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/sandbox-compiler": "*",
    "@nodetool-ai/websocket": "*",
    "@trpc/client": "^11.19.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^12.11.1",
    "bufferutil": "^4.1.0",
    "electron": "41.10.6",
    "electron-builder": "26.16.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "msgpackr": "^1.12.1",
    "node-llama-cpp": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "sqlite-vec": "^0.1.9",
    "ts-jest": "^29.4.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^0.29.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@nodetool-ai/protocol": "*",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  },
  "overrides": {
    "minimatch": ">=3.1.4",
    "undici": ">=6.24.0",
    "flatted": ">=3.4.2",
    "lodash": ">=4.17.23",
    "ajv": ">=6.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git"
  }
}
