(module
  (memory (export "memory") 1)
  (func (export "process") (param $buf i32) (param $frames i32) (param $nb i32) (param $coef i32) (param $state i32)
    (local $ch i32) (local $k i32) (local $p i32) (local $end i32) (local $cp i32) (local $sp i32)
    (local $b0 f32) (local $b1 f32) (local $b2 f32) (local $a1 f32) (local $a2 f32)
    (local $z1 f32) (local $z2 f32) (local $x f32) (local $y f32)
    (block $chdone
      (loop $chloop
        (br_if $chdone (i32.ge_u (local.get $ch) (i32.const 2)))
        (local.set $k (i32.const 0))
        (block $kdone
          (loop $kloop
            (br_if $kdone (i32.ge_u (local.get $k) (local.get $nb)))
            (local.set $cp (i32.add (local.get $coef) (i32.mul (local.get $k) (i32.const 20))))
            (local.set $b0 (f32.load (local.get $cp)))
            (local.set $b1 (f32.load offset=4 (local.get $cp)))
            (local.set $b2 (f32.load offset=8 (local.get $cp)))
            (local.set $a1 (f32.load offset=12 (local.get $cp)))
            (local.set $a2 (f32.load offset=16 (local.get $cp)))
            (local.set $sp (i32.add (local.get $state)
              (i32.mul (i32.add (i32.mul (local.get $ch) (local.get $nb)) (local.get $k)) (i32.const 8))))
            (local.set $z1 (f32.load (local.get $sp)))
            (local.set $z2 (f32.load offset=4 (local.get $sp)))
            (local.set $p (i32.add (local.get $buf) (i32.shl (local.get $ch) (i32.const 2))))
            (local.set $end (i32.add (local.get $p) (i32.shl (local.get $frames) (i32.const 3))))
            (block $idone
              (loop $iloop
                (br_if $idone (i32.ge_u (local.get $p) (local.get $end)))
                (local.set $x (f32.load (local.get $p)))
                (local.set $y (f32.add (f32.mul (local.get $b0) (local.get $x)) (local.get $z1)))
                (local.set $z1 (f32.add (f32.sub (f32.mul (local.get $b1) (local.get $x)) (f32.mul (local.get $a1) (local.get $y))) (local.get $z2)))
                (local.set $z2 (f32.sub (f32.mul (local.get $b2) (local.get $x)) (f32.mul (local.get $a2) (local.get $y))))
                (f32.store (local.get $p) (local.get $y))
                (local.set $p (i32.add (local.get $p) (i32.const 8)))
                (br $iloop)))
            (f32.store (local.get $sp) (local.get $z1))
            (f32.store offset=4 (local.get $sp) (local.get $z2))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $kloop)))
        (local.set $ch (i32.add (local.get $ch) (i32.const 1)))
        (br $chloop))))
  (func (export "mix") (param $dst i32) (param $a i32) (param $b i32) (param $n i32) (param $ga f32) (param $gb f32)
    (local $i i32) (local $end i32)
    (local.set $end (i32.shl (local.get $n) (i32.const 2)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $end)))
      (f32.store (i32.add (local.get $dst) (local.get $i))
        (f32.add (f32.mul (f32.load (i32.add (local.get $a) (local.get $i))) (local.get $ga))
                 (f32.mul (f32.load (i32.add (local.get $b) (local.get $i))) (local.get $gb))))
      (local.set $i (i32.add (local.get $i) (i32.const 4)))
      (br $l))))
  (func (export "mix_simd") (param $dst i32) (param $a i32) (param $b i32) (param $n i32) (param $ga f32) (param $gb f32)
    (local $i i32) (local $end i32) (local $vga v128) (local $vgb v128)
    (local.set $vga (f32x4.splat (local.get $ga)))
    (local.set $vgb (f32x4.splat (local.get $gb)))
    (local.set $end (i32.shl (local.get $n) (i32.const 2)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $end)))
      (v128.store (i32.add (local.get $dst) (local.get $i))
        (f32x4.add (f32x4.mul (v128.load (i32.add (local.get $a) (local.get $i))) (local.get $vga))
                   (f32x4.mul (v128.load (i32.add (local.get $b) (local.get $i))) (local.get $vgb))))
      (local.set $i (i32.add (local.get $i) (i32.const 16)))
      (br $l)))))
