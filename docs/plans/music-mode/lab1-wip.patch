+bool migrateEffectArray(QJsonArray& effects, LabMigrationMap& map) {
+    bool changed = false;
+    QJsonArray next;
+    for (const QJsonValue& ev : effects) {
+        const QJsonObject e = ev.toObject();
+        if (e.value(u"type").toString() != u"fable" || e.value(u"kind").toString() != u"lab") {
+            next.append(ev);
+            continue;
+        }
+        changed = true;
+        const QString oldId = e.value(u"id").toString();
+        map.oldLabIds.insert(oldId);
+        const QJsonObject oldParams = e.value(u"params").toObject();
+        const bool enabled = e.value(u"enabled").toBool(true);
+        const bool hasBpm = e.contains(u"bpm");
+        const QJsonValue bpmVal = e.value(u"bpm");
+        for (const auto& unit : kLabUnits) {
+            if (!labUnitEnabled(oldParams, unit.onParam)) { continue; }
+            const QString newId = labMigratedEffectId(oldId, unit.kind);
+            map.unitIds.insert(oldId + u'\n' + unit.kind.toString(), newId);
+            QJsonObject params = labUnitDefaultParams(unit.kind);
+            for (auto it = oldParams.begin(); it != oldParams.end(); ++it) {
+                if (it.key().startsWith(unit.prefix) && it.key() != unit.onParam) {
+                    params.insert(it.key(), it.value());
+                }
+            }
+            QJsonObject migrated{
+                {"id", newId},
+                {"type", QStringLiteral("fable")},
+                {"enabled", enabled},
+                {"kind", unit.kind.toString()},
+                {"params", params},
+            };
+            if (hasBpm) { migrated.insert(u"bpm", bpmVal); }
+            next.append(migrated);
+        }
+    }
+    if (changed) { effects = next; }
+    return changed;
+}
+
+void migrateAutomationLanes(QJsonObject& container, const LabMigrationMap& map) {
+    if (map.empty() || !container.contains(u"automation")) { return; }
+    const QJsonArray lanes = container.value(u"automation").toArray();
+    QJsonArray next;
+    bool changed = false;
+    for (const QJsonValue& lv : lanes) {
+        QJsonObject lane = lv.toObject();
+        QJsonObject target = lane.value(u"target").toObject();
+        const QString deviceId = target.value(u"deviceId").toString();
+        if (target.value(u"kind").toString() != u"device" || !map.oldLabIds.contains(deviceId)) {
+            next.append(lv);
+            continue;
+        }
+        changed = true;
+        bool isOnParam = false;
+        const QStringView unitKind = labUnitForParam(target.value(u"param").toString(), isOnParam);
+        if (unitKind.isEmpty() || isOnParam) { continue; }
+        const QString newId = map.mappedId(deviceId, unitKind);
+        if (newId.isEmpty()) { continue; }
+        target.insert(u"deviceId", newId);
+        lane.insert(u"target", target);
+        next.append(lane);
+    }
+    if (changed) { container.insert(u"automation", next); }
+}
+
+void migrateClipPatternAutomation(QJsonObject& clip, const LabMigrationMap& map) {
+    if (map.empty() || !clip.value(u"pattern").isObject()) { return; }
+    QJsonObject pattern = clip.value(u"pattern").toObject();
+    QJsonArray rows = pattern.value(u"rows").toArray();
+    bool changed = false;
+    for (qsizetype i = 0; i < rows.size(); ++i) {
+        QJsonObject row = rows[i].toObject();
+        QJsonObject assign = row.value(u"assignment").toObject();
+        QJsonObject target = assign.value(u"target").toObject();
+        const QString deviceId = target.value(u"deviceId").toString();
+        if (assign.value(u"type").toString() != u"automation" ||
+            target.value(u"kind").toString() != u"device" || !map.oldLabIds.contains(deviceId)) {
+            continue;
+        }
+        bool isOnParam = false;
+        const QStringView unitKind = labUnitForParam(target.value(u"param").toString(), isOnParam);
+        if (unitKind.isEmpty() || isOnParam) { continue; }
+        const QString newId = map.mappedId(deviceId, unitKind);
+        if (newId.isEmpty()) { continue; }
+        target.insert(u"deviceId", newId);
+        assign.insert(u"target", target);
+        row.insert(u"assignment", assign);
+        rows[i] = row;
+        changed = true;
+    }
+    if (changed) {
+        pattern.insert(u"rows", rows);
+        clip.insert(u"pattern", pattern);
+    }
+}
+
+QJsonObject migrateLabEffects(const QJsonObject& root) {
+    QJsonObject migrated = root;
+    bool anyChanged = false;
+
+    if (migrated.value(u"master").isObject()) {
+        QJsonObject master = migrated.value(u"master").toObject();
+        QJsonArray effects = master.value(u"effects").toArray();
+        LabMigrationMap masterMap;
+        if (migrateEffectArray(effects, masterMap)) {
+            master.insert(u"effects", effects);
+            migrateAutomationLanes(master, masterMap);
+            migrated.insert(u"master", master);
+            anyChanged = true;
+        }
+    }
+
+    QHash<QString, LabMigrationMap> trackMaps;
+    if (migrated.value(u"tracks").isArray()) {
+        QJsonArray tracks = migrated.value(u"tracks").toArray();
+        bool tracksChanged = false;
+        for (qsizetype i = 0; i < tracks.size(); ++i) {
+            QJsonObject track = tracks[i].toObject();
+            QJsonArray effects = track.value(u"effects").toArray();
+            LabMigrationMap trackMap;
+            if (migrateEffectArray(effects, trackMap)) {
+                track.insert(u"effects", effects);
+                migrateAutomationLanes(track, trackMap);
+                tracks[i] = track;
+                trackMaps.insert(track.value(u"id").toString(), std::move(trackMap));
+                tracksChanged = true;
+            }
+        }
+        if (tracksChanged) {
+            migrated.insert(u"tracks", tracks);
+            anyChanged = true;
+        }
+    }
+
+    if (migrated.value(u"clips").isArray()) {
+        QJsonArray clips = migrated.value(u"clips").toArray();
+        bool clipsChanged = false;
+        for (qsizetype i = 0; i < clips.size(); ++i) {
+            QJsonObject clip = clips[i].toObject();
+            bool clipChanged = false;
+            if (clip.value(u"audioEffects").isArray()) {
+                QJsonArray effects = clip.value(u"audioEffects").toArray();
+                LabMigrationMap clipMap;
+                if (migrateEffectArray(effects, clipMap)) {
+                    clip.insert(u"audioEffects", effects);
+                    clipChanged = true;
+                }
+            }
+            const auto foundTrack = trackMaps.constFind(clip.value(u"trackId").toString());
+            if (foundTrack != trackMaps.constEnd()) {
+                const QJsonObject before = clip;
+                migrateClipPatternAutomation(clip, foundTrack.value());
+                if (clip != before) { clipChanged = true; }
+            }
+            if (clipChanged) {
+                clips[i] = clip;
+                clipsChanged = true;
+            }
+        }
+        if (clipsChanged) {
+            migrated.insert(u"clips", clips);
+            anyChanged = true;
+        }
+    }
+
+    return anyChanged ? migrated : root;
+}
