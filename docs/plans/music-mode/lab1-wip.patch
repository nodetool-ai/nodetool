+    return QUuid::createUuidV5(kNamespace, oldId + u':' + kind.toString()).toString(QUuid::Id128);
+}
+
+QStringView labUnitForParam(const QString& param, bool& isOnParam) {
+    isOnParam = false;
+    for (const auto& unit : kLabUnits) {
