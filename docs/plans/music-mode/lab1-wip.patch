+FableCrushProcessor::FableCrushProcessor(const QJsonObject& effect) {
+    id = effect.value(u"id").toString().toStdString();
+    on_ = effect.value(u"enabled").toBool(true);
+    bits_ = static_cast<float>(std::clamp(readParam(effect, "fx.crush.bits", 6.0), 1.0, 16.0));
+    rate_ = static_cast<float>(std::clamp(readParam(effect, "fx.crush.rate", 6000.0), 200.0, 48000.0));
+    chaos_ = static_cast<float>(std::clamp(readParam(effect, "fx.crush.chaos", 0.2), 0.0, 1.0));
+    mix_ = static_cast<float>(std::clamp(readParam(effect, "fx.crush.mix", 1.0), 0.0, 1.0));
+}
+
+void FableCrushProcessor::applyParams() noexcept {
+    crush_.setParams(on_, bits_, rate_, chaos_, mix_);
+}
+
+void FableCrushProcessor::prepare(double sampleRate) {
+    threadGuard_.unbind();
+    crush_.prepare(sampleRate);
+    prepared_ = true;
+    applyParams();
+    crush_.reset();
+}
