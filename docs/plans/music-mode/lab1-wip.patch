+    [[nodiscard]] bool empty() const { return oldLabIds.isEmpty(); }
+    [[nodiscard]] QString mappedId(const QString& oldId, QStringView kind) const {
+        return unitIds.value(oldId + u'\n' + kind.toString());
+    }
