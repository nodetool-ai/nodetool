+// ---------------- FableShiftProcessor ----------------
+
+FableShiftProcessor::FableShiftProcessor(const QJsonObject& effect, double tempoBpm) {
+    id = effect.value(u"id").toString().toStdString();
+    on_ = effect.value(u"enabled").toBool(true);
+    const double jsonBpm = readParam(effect, "bpm", 0.0);
+    tempoBpm_ = (std::isfinite(tempoBpm) && tempoBpm > 1.0)
+        ? std::clamp(tempoBpm, 40.0, 300.0)
+        : ((std::isfinite(jsonBpm) && jsonBpm > 1.0) ? std::clamp(jsonBpm, 40.0, 300.0) : 120.0);
+    hz_ = static_cast<float>(std::clamp(readParam(effect, "fx.shift.hz", 60.0), -1000.0, 1000.0));
+    fb_ = static_cast<float>(std::clamp(readParam(effect, "fx.shift.fb", 0.5), 0.0, 0.9));
+    spread_ = static_cast<float>(std::clamp(readParam(effect, "fx.shift.spread", 0.5), 0.0, 1.0));
+    mix_ = static_cast<float>(std::clamp(readParam(effect, "fx.shift.mix", 0.5), 0.0, 1.0));
+}
+
+void FableShiftProcessor::applyParams() noexcept {
+    shift_.setParams(on_, hz_, fb_, spread_, mix_, tempoBpm_);
+}
+
+void FableShiftProcessor::prepare(double sampleRate) {
+    threadGuard_.unbind();
+    shift_.prepare(sampleRate);
+    prepared_ = true;
+    applyParams();
+    shift_.reset();
+}
+
+void FableShiftProcessor::reset() noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(false);
+    BlockProcessor::reset();
+    shift_.reset();
+}
+
+void FableShiftProcessor::setTempoBpm(double tempoBpm) noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(false);
+    if (!std::isfinite(tempoBpm) || tempoBpm <= 1.0) {
+        return;
+    }
+    tempoBpm_ = std::clamp(tempoBpm, 40.0, 300.0);
+    if (prepared_) {
+        applyParams();
+    }
+}
+
+bool FableShiftProcessor::setParameter(std::string_view key, double value) noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(false);
+    if (!std::isfinite(value)) {
+        return false;
+    }
+    if (key == "fx.shift.hz") {
+        hz_ = static_cast<float>(std::clamp(value, -1000.0, 1000.0));
+    } else if (key == "fx.shift.fb") {
+        fb_ = static_cast<float>(std::clamp(value, 0.0, 0.9));
+    } else if (key == "fx.shift.spread") {
+        spread_ = static_cast<float>(std::clamp(value, 0.0, 1.0));
+    } else if (key == "fx.shift.mix") {
+        mix_ = static_cast<float>(std::clamp(value, 0.0, 1.0));
+    } else if (key == "bpm" || key == "tempo.bpm") {
+        if (value <= 1.0) {
+            return false;
+        }
+        tempoBpm_ = std::clamp(value, 40.0, 300.0);
+    } else {
+        return false;
+    }
+    if (prepared_) {
+        applyParams();
+    }
+    return true;
+}
+
+void FableShiftProcessor::process(std::span<float> stereo, const nt::audio::BlockContext& context) noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(true);
+    const double ctxBpm = contextTempoBpm(context);
+    if (std::isfinite(ctxBpm) && ctxBpm > 1.0) {
+        const double clampedBpm = std::clamp(ctxBpm, 40.0, 300.0);
+        if (clampedBpm != tempoBpm_) {
+            tempoBpm_ = clampedBpm;
+            if (prepared_) {
+                applyParams();
+            }
+        }
+    }
+    processStereoChunks(shift_, stereo);
+}
+
+bool FableShiftProcessor::hasPendingOutput(int) const noexcept {
+    return shift_.hasPendingOutput();
+}
