+        QVERIFY(!crushParams.contains(u"fx.crush.on"));
+        QCOMPARE(crushParams.value(u"fx.crush.bits").toDouble(), 4.0);
+        QCOMPARE(crushParams.value(u"fx.crush.rate").toDouble(), 3200.0);
+        QCOMPARE(crushParams.value(u"fx.crush.chaos").toDouble(), 0.5);
+        QCOMPARE(crushParams.value(u"fx.crush.mix").toDouble(), 0.8);
+        QCOMPARE(effects[2].toObject().value(u"params").toObject().value(u"fx.shift.hz").toDouble(), -120.0);
+        QVERIFY(!effects[2].toObject().value(u"params").toObject().contains(u"fx.shift.on"));
+        QCOMPARE(effects[3].toObject().value(u"params").toObject().value(u"fx.glitch.div").toDouble(), 1.0);
+        QCOMPARE(effects[4].toObject().value(u"enabled").toBool(true), false);
+        QCOMPARE(effects[4].toObject().value(u"params").toObject().value(u"fx.reso.note").toDouble(), 55.0);
+
+        // Automation lanes remapped to new unit IDs; dropped for .on and disabled units.
+        const QJsonArray lanes = tl.tracks[0].raw.value(u"automation").toArray();
+        QCOMPARE(lanes.size(), 5);
+        QCOMPARE(lanes[0].toObject().value(u"id").toString(), QStringLiteral("l-vol"));
+        QCOMPARE(lanes[1].toObject().value(u"target").toObject().value(u"deviceId").toString(), QStringLiteral("fx-drive"));
+        QCOMPARE(lanes[2].toObject().value(u"id").toString(), QStringLiteral("l-crush"));
+        QCOMPARE(lanes[2].toObject().value(u"target").toObject().value(u"deviceId").toString(), crushId);
+        QCOMPARE(lanes[3].toObject().value(u"id").toString(), QStringLiteral("l-shift"));
+        QCOMPARE(lanes[3].toObject().value(u"target").toObject().value(u"deviceId").toString(), shiftId);
+        QCOMPARE(lanes[4].toObject().value(u"id").toString(), QStringLiteral("l-glitch"));
+        QCOMPARE(lanes[4].toObject().value(u"target").toObject().value(u"deviceId").toString(), glitchId);
+
+        // Master and clip audioEffects migrated too.
+        const QJsonArray masterFx = tl.raw.value(u"master").toObject().value(u"effects").toArray();
+        QCOMPARE(masterFx.size(), 1);
+        QCOMPARE(masterFx[0].toObject().value(u"kind").toString(), QStringLiteral("spray"));
+        QCOMPARE(masterFx[0].toObject().value(u"params").toObject().value(u"fx.spray.pitch").toDouble(), -12.0);
+        const QJsonArray clipFx = tl.clips[0].raw.value(u"audioEffects").toArray();
+        QCOMPARE(clipFx.size(), 1);
+        QCOMPARE(clipFx[0].toObject().value(u"kind").toString(), QStringLiteral("crush"));
+        QCOMPARE(clipFx[0].toObject().value(u"params").toObject().value(u"fx.crush.bits").toDouble(), 8.0);
+
+        // Reloading the migrated raw document is idempotent.
+        const auto reloaded = nt::parseTimeline(tl.raw);
+        QVERIFY2(reloaded.timeline.has_value(), qPrintable(reloaded.error));
+        QCOMPARE(reloaded.timeline->tracks[0].raw.value(u"effects").toArray(), effects);
+        QCOMPARE(reloaded.timeline->tracks[0].raw.value(u"automation").toArray(), lanes);
+    }
 };
 
 QTEST_APPLESS_MAIN(TestTimelineJson)
