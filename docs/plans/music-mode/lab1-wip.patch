+
+void Biquad::set(bool high, double hz, double q, double sr) noexcept {
+    const double w = 2.0 * kLabPi * hz / sr;
+    const double c = std::cos(w);
+    const double al = std::sin(w) / (2.0 * q);
+    const double a0 = 1.0 + al;
+    const double k = high ? (1.0 + c) / 2.0 : (1.0 - c) / 2.0;
+    b0 = k / a0;
+    b1 = (high ? -2.0 * k : 2.0 * k) / a0;
+    b2 = k / a0;
+    a1 = -2.0 * c / a0;
+    a2 = (1.0 - al) / a0;
+}
+
+void Butter8::set(bool high, double hz, double sr) noexcept {
+    static constexpr std::array<double, 4> kQ{{
+        0.5097955791041592,
+        0.6013448869350453,
+        0.8999762231364156,
+        2.5629154477415055,
+    }};
+    for (std::size_t i = 0; i < 4; ++i) {
+        s[i].set(high, hz, kQ[i], sr);
+    }
+}
+
+void Ring::prepare(int minSize) {
+    int n = 1;
+    const int target = std::max(8, minSize);
+    while (n < target) {
+        n <<= 1;
+    }
+    b.assign(static_cast<std::size_t>(n), 0.0f);
+    mask = static_cast<std::int64_t>(n - 1);
+    w = 0;
+}
+
+void Ring::clear() noexcept {
+    std::ranges::fill(b, 0.0f);
+    w = 0;
+}
+
+double Ring::hermite(double p) const noexcept {
+    const double fl = std::floor(p);
+    const auto i = static_cast<std::int64_t>(fl);
+    const double t = p - fl;
+    const double y0 = at(i - 1);
+    const double y1 = at(i);
+    const double y2 = at(i + 1);
+    const double y3 = at(i + 2);
+    const double c1 = 0.5 * (y2 - y0);
+    const double c2 = y0 - 2.5 * y1 + 2.0 * y2 - 0.5 * y3;
+    const double c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
+    return ((c3 * t + c2) * t + c1) * t + y1;
+}
+
+namespace {
+double bessel0(double x) noexcept {
+    double sum = 1.0;
+    double term = 1.0;
+    for (int k = 1; k < 50; ++k) {
+        const double r = x / (2.0 * static_cast<double>(k));
+        term *= r * r;
+        sum += term;
+        if (term < 1.0e-15 * sum) {
+            break;
+        }
+    }
+    return sum;
+}
+}  // namespace
+
+void SincTable::build() {
+    constexpr double kBeta = 7.5;
+    const double norm = bessel0(kBeta);
+    h.assign(static_cast<std::size_t>(kHalf * kRes + 2), 0.0);
+    for (int i = 0; i <= kHalf * kRes; ++i) {
+        const double x = static_cast<double>(i) / static_cast<double>(kRes);
+        const double r = x / static_cast<double>(kHalf);
+        const double sinc = (i == 0) ? 1.0 : std::sin(kLabPi * x) / (kLabPi * x);
+        h[static_cast<std::size_t>(i)] = sinc * bessel0(kBeta * std::sqrt(std::max(0.0, 1.0 - r * r))) / norm;
+    }
+}
+
+double SincTable::tap(double x) const noexcept {
+    const double scaled = std::abs(x) * static_cast<double>(kRes);
+    const int i = static_cast<int>(scaled);
+    if (i >= kHalf * kRes || h.empty()) {
+        return 0.0;
+    }
+    const auto idx = static_cast<std::size_t>(i);
+    return h[idx] + (scaled - static_cast<double>(i)) * (h[idx + 1] - h[idx]);
+}
+
+double SincTable::read(const Ring& r, double p, double fc) const noexcept {
+    const int half = static_cast<int>(std::ceil(static_cast<double>(kHalf) / fc));
+    const double fl = std::floor(p);
+    const auto i0 = static_cast<std::int64_t>(fl);
+    const double frac = p - fl;
+    double sum = 0.0;
+    for (int k = 1 - half; k <= half; ++k) {
+        sum += tap((static_cast<double>(k) - frac) * fc) * r.at(i0 + k);
+    }
+    return sum * fc;
+}
+
+void Hilbert::process(double x, double& re, double& im) noexcept {
+    const auto chain = [](const std::array<double, 4>& k,
+                          std::array<std::array<double, 2>, 4>& xs,
+                          std::array<std::array<double, 2>, 4>& ys,
+                          double in) noexcept {
+        for (std::size_t i = 0; i < 4; ++i) {
+            const double y = k[i] * (in + ys[i][1]) - xs[i][1];
+            xs[i][1] = xs[i][0];
+            xs[i][0] = in;
+            ys[i][1] = ys[i][0];
+            ys[i][0] = y;
+            in = y;
+        }
+        return in;
+    };
+    re = delayed;
+    delayed = chain(kA, xa, ya, x);
+    im = chain(kB, xb, yb, x);
+}
+
+double combDelay(double hz, double sr, double damp) noexcept {
+    const double w = 2.0 * kLabPi * hz / sr;
+    const double b = 1.0 - damp;
+    const double tauLp = std::atan2(b * std::sin(w), 1.0 - b * std::cos(w)) / w;
+    double d = sr / hz - tauLp;
+    for (int it = 0; it < 4; ++it) {
+        const double t = std::ceil(d) - d;
+        const std::array<double, 4> c{{
+            -0.5 * t + t * t - 0.5 * t * t * t,
+            1.0 - 2.5 * t * t + 1.5 * t * t * t,
+            0.5 * t + 2.0 * t * t - 1.5 * t * t * t,
+            -0.5 * t * t + 0.5 * t * t * t,
+        }};
+        double re = 0.0;
+        double im = 0.0;
+        for (int k = -1; k <= 2; ++k) {
+            const double ph = -w * (t - static_cast<double>(k));
+            const auto idx = static_cast<std::size_t>(k + 1);
+            re += c[idx] * std::cos(ph);
+            im += c[idx] * std::sin(ph);
+        }
+        d = sr / hz - tauLp + std::atan2(im, re) / w;
+    }
+    return d;
+}
+
+}  // namespace lab_detail
+
+// ---------------- FableCrushDsp ----------------
+
+void FableCrushDsp::prepare(double sampleRate) {
+    sr_ = safeRate(sampleRate);
+    const double glide = 1.0 - std::exp(-1.0 / (0.02 * sr_));
+    wet_.coef = glide;
+    bits_.coef = glide;
+    rate_.coef = glide;
+    setParams(false, 6.0f, 6000.0f, 0.2f, 1.0f);
+    reset();
+}
+
+void FableCrushDsp::reset() noexcept {
+    wet_.cur = 0.0;
+    wet_.cleared = true;
+    clearState();
+    rng_.reset();
+    bits_.snap();
+    rate_.snap();
+}
+
+void FableCrushDsp::setParams(bool on, float bits, float rate, float chaos, float mix) noexcept {
+    wet_.target = on ? std::clamp(static_cast<double>(mix), 0.0, 1.0) : 0.0;
+    bits_.target = std::clamp(static_cast<double>(bits), 1.0, 16.0);
+    rate_.target = std::clamp(static_cast<double>(rate), 50.0, sr_);
+    chaos_ = std::clamp(static_cast<double>(chaos), 0.0, 1.0);
+}
+
+void FableCrushDsp::clearState() noexcept {
+    phase_ = 1.0;
+    holdL_ = 0.0;
+    holdR_ = 0.0;
+    prevL_ = 0.0;
+    prevR_ = 0.0;
+}
+
+double FableCrushDsp::quantize(double x, double steps) noexcept {
+    double y = std::round(x * steps) / steps;
+    if (chaos_ > 0.0 && rng_.uni() < chaos_ * 0.15) {
+        y += (rng_.uni() < 0.5 ? -1.0 : 1.0) / steps;
+    }
+    return std::clamp(y, -1.0, 1.0);
+}
+
+void FableCrushDsp::processWet(double& l, double& r) noexcept {
+    const double bits = bits_.next();
+    const double inc = rate_.next() / sr_;
+    double outL = holdL_;
+    double outR = holdR_;
+    phase_ += inc;
+    if (phase_ >= 1.0) {
+        phase_ -= 1.0;
+        const double ago = std::min(1.0, phase_ / inc);
+        const double steps = std::exp2(bits - 1.0);
+        const double newL = quantize(l + ago * (prevL_ - l), steps);
+        const double newR = quantize(r + ago * (prevR_ - r), steps);
+        outL = holdL_ + ago * (newL - holdL_);
+        outR = holdR_ + ago * (newR - holdR_);
+        holdL_ = newL;
+        holdR_ = newR;
+        if (chaos_ > 0.0) {
+            phase_ -= chaos_ * 0.9 * rng_.uni();
+        }
+    }
+    prevL_ = l;
+    prevR_ = r;
+    l = outL;
+    r = outR;
+}
+
+void FableCrushDsp::process(float* L, float* R, int n) noexcept {
+    for (int i = 0; i < n; ++i) {
+        double x = sanitize(L[i]);
+        double y = sanitize(R[i]);
+        if (wet_.live()) {
+            wet_.cleared = false;
+            wet_.cur += (wet_.target - wet_.cur) * wet_.coef;
+            double wl = x;
+            double wr = y;
+            processWet(wl, wr);
+            x += wet_.cur * (wl - x);
+            y += wet_.cur * (wr - y);
+        } else if (!wet_.cleared) {
+            wet_.cur = 0.0;
+            wet_.cleared = true;
+            clearState();
+        }
+        L[i] = static_cast<float>(x);
+        R[i] = static_cast<float>(y);
+    }
+}
+
+bool FableCrushDsp::hasPendingOutput() const noexcept {
+    return wet_.live() && (std::abs(holdL_) > 1.0e-6 || std::abs(holdR_) > 1.0e-6 ||
+                           std::abs(prevL_) > 1.0e-6 || std::abs(prevR_) > 1.0e-6);
+}
+
+// ---------------- FableResoDsp ----------------
+
+void FableResoDsp::prepare(double sampleRate) {
+    sr_ = safeRate(sampleRate);
+    const double glide = 1.0 - std::exp(-1.0 / (0.02 * sr_));
+    wet_.coef = glide;
+    fb_.coef = glide;
+    for (auto& c : combs_) {
+        c.ring.prepare(static_cast<int>(sr_ / 30.0) + 8);
+    }
+    setParams(false, 48.0f, 2, 0.7f, 0.5f);
+    reset();
+}
+
+void FableResoDsp::reset() noexcept {
+    wet_.cur = 0.0;
+    wet_.cleared = true;
+    clearState();
+    fb_.snap();
+    for (auto& c : combs_) {
+        c.d = c.target;
+    }
+}
+
+void FableResoDsp::setParams(bool on, float note, int chord, float decay, float mix) noexcept {
+    wet_.target = on ? std::clamp(static_cast<double>(mix), 0.0, 1.0) : 0.0;
+    const auto& intervals = kLabResoChords[static_cast<std::size_t>(std::clamp(chord, 0, 5))];
+    const double maxDelay = static_cast<double>(combs_[0].ring.size()) - 8.0;
+    const double clampedNote = std::clamp(static_cast<double>(note), 24.0, 84.0);
+    for (std::size_t i = 0; i < combs_.size(); ++i) {
+        const double hz = 440.0 * std::exp2((clampedNote + static_cast<double>(intervals[i]) - 69.0) / 12.0);
+        combs_[i].target = std::clamp(lab_detail::combDelay(hz, sr_, kDamp), 4.0, std::max(4.0, maxDelay));
+    }
+    fb_.target = 0.6 + 0.395 * std::clamp(static_cast<double>(decay), 0.0, 1.0);
+}
+
+void FableResoDsp::clearState() noexcept {
+    for (auto& c : combs_) {
+        c.ring.clear();
+        c.lp = 0.0;
+        c.d = c.target;
+    }
+    tailRemaining_ = 0;
+}
+
+void FableResoDsp::processWet(double& l, double& r) noexcept {
+    const double x = 0.5 * (l + r);
+    const double g = fb_.next();
+    const double excitation = std::sqrt(1.0 - g * g);
+    std::array<double, 4> out{};
+    for (std::size_t i = 0; i < combs_.size(); ++i) {
+        auto& c = combs_[i];
+        c.d += (c.target - c.d) * 0.0015;
+        const double y = c.ring.hermite(static_cast<double>(c.ring.w) - c.d);
+        c.lp += kDamp * (y - c.lp);
+        c.ring.write(std::tanh(x * excitation + g * c.lp));
+        out[i] = y;
+    }
+    l = 0.5 * (out[0] + out[2] + 0.5 * (out[1] + out[3]));
+    r = 0.5 * (out[1] + out[3] + 0.5 * (out[0] + out[2]));
+}
+
+void FableResoDsp::process(float* L, float* R, int n) noexcept {
+    const int maxTail = static_cast<int>(std::clamp(sr_ * 8.0, 4096.0, sr_ * 10.0));
+    for (int i = 0; i < n; ++i) {
+        double x = sanitize(L[i]);
+        double y = sanitize(R[i]);
+        if (wet_.live()) {
+            wet_.cleared = false;
+            wet_.cur += (wet_.target - wet_.cur) * wet_.coef;
+            if (std::abs(x) > 1.0e-7 || std::abs(y) > 1.0e-7) {
+                const double g = std::clamp(fb_.target, 0.1, 0.995);
+                const double longest = std::max(combs_[0].target, combs_[0].d);
+                const double decaySamples = longest * (std::log(1.0e-4) / std::log(g));
+                tailRemaining_ = std::clamp(static_cast<int>(std::ceil(decaySamples)), 256, maxTail);
+            } else if (tailRemaining_ > 0) {
+                --tailRemaining_;
+            }
+            double wl = x;
+            double wr = y;
+            processWet(wl, wr);
+            x += wet_.cur * (wl - x);
+            y += wet_.cur * (wr - y);
+        } else if (!wet_.cleared) {
+            wet_.cur = 0.0;
+            wet_.cleared = true;
+            clearState();
+        }
+        L[i] = static_cast<float>(x);
+        R[i] = static_cast<float>(y);
+    }
+}
+
+// ---------------- FableShiftDsp ----------------
+
+void FableShiftDsp::prepare(double sampleRate) {
+    sr_ = safeRate(sampleRate);
+    const double glide = 1.0 - std::exp(-1.0 / (0.02 * sr_));
+    wet_.coef = glide;
+    hz_.coef = glide;
+    fb_.coef = glide;
+    spread_.coef = glide;
+    for (auto& c : ch_) {
+        c.ring.prepare(static_cast<int>(sr_ * 0.4) + 8);
+    }
+    dcCoef_ = std::exp(-2.0 * kLabPi * 20.0 / sr_);
+    setParams(false, 60.0f, 0.5f, 0.5f, 0.5f, 120.0);
+    reset();
+}
+
+void FableShiftDsp::reset() noexcept {
+    wet_.cur = 0.0;
+    wet_.cleared = true;
+    clearState();
+    hz_.snap();
+    fb_.snap();
+    spread_.snap();
+}
+
+void FableShiftDsp::setParams(bool on, float hz, float fb, float spread, float mix, double tempoBpm) noexcept {
+    bpm_ = safeBpm(tempoBpm);
+    wet_.target = on ? std::clamp(static_cast<double>(mix), 0.0, 1.0) : 0.0;
+    hz_.target = std::clamp(static_cast<double>(hz), -1000.0, 1000.0);
+    fb_.target = std::clamp(static_cast<double>(fb), 0.0, 0.9);
+    spread_.target = std::clamp(static_cast<double>(spread), 0.0, 1.0);
+    delay_ = std::min(15.0 / bpm_ * sr_, std::max(8.0, static_cast<double>(ch_[0].ring.size()) - 8.0));
+}
+
+void FableShiftDsp::clearState() noexcept {
+    for (auto& c : ch_) {
+        c.ring.clear();
+        c.hilbert.reset();
+        c.lp.reset();
+        c.hp.reset();
+        c.phase = 0.0;
+        c.dcX = 0.0;
+        c.dcY = 0.0;
+        c.hz = 1.0e9;
+    }
+    tick_ = 0;
+    tailRemaining_ = 0;
+}
+
+void FableShiftDsp::tuneChannel(Channel& c, double hz) noexcept {
+    const double lpHz = std::clamp(0.47 * sr_ - std::max(0.0, hz), 500.0, 0.45 * sr_);
+    const double hpHz = std::clamp(hz < 0.0 ? -hz * 1.05 : 20.0, 20.0, 0.4 * sr_);
+    c.lp.set(false, lpHz, sr_);
+    c.hp.set(true, hpHz, sr_);
+    c.hz = hz;
+}
+
+double FableShiftDsp::processChannel(Channel& c, double x, double hz, double fb) noexcept {
+    const double fed = x + fb * c.ring.hermite(static_cast<double>(c.ring.w) - delay_);
+    double re = 0.0;
+    double im = 0.0;
+    c.hilbert.process(c.hp.process(c.lp.process(fed)), re, im);
+    c.phase += hz / sr_;
+    c.phase -= std::floor(c.phase);
+    const double a = 2.0 * kLabPi * c.phase;
+    const double y = re * std::cos(a) + im * std::sin(a);
+    c.dcY = y - c.dcX + dcCoef_ * c.dcY;
+    c.dcX = y;
+    c.ring.write(std::tanh(c.dcY));
+    return y;
+}
+
+void FableShiftDsp::processWet(double& l, double& r) noexcept {
+    const double hz = hz_.next();
+    const double fb = fb_.next();
+    const double spread = spread_.next();
+    const double hzR = hz * (1.0 - 2.0 * spread);
+    if (--tick_ <= 0) {
+        tick_ = kCoefChunk;
+        if (std::abs(hz - ch_[0].hz) > 0.01) {
+            tuneChannel(ch_[0], hz);
+        }
+        if (std::abs(hzR - ch_[1].hz) > 0.01) {
+            tuneChannel(ch_[1], hzR);
+        }
+    }
+    l = processChannel(ch_[0], l, hz, fb);
+    r = processChannel(ch_[1], r, hzR, fb);
+}
+
+void FableShiftDsp::process(float* L, float* R, int n) noexcept {
+    const int maxTail = static_cast<int>(std::clamp(sr_ * 8.0, 4096.0, sr_ * 10.0));
+    for (int i = 0; i < n; ++i) {
+        double x = sanitize(L[i]);
+        double y = sanitize(R[i]);
+        if (wet_.live()) {
+            wet_.cleared = false;
+            wet_.cur += (wet_.target - wet_.cur) * wet_.coef;
+            if (std::abs(x) > 1.0e-7 || std::abs(y) > 1.0e-7) {
+                const double fb = std::clamp(fb_.target, 0.0, 0.9);
+                const double repeats = fb <= 0.001 ? 1.0 : (std::log(1.0e-4) / std::log(fb) + 1.0);
+                tailRemaining_ = std::clamp(static_cast<int>(std::ceil(delay_ * repeats)) + 256, 256, maxTail);
+            } else if (tailRemaining_ > 0) {
+                --tailRemaining_;
+            }
+            double wl = x;
+            double wr = y;
+            processWet(wl, wr);
+            x += wet_.cur * (wl - x);
+            y += wet_.cur * (wr - y);
+        } else if (!wet_.cleared) {
+            wet_.cur = 0.0;
+            wet_.cleared = true;
+            clearState();
+        }
+        L[i] = static_cast<float>(x);
+        R[i] = static_cast<float>(y);
+    }
+}
+
+// ---------------- FableSprayDsp ----------------
+
+void FableSprayDsp::prepare(double sampleRate) {
+    sr_ = safeRate(sampleRate);
+    wet_.coef = 1.0 - std::exp(-1.0 / (0.02 * sr_));
+    ring_.prepare(static_cast<int>(sr_ * 2.5));
+    cut_ = -1.0;
+    setParams(false, 12.0f, 12.0f, 0.4f, 0.45f);
+    reset();
+}
+
+void FableSprayDsp::reset() noexcept {
+    wet_.cur = 0.0;
+    wet_.cleared = true;
+    clearState();
+    rng_.reset();
+}
+
+void FableSprayDsp::setParams(bool on, float pitch, float density, float scatter, float mix) noexcept {
+    wet_.target = on ? std::clamp(static_cast<double>(mix), 0.0, 1.0) : 0.0;
+    scatter_ = std::clamp(static_cast<double>(scatter), 0.0, 1.0);
+    ratio_ = std::exp2(std::clamp(static_cast<double>(pitch), -24.0, 24.0) / 12.0);
+    const double clampedDensity = std::clamp(static_cast<double>(density), 1.0, 40.0);
+    interval_ = sr_ / clampedDensity;
+    len_ = std::clamp(3.0 / clampedDensity, 0.04, 0.3) * sr_;
+    norm_ = 1.0 / std::sqrt(std::max(1.0, clampedDensity * len_ / sr_));
+    const double maxRatio = ratio_ * std::exp2(scatter_ * 0.3 / 12.0);
+    const double cut = std::min(0.45, 0.45 / maxRatio) * sr_;
+    if (std::abs(cut - cut_) > 1.0e-6) {
+        cut_ = cut;
+        lp_.set(false, cut, sr_);
+    }
+}
+
+void FableSprayDsp::clearState() noexcept {
+    ring_.clear();
+    lp_.reset();
+    for (auto& g : grains_) {
+        g.on = false;
+    }
+    countdown_ = 0.0;
+    tailRemaining_ = 0;
+}
+
+void FableSprayDsp::spawnGrain() noexcept {
+    for (auto& g : grains_) {
+        if (g.on) {
+            continue;
+        }
+        const double ratio = ratio_ * std::exp2(scatter_ * 0.3 * rng_.bi() / 12.0);
+        const bool reverse = rng_.uni() < scatter_ * 0.35;
+        g.len = std::max(16, static_cast<int>(len_));
+        g.inc = reverse ? -ratio : ratio;
+        const double behind = 64.0 + (reverse ? 0.0 : std::max(0.0, static_cast<double>(g.len) * (ratio - 1.0)))
+                              + scatter_ * rng_.uni() * 0.8 * sr_;
+        g.pos = static_cast<double>(ring_.w) - behind;
+        const double pan = rng_.bi() * std::min(1.0, 0.3 + scatter_);
+        const double a = (pan + 1.0) * 0.25 * kLabPi;
+        g.gl = std::cos(a) * std::sqrt(2.0);
+        g.gr = std::sin(a) * std::sqrt(2.0);
+        g.age = 0;
+        g.on = true;
+        return;
+    }
+}
+
+void FableSprayDsp::processWet(double& l, double& r) noexcept {
+    ring_.write(lp_.process(0.5 * (l + r)));
+    if (--countdown_ <= 0.0) {
+        spawnGrain();
+        countdown_ += interval_ * (0.5 + rng_.uni());
+    }
+    double ol = 0.0;
+    double orr = 0.0;
+    for (auto& g : grains_) {
+        if (!g.on) {
+            continue;
+        }
+        const double s = std::sin(kLabPi * static_cast<double>(g.age) / static_cast<double>(g.len));
+        const double v = ring_.hermite(g.pos) * s * s;
+        ol += v * g.gl;
+        orr += v * g.gr;
+        g.pos += g.inc;
+        if (++g.age >= g.len) {
+            g.on = false;
+        }
+    }
+    l = ol * norm_;
+    r = orr * norm_;
+}
+
+void FableSprayDsp::process(float* L, float* R, int n) noexcept {
+    const int tailWindow = static_cast<int>(std::ceil(sr_ * 2.0));
+    for (int i = 0; i < n; ++i) {
+        double x = sanitize(L[i]);
+        double y = sanitize(R[i]);
+        if (wet_.live()) {
+            wet_.cleared = false;
+            wet_.cur += (wet_.target - wet_.cur) * wet_.coef;
+            if (std::abs(x) > 1.0e-7 || std::abs(y) > 1.0e-7) {
+                tailRemaining_ = tailWindow;
+            } else if (tailRemaining_ > 0) {
+                --tailRemaining_;
+            }
+            double wl = x;
+            double wr = y;
+            processWet(wl, wr);
+            x += wet_.cur * (wl - x);
+            y += wet_.cur * (wr - y);
+        } else if (!wet_.cleared) {
+            wet_.cur = 0.0;
+            wet_.cleared = true;
+            clearState();
+        }
+        L[i] = static_cast<float>(x);
+        R[i] = static_cast<float>(y);
+    }
+}
+
+bool FableSprayDsp::hasPendingOutput() const noexcept {
+    if (!wet_.live()) {
+        return false;
+    }
+    if (tailRemaining_ > 0) {
+        return true;
+    }
+    return std::ranges::any_of(grains_, [](const Grain& g) { return g.on; });
+}
+
+// ---------------- FableGlitchDsp ----------------
+
+void FableGlitchDsp::prepare(double sampleRate) {
+    sr_ = safeRate(sampleRate);
+    wet_.coef = 1.0 - std::exp(-1.0 / (0.02 * sr_));
+    sinc_.build();
+    for (auto& g : ring_) {
+        g.prepare(static_cast<int>(sr_ * 4.0));
+    }
+    fade_ = std::max(8.0, std::round(0.002 * sr_));
+    gateStep_ = 1.0 / (0.006 * sr_);
+    setParams(false, 2, 0.35f, 0.0f, 1.0f, 120.0);
+    reset();
+}
+
+void FableGlitchDsp::reset() noexcept {
+    wet_.cur = 0.0;
+    wet_.cleared = true;
+    clearState();
+    beat_ = 0.0;
+    rng_.reset();
+}
+
+void FableGlitchDsp::setParams(bool on, int div, float chance, float drift, float mix, double tempoBpm) noexcept {
+    bpm_ = safeBpm(tempoBpm);
+    wet_.target = on ? std::clamp(static_cast<double>(mix), 0.0, 1.0) : 0.0;
+    div_ = std::clamp(div, 0, 4);
+    chance_ = std::clamp(static_cast<double>(chance), 0.0, 1.0);
+    drift_ = std::clamp(static_cast<double>(drift), -1.0, 1.0);
+}
+
+void FableGlitchDsp::setTransport(double ppq, bool playing) noexcept {
+    synced_ = playing && std::isfinite(ppq);
+    if (synced_) {
+        beat_ = ppq;
+    }
+}
+
+void FableGlitchDsp::clearState() noexcept {
+    for (auto& g : ring_) {
+        g.clear();
+    }
+    head_ = Head{};
+    tail_ = Head{};
+    xfade_ = 0;
+    active_ = false;
+    gate_ = 0.0;
+    period_ = -1;
+    pos_ = 0.0;
+    repeat_ = 0;
+    tailRemaining_ = 0;
+}
+
+double FableGlitchDsp::readHead(const Head& h, std::size_t ch, double dry) const noexcept {
+    if (h.live) {
+        return dry;
+    }
+    return sinc_.read(ring_[ch], h.pos, 0.94 * std::min(1.0, 1.0 / h.rate));
+}
+
+void FableGlitchDsp::spliceTo(const Head& next) noexcept {
+    tail_ = head_;
+    head_ = next;
+    xfade_ = static_cast<int>(fade_);
+}
+
+void FableGlitchDsp::processWet(double& l, double& r) noexcept {
+    const double now = static_cast<double>(ring_[0].w);
+    ring_[0].write(l);
+    ring_[1].write(r);
+    const auto period = static_cast<std::int64_t>(std::floor(beat_ / 2.0));
+    if (period != period_) {
+        const bool first = period_ == -1;
+        period_ = period;
+        active_ = !first && rng_.uni() < chance_;
+        if (active_) {
+            const double late = (beat_ - 2.0 * static_cast<double>(period)) * 60.0 / bpm_ * sr_;
+            const double divBeats = kLabGlitchBeats[static_cast<std::size_t>(std::clamp(div_, 0, 4))];
+            slice_ = std::max(64.0, divBeats * 60.0 / bpm_ * sr_);
+            start_ = now - std::min(late, 0.5 * slice_);
+            if (gate_ > 0.0) {
+                spliceTo({true, now, 1.0});
+            } else {
+                head_ = {true, now, 1.0};
+                xfade_ = 0;
+            }
+            pos_ = now - start_;
+            repeat_ = 0;
+            gate_ = 1.0;
+        }
+    }
+    if (!active_) {
+        gate_ = std::max(0.0, gate_ - gateStep_);
+    }
+    if (gate_ <= 0.0) {
+        return;
+    }
+
+    double hl = readHead(head_, 0, l);
+    double hr = readHead(head_, 1, r);
+    if (xfade_ > 0) {
+        const double t = 1.0 - static_cast<double>(xfade_) / fade_;
+        const double a = std::sin(t * 0.5 * kLabPi);
+        const double b = std::cos(t * 0.5 * kLabPi);
+        hl = a * hl + b * readHead(tail_, 0, l);
+        hr = a * hr + b * readHead(tail_, 1, r);
+        tail_.pos += tail_.rate;
+        --xfade_;
+    }
+    head_.pos += head_.rate;
+    if (active_) {
+        pos_ += head_.rate;
+        if (pos_ >= slice_) {
+            pos_ -= slice_;
+            ++repeat_;
+            const double rate = std::clamp(std::exp2(drift_ * 0.25 * static_cast<double>(repeat_)), 0.25, 4.0);
+            spliceTo({false, start_ + pos_, rate});
+        }
+    }
+    const double a = std::sin(gate_ * 0.5 * kLabPi);
+    const double b = std::cos(gate_ * 0.5 * kLabPi);
+    l = a * hl + b * l;
+    r = a * hr + b * r;
+}
+
+void FableGlitchDsp::process(float* L, float* R, int n) noexcept {
+    const double beatInc = bpm_ / 60.0 / sr_;
+    const int halfBarSamples = static_cast<int>(std::ceil(2.0 * 60.0 / bpm_ * sr_));
+    for (int i = 0; i < n; ++i) {
+        double x = sanitize(L[i]);
+        double y = sanitize(R[i]);
+        if (wet_.live()) {
+            wet_.cleared = false;
+            wet_.cur += (wet_.target - wet_.cur) * wet_.coef;
+            if (std::abs(x) > 1.0e-7 || std::abs(y) > 1.0e-7) {
+                tailRemaining_ = halfBarSamples;
+            } else if (tailRemaining_ > 0) {
+                --tailRemaining_;
+            }
+            double wl = x;
+            double wr = y;
+            processWet(wl, wr);
+            x += wet_.cur * (wl - x);
+            y += wet_.cur * (wr - y);
+        } else if (!wet_.cleared) {
+            wet_.cur = 0.0;
+            wet_.cleared = true;
+            clearState();
+        }
+        beat_ += beatInc;
+        L[i] = static_cast<float>(x);
+        R[i] = static_cast<float>(y);
+    }
+}
+
+}  // namespace nt::audio::effects::fable
