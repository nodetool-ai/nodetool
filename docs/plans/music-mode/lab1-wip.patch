+            ::fable::LabSettings s{};
+            configure(s);
+            return UnitCase{kind, std::move(params), s, seconds};
+        };
+
+        const std::vector<UnitCase> cases = {
+            makeCase("crush",
+                     {{"fx.crush.bits", 5.5}, {"fx.crush.rate", 4200.0}, {"fx.crush.chaos", 0.35}, {"fx.crush.mix", 0.85}},
+                     [](::fable::LabSettings& s) {
+                         s.crushOn = true; s.crushBits = 5.5f; s.crushRate = 4200.0f; s.crushChaos = 0.35f; s.crushMix = 0.85f;
+                     }, 0.25),
+            makeCase("reso",
+                     {{"fx.reso.note", 52.0}, {"fx.reso.chord", 3.0}, {"fx.reso.decay", 0.75}, {"fx.reso.mix", 0.65}},
+                     [](::fable::LabSettings& s) {
+                         s.resoOn = true; s.resoNote = 52.0f; s.resoChord = 3; s.resoDecay = 0.75f; s.resoMix = 0.65f;
+                     }, 0.25),
+            makeCase("shift",
+                     {{"fx.shift.hz", -145.0}, {"fx.shift.fb", 0.55}, {"fx.shift.spread", 0.7}, {"fx.shift.mix", 0.75}},
+                     [](::fable::LabSettings& s) {
+                         s.shiftOn = true; s.shiftHz = -145.0f; s.shiftFb = 0.55f; s.shiftSpread = 0.7f; s.shiftMix = 0.75f;
+                     }, 0.25),
+            makeCase("spray",
+                     {{"fx.spray.pitch", 7.0}, {"fx.spray.density", 18.0}, {"fx.spray.scatter", 0.45}, {"fx.spray.mix", 0.7}},
+                     [](::fable::LabSettings& s) {
+                         s.sprayOn = true; s.sprayPitch = 7.0f; s.sprayDensity = 18.0f; s.sprayScatter = 0.45f; s.sprayMix = 0.7f;
+                     }, 0.35),
+            makeCase("glitch",
+                     {{"fx.glitch.div", 3.0}, {"fx.glitch.chance", 1.0}, {"fx.glitch.drift", 0.4}, {"fx.glitch.mix", 0.9}},
+                     [](::fable::LabSettings& s) {
+                         s.glitchOn = true; s.glitchDiv = 3; s.glitchChance = 1.0f; s.glitchDrift = 0.4f; s.glitchMix = 0.9f;
+                     }, 1.2),
