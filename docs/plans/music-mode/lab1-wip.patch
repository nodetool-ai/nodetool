+                const int frames = static_cast<int>(std::lround(sr * c.seconds));
+                std::vector<float> inL;
+                std::vector<float> inR;
+                makeTestSignal(inL, inR, frames, sr, 0.5f);
+
+                // Reference render directly from FableSynth LabFx.h.
+                ::fable::LabFx ref;
+                ref.prepare(sr);
+                ref.setParams(c.refSettings, kBpm);
+                ref.reset();
+                std::vector<float> refL = inL;
+                std::vector<float> refR = inR;
+                for (int i = 0; i < frames; ++i) {
+                    ref.processSample(refL[static_cast<std::size_t>(i)], refR[static_cast<std::size_t>(i)]);
+                }
+
+                // Native split processor render across non-uniform block sizes.
+                auto proc = createFableColorTimeEffect(makeEffectJson(c.kind, c.params), kBpm);
+                QVERIFY(proc != nullptr);
+                proc->prepare(sr);
+                proc->reset();
+                QCOMPARE(proc->latencySamples(), 0);
+
+                std::vector<float> actual = interleave(inL, inR);
+                const std::array<int, 4> chunkSizes{{64, 128, 193, 256}};
+                int offset = 0;
+                std::size_t ci = 0;
+                while (offset < frames) {
+                    const int count = std::min(chunkSizes[ci++ % chunkSizes.size()], frames - offset);
+                    const BlockContext ctx{sr, static_cast<double>(offset) * 1000.0 / sr, 1000.0 / sr, false, 0, kBpm};
+                    proc->process(std::span<float>(actual.data() + static_cast<std::size_t>(offset) * 2,
+                                                   static_cast<std::size_t>(count) * 2), ctx);
+                    offset += count;
+                }
+
+                double maxErr = 0.0;
+                double maxDryDiff = 0.0;
+                for (int i = 0; i < frames; ++i) {
+                    const auto idx = static_cast<std::size_t>(i);
+                    const float aL = actual[idx * 2];
+                    const float aR = actual[idx * 2 + 1];
+                    QVERIFY2(std::isfinite(aL) && std::isfinite(aR), c.kind);
+                    maxErr = std::max(maxErr, std::abs(static_cast<double>(aL) - static_cast<double>(refL[idx])));
+                    maxErr = std::max(maxErr, std::abs(static_cast<double>(aR) - static_cast<double>(refR[idx])));
+                    maxDryDiff = std::max(maxDryDiff, std::abs(static_cast<double>(aL) - static_cast<double>(inL[idx])));
+                    maxDryDiff = std::max(maxDryDiff, std::abs(static_cast<double>(aR) - static_cast<double>(inR[idx])));
+                }
+                QVERIFY2(maxDryDiff > 1.0e-2,
+                         qPrintable(QStringLiteral("%1 @ %2 Hz produced near-dry output (%3)").arg(c.kind).arg(sr).arg(maxDryDiff)));
+                QVERIFY2(maxErr <= 1.0e-5,
+                         qPrintable(QStringLiteral("%1 @ %2 Hz maxErr=%3 exceeded 1e-5").arg(c.kind).arg(sr).arg(maxErr)));
+            }
+        }
+    }
 };
 
