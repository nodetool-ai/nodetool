+// Deterministic xorshift32 matching FableSynth LabFx.h.
+// Thread affinity: audio render thread only.
+struct Rng {
+    static constexpr std::uint32_t kSeed = 0x9e3779b9u;
+    std::uint32_t s = kSeed;
+
+    void reset() noexcept { s = kSeed; }
+
+    [[nodiscard]] double uni() noexcept {
+        s ^= s << 13;
+        s ^= s >> 17;
+        s ^= s << 5;
+        return static_cast<double>(s >> 8) * (1.0 / 16777216.0);
+    }
+
+    [[nodiscard]] double bi() noexcept { return uni() * 2.0 - 1.0; }
+};
+
+// One-pole 20 ms parameter smoother stepped per sample.
+// Thread affinity: prepared on control thread; stepped/snapped on audio thread.
+struct Glide {
+    double cur = 0.0;
+    double target = 0.0;
+    double coef = 0.001;
+
+    [[nodiscard]] double next() noexcept {
+        cur += (target - cur) * coef;
+        return cur;
+    }
+
+    void snap() noexcept { cur = target; }
+};
+
+// Stage wet smoother with clear-once idle tracking.
+// Thread affinity: prepared on control thread; stepped/cleared on audio thread.
+struct Wet {
+    double cur = 0.0;
+    double target = 0.0;
+    double coef = 0.001;
+    bool cleared = true;
+
+    [[nodiscard]] bool live() const noexcept { return target > 0.0 || cur > 1.0e-5; }
+};
+
+// Transposed direct form II RBJ biquad matching LabFx.h.
+// Thread affinity: audio render thread only (configured on control or audio thread).
+struct Biquad {
+    double b0 = 1.0;
+    double b1 = 0.0;
+    double b2 = 0.0;
+    double a1 = 0.0;
+    double a2 = 0.0;
+    double z1 = 0.0;
+    double z2 = 0.0;
+
+    void set(bool high, double hz, double q, double sr) noexcept;
+    [[nodiscard]] double process(double x) noexcept {
+        const double y = b0 * x + z1;
+        z1 = b1 * x - a1 * y + z2;
+        z2 = b2 * x - a2 * y;
+        return y;
+    }
+    void reset() noexcept {
+        z1 = 0.0;
+        z2 = 0.0;
+    }
+};
+
+// Eighth-order Butterworth cascade (four biquads).
+// Thread affinity: audio render thread only (configured on control or audio thread).
+struct Butter8 {
+    std::array<Biquad, 4> s{};
+
+    void set(bool high, double hz, double sr) noexcept;
+    [[nodiscard]] double process(double x) noexcept {
+        for (auto& b : s) {
+            x = b.process(x);
+        }
+        return x;
+    }
+    void reset() noexcept {
+        for (auto& b : s) {
+            b.reset();
+        }
+    }
+};
+
+// Power-of-two circular float buffer addressed by absolute sample position.
+// Thread affinity: prepare() on control thread (allocates once); write/at/hermite/clear on audio thread only.
+struct Ring {
+    std::vector<float> b;
+    std::int64_t mask = 0;
+    std::int64_t w = 0;
+
+    void prepare(int minSize);
+    void clear() noexcept;
+    void write(double x) noexcept {
+        if (b.empty()) {
+            return;
+        }
+        b[static_cast<std::size_t>(w & mask)] = static_cast<float>(x);
+        ++w;
+    }
+    [[nodiscard]] double at(std::int64_t i) const noexcept {
+        if (b.empty()) {
+            return 0.0;
+        }
+        return static_cast<double>(b[static_cast<std::size_t>(i & mask)]);
+    }
+    [[nodiscard]] double hermite(double p) const noexcept;
+    [[nodiscard]] std::size_t size() const noexcept { return b.size(); }
+};
+
+// Kaiser-windowed sinc (beta 7.5), 8 zero crossings each side, 512 table points per crossing.
+// Thread affinity: build() on control thread (allocates once); tap/read on audio thread only.
+struct SincTable {
+    static constexpr int kHalf = 8;
+    static constexpr int kRes = 512;
+    std::vector<double> h;
+
+    void build();
+    [[nodiscard]] double tap(double x) const noexcept;
+    [[nodiscard]] double read(const Ring& r, double p, double fc) const noexcept;
+};
+
+// Niemitalo's 90-degree allpass pair: two four-stage chains.
+// Thread affinity: audio render thread only.
+struct Hilbert {
+    static constexpr std::array<double, 4> kA{{
+        0.6923878 * 0.6923878,
+        0.9360654322959 * 0.9360654322959,
+        0.9882295226860 * 0.9882295226860,
+        0.9987488452737 * 0.9987488452737,
+    }};
+    static constexpr std::array<double, 4> kB{{
+        0.4021921162426 * 0.4021921162426,
+        0.8561710882420 * 0.8561710882420,
+        0.9722909545651 * 0.9722909545651,
+        0.9952884791278 * 0.9952884791278,
+    }};
+
+    std::array<std::array<double, 2>, 4> xa{};
+    std::array<std::array<double, 2>, 4> ya{};
+    std::array<std::array<double, 2>, 4> xb{};
+    std::array<std::array<double, 2>, 4> yb{};
+    double delayed = 0.0;
+
+    void reset() noexcept { *this = Hilbert{}; }
+    void process(double x, double& re, double& im) noexcept;
+};
