+// Single-sideband frequency shifter (Hilbert allpass pair) with band-limiting and tempo-synced spiral feedback.
+// Thread affinity: prepare() on control thread (allocates once); setParams/process/reset on audio thread only.
+class FableShiftDsp {
+public:
+    static constexpr int kCoefChunk = 32;
+
+    void prepare(double sampleRate);
+    void reset() noexcept;
+    void setParams(bool on, float hz, float fb, float spread, float mix, double tempoBpm) noexcept;
+    void process(float* L, float* R, int n) noexcept;
+    [[nodiscard]] int latencySamples() const noexcept { return 0; }
+    [[nodiscard]] bool hasPendingOutput() const noexcept { return wet_.live() && tailRemaining_ > 0; }
+
+private:
+    struct Channel {
+        lab_detail::Ring ring;
+        lab_detail::Hilbert hilbert;
+        lab_detail::Butter8 lp;
+        lab_detail::Butter8 hp;
+        double phase = 0.0;
