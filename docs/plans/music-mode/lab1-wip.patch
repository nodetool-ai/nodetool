+void FableCrushProcessor::reset() noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(false);
+    BlockProcessor::reset();
+    crush_.reset();
+}
+
+bool FableCrushProcessor::setParameter(std::string_view key, double value) noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(false);
+    if (!std::isfinite(value)) {
+        return false;
+    }
+    if (key == "fx.crush.bits") {
+        bits_ = static_cast<float>(std::clamp(value, 1.0, 16.0));
+    } else if (key == "fx.crush.rate") {
+        rate_ = static_cast<float>(std::clamp(value, 200.0, 48000.0));
+    } else if (key == "fx.crush.chaos") {
+        chaos_ = static_cast<float>(std::clamp(value, 0.0, 1.0));
+    } else if (key == "fx.crush.mix") {
+        mix_ = static_cast<float>(std::clamp(value, 0.0, 1.0));
