+        drift_ = static_cast<float>(std::clamp(value, -1.0, 1.0));
+    } else if (key == "fx.glitch.mix") {
+        mix_ = static_cast<float>(std::clamp(value, 0.0, 1.0));
+    } else if (key == "bpm" || key == "tempo.bpm") {
+        if (value <= 1.0) {
+            return false;
+        }
+        tempoBpm_ = std::clamp(value, 40.0, 300.0);
+    } else {
+        return false;
+    }
+    if (prepared_) {
+        applyParams();
+    }
+    return true;
+}
+
+void FableGlitchProcessor::process(std::span<float> stereo, const nt::audio::BlockContext& context) noexcept {
+    [[maybe_unused]] const auto renderScope = threadGuard_.enterRender(true);
+    const double ctxBpm = contextTempoBpm(context);
+    if (std::isfinite(ctxBpm) && ctxBpm > 1.0) {
+        const double clampedBpm = std::clamp(ctxBpm, 40.0, 300.0);
+        if (clampedBpm != tempoBpm_) {
+            tempoBpm_ = clampedBpm;
+            if (prepared_) {
+                applyParams();
+            }
+        }
+    }
+    processStereoChunks(glitch_, stereo);
+}
+
+bool FableGlitchProcessor::hasPendingOutput(int) const noexcept {
+    return glitch_.hasPendingOutput();
+}
