execute_process(COMMAND "${PROBE}" "${FIXTURE}" OUTPUT_VARIABLE actual ERROR_VARIABLE error RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "guest-probe failed: ${error}")
endif()
file(READ "${REFERENCE}" expected)
string(STRIP "${actual}" actual)
string(STRIP "${expected}" expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Guest Intl results differ from Node.\nguest: ${actual}\nnode:  ${expected}")
endif()
