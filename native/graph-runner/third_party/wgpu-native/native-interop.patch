+// Native interop: the Vulkan and D3D12 counterparts of the Metal getters.
+
+#[cfg(all(feature = "vulkan", not(any(target_os = "ios", target_os = "macos"))))]
+macro_rules! vulkan_device_handle {
+    ($device:expr, $default:expr, |$hal:ident| $value:expr) => {{
+        let device = $device.as_ref().expect("invalid device");
+        match device.context.device_as_hal::<hal::api::Vulkan>(device.id) {
+            Some($hal) => $value,
+            None => $default,
+        }
+    }};
+}
+#[cfg(not(all(feature = "vulkan", not(any(target_os = "ios", target_os = "macos")))))]
+macro_rules! vulkan_device_handle {
+    ($device:expr, $default:expr, |$hal:ident| $value:expr) => {{
+        let _ = $device;
+        $default
+    }};
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeVulkanInstance(
+    device: native::WGPUDevice,
+) -> *mut c_void {
+    vulkan_device_handle!(device, std::ptr::null_mut(), |hal_device| {
+        use ash::vk::Handle;
+        hal_device.shared_instance().raw_instance().handle().as_raw() as usize as *mut c_void
+    })
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeVulkanPhysicalDevice(
+    device: native::WGPUDevice,
+) -> *mut c_void {
+    vulkan_device_handle!(device, std::ptr::null_mut(), |hal_device| {
+        use ash::vk::Handle;
+        hal_device.raw_physical_device().as_raw() as usize as *mut c_void
+    })
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeVulkanDevice(
+    device: native::WGPUDevice,
+) -> *mut c_void {
+    vulkan_device_handle!(device, std::ptr::null_mut(), |hal_device| {
+        use ash::vk::Handle;
+        hal_device.raw_device().handle().as_raw() as usize as *mut c_void
+    })
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeVulkanQueue(device: native::WGPUDevice) -> *mut c_void {
+    vulkan_device_handle!(device, std::ptr::null_mut(), |hal_device| {
+        use ash::vk::Handle;
+        hal_device.raw_queue().as_raw() as usize as *mut c_void
+    })
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeVulkanQueueFamilyIndex(
+    device: native::WGPUDevice,
+) -> u32 {
+    vulkan_device_handle!(device, u32::MAX, |hal_device| hal_device.queue_family_index())
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuTextureGetNativeVulkanImage(texture: native::WGPUTexture) -> u64 {
+    #[cfg(all(feature = "vulkan", not(any(target_os = "ios", target_os = "macos"))))]
+    {
+        use ash::vk::Handle;
+        let texture = texture.as_ref().expect("invalid texture");
+        let hal_texture = texture
+            .context
+            .texture_as_hal::<hal::api::Vulkan>(texture.id);
+        if let Some(hal_texture) = hal_texture {
+            return hal_texture.raw_handle().as_raw();
+        }
+        0
+    }
+    #[cfg(not(all(feature = "vulkan", not(any(target_os = "ios", target_os = "macos")))))]
+    {
+        let _ = texture;
+        0
+    }
+}
+
+/// The caller's context pointer of a native texture drop callback. The
+/// caller promises it may be used from the thread that drops the texture.
+#[allow(dead_code)]
+struct NativeDropUserdata(*mut c_void);
+unsafe impl Send for NativeDropUserdata {}
+unsafe impl Sync for NativeDropUserdata {}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceCreateTextureFromNativeVulkanImage(
+    device: native::WGPUDevice,
+    descriptor: Option<&native::WGPUTextureDescriptor>,
+    image: u64,
+    drop_callback: Option<unsafe extern "C" fn(userdata: *mut c_void)>,
+    userdata: *mut c_void,
+) -> native::WGPUTexture {
+    #[cfg(all(feature = "vulkan", not(any(target_os = "ios", target_os = "macos"))))]
+    {
+        use ash::vk::Handle;
+        let (device_id, context, error_sink) = {
+            let device = device.as_ref().expect("invalid device");
+            (device.id, &device.context, &device.error_sink)
+        };
+        let descriptor = descriptor.expect("invalid descriptor");
+        let drop_callback = drop_callback.expect("invalid drop callback");
+
+        let desc = wgt::TextureDescriptor {
+            label: string_view_into_label(descriptor.label),
+            size: conv::map_extent3d(&descriptor.size),
+            mip_level_count: descriptor.mipLevelCount,
+            sample_count: descriptor.sampleCount,
+            dimension: conv::map_texture_dimension(descriptor.dimension)
+                .unwrap_or(wgt::TextureDimension::D2),
+            format: conv::map_texture_format(descriptor.format)
+                .expect("invalid texture format for texture descriptor"),
+            usage: from_u64_bits(descriptor.usage)
+                .expect("invalid texture usage for texture descriptor"),
+            view_formats: make_slice(descriptor.viewFormats, descriptor.viewFormatCount)
+                .iter()
+                .map(|v| {
+                    conv::map_texture_format(*v)
+                        .expect("invalid view format for texture descriptor")
+                })
+                .collect::<Vec<_>>(),
+        };
+
+        let hal_texture = {
+            let Some(hal_device) = context.device_as_hal::<hal::api::Vulkan>(device_id) else {
+                return std::ptr::null();
+            };
+            // texture_from_raw reads the label, the format and the size.
+            let hal_desc = hal::TextureDescriptor {
+                label: desc.label.as_deref(),
+                size: desc.size,
+                mip_level_count: desc.mip_level_count,
+                sample_count: desc.sample_count,
+                dimension: desc.dimension,
+                format: desc.format,
+                usage: wgt::TextureUses::empty(),
+                memory_flags: hal::MemoryFlags::empty(),
+                view_formats: desc.view_formats.clone(),
+            };
+            let userdata = NativeDropUserdata(userdata);
+            let on_drop: hal::DropCallback = Box::new(move || {
+                let userdata = userdata;
+                drop_callback(userdata.0)
+            });
+            hal_device.texture_from_raw(
+                ash::vk::Image::from_raw(image),
+                &hal_desc,
+                Some(on_drop),
+                hal::vulkan::TextureMemory::External,
+            )
+        };
+
+        let (texture_id, error) =
+            context.create_texture_from_hal(Box::new(hal_texture), device_id, &desc, None);
+        if let Some(cause) = error {
+            handle_error(
+                error_sink,
+                cause,
+                desc.label,
+                "wgpuDeviceCreateTextureFromNativeVulkanImage",
+            );
+        }
+
+        Arc::into_raw(Arc::new(WGPUTextureImpl {
+            context: context.clone(),
+            id: texture_id,
+            error_sink: error_sink.clone(),
+            surface_id: None,
+            has_surface_presented: Arc::default(),
+            data: TextureData {
+                usage: descriptor.usage,
+                dimension: descriptor.dimension,
+                size: descriptor.size,
+                format: descriptor.format,
+                mip_level_count: descriptor.mipLevelCount,
+                sample_count: descriptor.sampleCount,
+            },
+        }))
+    }
+    #[cfg(not(all(feature = "vulkan", not(any(target_os = "ios", target_os = "macos")))))]
+    {
+        let _ = (device, descriptor, image, drop_callback, userdata);
+        std::ptr::null()
+    }
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceGetNativeD3D12Device(device: native::WGPUDevice) -> *mut c_void {
+    #[cfg(all(windows, feature = "dx12"))]
+    {
+        use windows_core::Interface;
+        let device = device.as_ref().expect("invalid device");
+        let hal_device = device.context.device_as_hal::<hal::api::Dx12>(device.id);
+        if let Some(hal_device) = hal_device {
+            return hal_device.raw_device().as_raw();
+        }
+        std::ptr::null_mut()
+    }
+    #[cfg(not(all(windows, feature = "dx12")))]
+    {
+        let _ = device;
+        std::ptr::null_mut()
+    }
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuTextureGetNativeD3D12Resource(
+    texture: native::WGPUTexture,
+) -> *mut c_void {
+    #[cfg(all(windows, feature = "dx12"))]
+    {
+        use windows_core::Interface;
+        let texture = texture.as_ref().expect("invalid texture");
+        let hal_texture = texture
+            .context
+            .texture_as_hal::<hal::api::Dx12>(texture.id);
+        if let Some(hal_texture) = hal_texture {
+            return hal_texture.raw_resource().as_raw();
+        }
+        std::ptr::null_mut()
+    }
+    #[cfg(not(all(windows, feature = "dx12")))]
+    {
+        let _ = texture;
+        std::ptr::null_mut()
+    }
+}
+
