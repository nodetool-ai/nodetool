# Same release and hashes as graph-runner/cmake/host-image-gpu.cmake.
# Kept optional so core scheduling/audio builds need no GPU SDK or adapter.
set(_rt_wgpu_version v29.0.1.1)
if(WIN32 AND MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(_rt_wgpu_asset wgpu-windows-x86_64-msvc-release.zip)
  set(_rt_wgpu_hash 7e67d7445c42aeb85e30f88930fd8d7d83ee769e3390aeb1ada75ebf3cf78132)
elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
  set(_rt_wgpu_asset wgpu-macos-aarch64-release.zip)
  set(_rt_wgpu_hash a5797a37b1adf720bcd5dcffb291edbbd5b7b14be0a3874c28e6393a655a7a3e)
elseif(APPLE)
  set(_rt_wgpu_asset wgpu-macos-x86_64-release.zip)
  set(_rt_wgpu_hash 8e2f7378548ddd0e2cf21e7d864dda46e953f0af724855a33778b85ead206d41)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
  set(_rt_wgpu_asset wgpu-linux-x86_64-release.zip)
  set(_rt_wgpu_hash 95a4d90c071005a98d03eab348beaa6b07e16eb00d1dcdb9f8348f75eb97ec5a)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
  set(_rt_wgpu_asset wgpu-linux-aarch64-release.zip)
  set(_rt_wgpu_hash 015fcdf1dbae82e614a783cc38017e5399ae0927a889fe9b69c9b664bc61b47a)
else()
  message(FATAL_ERROR "No pinned offline wgpu-native build for this platform")
endif()
find_program(NT_GPU_NODE node REQUIRED)
set(NT_GPU_CATALOG ${CMAKE_CURRENT_BINARY_DIR}/gpu-catalog.json)
add_custom_target(realtime-gpu-catalog
  COMMAND ${NT_GPU_NODE} ${CMAKE_CURRENT_SOURCE_DIR}/../graph-runner/guest/host/gpu-catalog.mjs ${NT_GPU_CATALOG}
  BYPRODUCTS ${NT_GPU_CATALOG}
  COMMENT "Exporting the existing WGSL shader catalog")
add_executable(realtime-offline-gpu-test tests/offline_gpu_test.cpp)
target_link_libraries(realtime-offline-gpu-test PRIVATE nodetool_realtime_offline_gpu)
target_compile_definitions(realtime-offline-gpu-test PRIVATE NT_GPU_CATALOG="${NT_GPU_CATALOG}")
add_dependencies(realtime-offline-gpu-test realtime-gpu-catalog)
add_test(NAME realtime-offline-gpu COMMAND realtime-offline-gpu-test)
set_tests_properties(realtime-offline-gpu PROPERTIES TIMEOUT 180)
FetchContent_Declare(rt_wgpu
  URL https://github.com/gfx-rs/wgpu-native/releases/download/${_rt_wgpu_version}/${_rt_wgpu_asset}
  URL_HASH SHA256=${_rt_wgpu_hash}
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(rt_wgpu)
add_library(nt_realtime_wgpu STATIC IMPORTED)
if(WIN32)
  set(_rt_wgpu_library ${rt_wgpu_SOURCE_DIR}/lib/wgpu_native.lib)
else()
  set(_rt_wgpu_library ${rt_wgpu_SOURCE_DIR}/lib/libwgpu_native.a)
endif()
set_target_properties(nt_realtime_wgpu PROPERTIES IMPORTED_LOCATION ${_rt_wgpu_library}
  INTERFACE_INCLUDE_DIRECTORIES ${rt_wgpu_SOURCE_DIR}/include)
if(WIN32)
  target_link_libraries(nt_realtime_wgpu INTERFACE d3dcompiler ws2_32 userenv bcrypt ntdll opengl32 propsys runtimeobject)
elseif(APPLE)
  target_link_libraries(nt_realtime_wgpu INTERFACE "-framework Metal" "-framework QuartzCore" "-framework Foundation")
else()
  target_link_libraries(nt_realtime_wgpu INTERFACE ${CMAKE_DL_LIBS} m Threads::Threads)
endif()
add_library(nodetool_realtime_offline_gpu STATIC src/offline_gpu.cpp)
FetchContent_Declare(rt_stb
  URL https://github.com/nothings/stb/archive/d14d46f6b44456eb88beac58cba833a4135d4c89.tar.gz
  URL_HASH SHA256=1b59a668a789a28a8fd4e01ff1413eec7eaeb28688bafdc66ec7068f4e7095e1
  DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(rt_stb)
target_sources(nodetool_realtime_offline PRIVATE src/offline_image.cpp)
target_include_directories(nodetool_realtime_offline SYSTEM PRIVATE ${rt_stb_SOURCE_DIR})
target_compile_definitions(nodetool_realtime_offline PRIVATE NT_OFFLINE_GPU=1 NT_GPU_CATALOG="${NT_GPU_CATALOG}")
target_link_libraries(nodetool_realtime_offline PRIVATE nodetool_realtime_offline_gpu)
add_dependencies(nodetool-realtime realtime-gpu-catalog)
add_executable(realtime-offline-render-test tests/offline_render_test.cpp)
target_link_libraries(realtime-offline-render-test PRIVATE nodetool_realtime_offline)
target_include_directories(realtime-offline-render-test SYSTEM PRIVATE ${rt_stb_SOURCE_DIR})
target_compile_definitions(realtime-offline-render-test PRIVATE NT_GPU_CATALOG="${NT_GPU_CATALOG}" NT_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures")
add_dependencies(realtime-offline-render-test realtime-gpu-catalog)
add_test(NAME realtime-offline-render-export COMMAND realtime-offline-render-test)
set_tests_properties(realtime-offline-render-export PROPERTIES TIMEOUT 300)
target_link_libraries(nodetool_realtime_offline_gpu PUBLIC nodetool_realtime PRIVATE nt_realtime_wgpu)
foreach(target nodetool_realtime_offline_gpu realtime-offline-render-test)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /fp:strict)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -fno-fast-math -ffp-contract=off)
  endif()
endforeach()
