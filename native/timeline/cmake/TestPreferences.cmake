# Run after all test callbacks and subdirectories have registered their tests.
function(nt_isolate_preferences_directory directory)
    get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
    set(test_scope "")
    if(tests AND NOT directory STREQUAL CMAKE_CURRENT_SOURCE_DIR)
        if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
            set(test_scope DIRECTORY "${directory}")
        else()
            message(FATAL_ERROR "${directory}: isolating subdirectory tests needs CMake 3.28")
        endif()
    endif()
    foreach(test IN LISTS tests)
        # Include the directory in the key so equal names in different directories
        # still receive different files. Hashing also keeps names out of file paths.
        string(SHA256 key "${directory}/${test}")
        set(test_dir "${CMAKE_BINARY_DIR}/test-preferences/${key}")
        set(path "${test_dir}/Timeline.conf")
        get_property(environment TEST "${test}" ${test_scope} PROPERTY ENVIRONMENT)
        get_property(modifications TEST "${test}" ${test_scope} PROPERTY ENVIRONMENT_MODIFICATION)
        set(seed "")
        set(kept_environment "")
        set(kept_modifications "")
        foreach(entry IN LISTS environment)
            if(entry MATCHES "^NODETOOL_TIMELINE_PREFERENCES=(.*)$")
                set(seed "${CMAKE_MATCH_1}")
            else()
                list(APPEND kept_environment "${entry}")
            endif()
        endforeach()
        foreach(entry IN LISTS modifications)
            if(entry MATCHES "^NODETOOL_TIMELINE_PREFERENCES=set:(.*)$")
                set(seed "${CMAKE_MATCH_1}")
            elseif(entry MATCHES "^NODETOOL_TIMELINE_PREFERENCES=")
                message(FATAL_ERROR "${test}: preferences overrides must use set:<seed path>")
            else()
                list(APPEND kept_modifications "${entry}")
            endif()
        endforeach()
        set_property(TEST "${test}" ${test_scope} PROPERTY ENVIRONMENT "${kept_environment}")
        list(APPEND kept_modifications "NODETOOL_TIMELINE_PREFERENCES=set:${path}")
        set_property(TEST "${test}" ${test_scope} PROPERTY ENVIRONMENT_MODIFICATION "${kept_modifications}")
        if(NOT test STREQUAL "preferences_setup")
            set_property(TEST "${test}" ${test_scope} APPEND PROPERTY FIXTURES_REQUIRED timeline_preferences)
        endif()

        set_property(GLOBAL APPEND_STRING PROPERTY NT_PREFERENCES_SETUP
            "file(MAKE_DIRECTORY [==[${test_dir}]==])\n")
        if(NOT seed STREQUAL "")
            # Snapshot only configure-time templates. Tests never receive these
            # paths, so mutations cannot become the next invocation's seed.
            set(template "${CMAKE_BINARY_DIR}/test-preferences-seeds/${key}.ini")
            configure_file("${seed}" "${template}" COPYONLY)
            set_property(GLOBAL APPEND_STRING PROPERTY NT_PREFERENCES_SETUP
                "configure_file([==[${template}]==] [==[${path}]==] COPYONLY)\n")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        nt_isolate_preferences_directory("${child}")
    endforeach()
endfunction()

function(nt_isolate_test_preferences)
    set(setup "${CMAKE_BINARY_DIR}/test-preferences-setup.cmake")
    add_test(NAME preferences_setup COMMAND "${CMAKE_COMMAND}" -P "${setup}")
    set_tests_properties(preferences_setup PROPERTIES FIXTURES_SETUP timeline_preferences)
    set_property(GLOBAL PROPERTY NT_PREFERENCES_SETUP
        "execute_process(COMMAND [==[${CMAKE_COMMAND}]==] -E rm -rf [==[${CMAKE_BINARY_DIR}/test-preferences]==] COMMAND_ERROR_IS_FATAL ANY)\n")
    nt_isolate_preferences_directory("${CMAKE_CURRENT_SOURCE_DIR}")
    get_property(content GLOBAL PROPERTY NT_PREFERENCES_SETUP)
    file(GENERATE OUTPUT "${setup}" CONTENT "${content}")
endfunction()
