set(modules timeline_qml nodetool_ui_primitives nodetool_chat nodetool_model_picker tst_providerdialog)
set(themes Theme Theme ChatMetrics ModelPickerMetrics Theme)
set(entries "")
foreach(index RANGE 0 4)
    list(GET modules ${index} module)
    list(GET themes ${index} theme)
    list(APPEND entries "{\"file\":\"/build/${module}_qmltyperegistrations.cpp\"}" "{\"file\":\"/build/${module}_qml_${theme}_qml.cpp\"}")
endforeach()
string(JOIN "," valid ${entries})
file(WRITE "${NT_BUILD_DIR}/shared-qml-valid.json" "[${valid}]")
file(WRITE "${NT_BUILD_DIR}/shared-qml-invalid.json" "[${valid},{\"file\":\"/other/timeline_qml_qmltyperegistrations.cpp\"}]")
file(WRITE "${NT_BUILD_DIR}/shared-qml-empty.json" "[]")
file(WRITE "${NT_BUILD_DIR}/shared-qml-multiconfig.json" "[${valid},${valid}]")
foreach(fixture valid multiconfig invalid empty)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DNT_COMPILE_COMMANDS=${NT_BUILD_DIR}/shared-qml-${fixture}.json"
        -P "${CMAKE_CURRENT_LIST_DIR}/SharedQmlBuild.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(((fixture STREQUAL "valid" OR fixture STREQUAL "multiconfig") AND NOT result EQUAL 0) OR
       ((fixture STREQUAL "invalid" OR fixture STREQUAL "empty") AND result EQUAL 0))
        message(FATAL_ERROR "Unexpected result for ${fixture} fixture: ${result}")
    endif()
endforeach()
