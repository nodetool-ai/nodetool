if(NOT DEFINED NT_COMPILE_COMMANDS)
    set(NT_COMPILE_COMMANDS "${NT_BUILD_DIR}/compile_commands.json")
endif()
file(READ "${NT_COMPILE_COMMANDS}" commands)
string(REGEX MATCHALL "\"file\"[ \t\r\n]*:[ \t\r\n]*\"[^\"]+\"" sources "${commands}")
list(REMOVE_DUPLICATES sources)
list(LENGTH sources count)
if(count LESS 1)
    message(FATAL_ERROR "No compilation commands inspected")
endif()
set(modules timeline_qml nodetool_ui_primitives nodetool_chat nodetool_model_picker tst_providerdialog)
set(theme_timeline_qml TimelineMetrics)
set(theme_nodetool_ui_primitives Theme)
set(theme_nodetool_chat ChatMetrics)
set(theme_nodetool_model_picker ModelPickerMetrics)
set(theme_tst_providerdialog TimelineVisuals)
foreach(module IN LISTS modules)
    set(reg_${module} 0)
    set(cache_${module} 0)
endforeach()
foreach(source IN LISTS sources)
    foreach(module IN LISTS modules)
        if(source MATCHES "${module}_qmltyperegistrations\\.cpp\"$")
            math(EXPR reg_${module} "${reg_${module}} + 1")
        endif()
        if(source MATCHES "${module}_qml_${theme_${module}}_qml\\.cpp\"$")
            math(EXPR cache_${module} "${cache_${module}} + 1")
        endif()
    endforeach()
endforeach()
foreach(module IN LISTS modules)
    if(NOT reg_${module} EQUAL 1 OR NOT cache_${module} EQUAL 1)
        message(FATAL_ERROR "${module}: expected one registration and representative singleton cache compilation, found ${reg_${module}} and ${cache_${module}}")
    endif()
endforeach()
message(STATUS "Checked ${count} compilation commands across ${modules}")
