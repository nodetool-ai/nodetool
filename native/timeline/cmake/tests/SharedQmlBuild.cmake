# Run against a configured Ninja/Makefiles build with compile commands enabled.
file(STRINGS "${NT_BUILD_DIR}/compile_commands.json" sources REGEX "\"file\":")
list(LENGTH sources count)
set(module_sources "")
foreach(source IN LISTS sources)
    string(REGEX REPLACE ",$" "" source "${source}")
    string(JSON source GET "{${source}}" file)
    if(source MATCHES "(qmltyperegistrations|Theme_qml)\\.cpp$")
        list(APPEND module_sources "${source}")
    endif()
endforeach()
# Multi-config generators compile the same module sources per configuration.
list(REMOVE_DUPLICATES module_sources)
set(registrations 0)
set(theme_cache_objects 0)
foreach(source IN LISTS module_sources)
    # ProviderDialogTests.cmake owns a deliberately isolated, small QML module.
    if(source MATCHES "tst_providerdialog(_qmltyperegistrations|_qml_Theme_qml)\\.cpp$")
        continue()
    endif()
    if(source MATCHES "qmltyperegistrations\\.cpp$")
        math(EXPR registrations "${registrations} + 1")
    endif()
    if(source MATCHES "Theme_qml\\.cpp$")
        math(EXPR theme_cache_objects "${theme_cache_objects} + 1")
    endif()
endforeach()
if(NOT registrations EQUAL 1 OR NOT theme_cache_objects EQUAL 1)
    message(FATAL_ERROR "Expected one shared QML registration and Theme cache object, found ${registrations} and ${theme_cache_objects}")
endif()
message(STATUS "One QML registration and Theme cache object across ${count} compilation commands")
