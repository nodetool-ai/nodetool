nt_sources(audio src/audio/effects/Effects.h src/audio/effects/Effects.cpp src/audio/effects/Oversampler.h src/audio/effects/Oversampler.cpp)
function(nt_effect_tests)
    qt_add_executable(p1-render src/audio/effects/render.cpp)
    set_target_properties(p1-render PROPERTIES MACOSX_BUNDLE FALSE)
    target_link_libraries(p1-render PRIVATE timeline_audio)
    qt_add_executable(tst_audioeffects src/audio/effects/tst_audioeffects.cpp)
    set_target_properties(tst_audioeffects PROPERTIES MACOSX_BUNDLE FALSE)
    target_link_libraries(tst_audioeffects PRIVATE timeline_audio Qt6::Test)
    add_test(NAME tst_audioeffects COMMAND tst_audioeffects)
    set_tests_properties(tst_audioeffects PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    add_test(NAME audio_effect_oracle COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/audio/effects/oracle.mjs $<TARGET_FILE:p1-render>)
    qt_add_executable(tst_fxcontrols src/audio/effects/tst_fxcontrols.cpp)
    set_target_properties(tst_fxcontrols PROPERTIES MACOSX_BUNDLE FALSE)
    target_link_libraries(tst_fxcontrols PRIVATE timeline_core timeline_decode timeline_server
        Qt6::Gui Qt6::GuiPrivate Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::Test PkgConfig::FFMPEG ${NT_APP_PLATFORM_LIBS})
    nt_add_timeline_qml(tst_fxcontrols OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/tst_fxcontrols_qml/NodeTool/Timeline)
    if(UNIX AND NOT APPLE)
        target_sources(tst_fxcontrols PRIVATE src/preview/hw/HwWindow.h src/preview/hw/HwWindow.cpp)
    endif()
    add_test(NAME tst_fxcontrols COMMAND tst_fxcontrols)
    set_tests_properties(tst_fxcontrols PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software")
    add_test(NAME fx_params_oracle COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/audio/effects/params-oracle.mjs $<TARGET_FILE:tst_fxcontrols>)
endfunction()
nt_tests(nt_effect_tests)
