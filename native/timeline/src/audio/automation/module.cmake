function(nt_automation_tests)
    qt_add_executable(tst_automation src/audio/automation/tst_automation.cpp)
    target_link_libraries(tst_automation PRIVATE timeline_audio Qt6::Test)
    add_test(NAME tst_automation COMMAND tst_automation)
    set_tests_properties(tst_automation PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    add_test(NAME automation_oracle COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/audio/automation/oracle.mjs $<TARGET_FILE:tst_automation>)
    add_test(NAME automation_picture_oracle COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/audio/automation/picture-oracle.mjs $<TARGET_FILE:nodetool-timeline>)
    add_test(NAME automation_mixer_helpers COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/audio/automation/mixer-helper-oracle.mjs)
    add_test(NAME automation_render_oracle COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/audio/automation/render-oracle.mjs $<TARGET_FILE:p2-render>)
    qt_add_executable(p2-render src/audio/effects/render.cpp src/audio/automation/Registrations.cpp)
    target_link_libraries(p2-render PRIVATE timeline_audio)
    qt_add_executable(tst_automationui src/audio/automation/tst_automationui.cpp ${NT_app})
    target_link_libraries(tst_automationui PRIVATE timeline_core timeline_decode timeline_audio timeline_server
        Qt6::Gui Qt6::GuiPrivate Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::Test PkgConfig::FFMPEG ${NT_APP_PLATFORM_LIBS})
    nt_add_timeline_qml(tst_automationui OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/tst_automationui_qml/NodeTool/Timeline)
    add_test(NAME tst_automationui COMMAND tst_automationui)
    set_tests_properties(tst_automationui PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software")
endfunction()
nt_tests(nt_automation_tests)
