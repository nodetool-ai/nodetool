nt_qml_sources(src/app/Menus/ShellMenus.h src/app/Menus/ShellMenus.cpp)
function(nt_shell_tests)
    qt_add_executable(tst_appshell src/app/Menus/tst_appshell.cpp
        src/app/Preferences/AppShellRegistration.cpp)
    set_target_properties(tst_appshell PROPERTIES MACOSX_BUNDLE FALSE)
    target_compile_options(tst_appshell PRIVATE ${NT_WARNINGS})
    target_link_libraries(tst_appshell PRIVATE timeline_core timeline_decode timeline_server
        Qt6::GuiPrivate Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::Test ${NT_APP_PLATFORM_LIBS})
    target_compile_definitions(tst_appshell PRIVATE NT_FIXTURES_DIR="${CMAKE_CURRENT_SOURCE_DIR}/fixtures")
    nt_add_timeline_qml(tst_appshell OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/tst_appshell_qml/NodeTool/Timeline)
    if(UNIX AND NOT APPLE)
        target_sources(tst_appshell PRIVATE src/preview/hw/HwWindow.h src/preview/hw/HwWindow.cpp)
    endif()
    add_test(NAME tst_appshell_menus COMMAND tst_appshell shellRegistration menus conversions dispatch)
    set_tests_properties(tst_appshell_menus PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software;NODETOOL_TIMELINE_PREFERENCES=${CMAKE_CURRENT_BINARY_DIR}/shell-test-startup.ini")
    qt_add_executable(tst_appshell_isolation src/app/Menus/tst_appshell_isolation.cpp
        src/app/PanelRegistry.cpp "${CMAKE_CURRENT_BINARY_DIR}/nt_qml_panels.cpp")
    set_target_properties(tst_appshell_isolation PROPERTIES MACOSX_BUNDLE FALSE)
    target_include_directories(tst_appshell_isolation PRIVATE src)
    target_link_libraries(tst_appshell_isolation PRIVATE Qt6::Core Qt6::Qml)
    add_test(NAME tst_appshell_isolation COMMAND tst_appshell_isolation)
endfunction()
nt_tests(nt_shell_tests)
