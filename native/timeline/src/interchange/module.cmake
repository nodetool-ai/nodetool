function(nt_interchange_tests)
    qt_add_executable(tst_premiere src/interchange/tst_premiere.cpp src/interchange/PremierePanel.cpp)
    set_target_properties(tst_premiere PROPERTIES MACOSX_BUNDLE FALSE)
    target_link_libraries(tst_premiere PRIVATE timeline_core timeline_decode timeline_server
        Qt6::Gui Qt6::GuiPrivate Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::Test PkgConfig::FFMPEG ${NT_APP_PLATFORM_LIBS})
    nt_add_timeline_qml(tst_premiere OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/tst_premiere_qml/NodeTool/Timeline)
    if(UNIX AND NOT APPLE)
        target_sources(tst_premiere PRIVATE src/preview/hw/HwWindow.h src/preview/hw/HwWindow.cpp)
    endif()
    add_test(NAME tst_premiere COMMAND tst_premiere)
    set_tests_properties(tst_premiere PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software")
    add_test(NAME premiere_server COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/interchange/premiere-server.test.mjs $<TARGET_FILE:tst_premiere>)
    set_tests_properties(premiere_server PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 420)
endfunction()
nt_tests(nt_interchange_tests)
