file(REMOVE_RECURSE "${NT_TEST_DIR}")
file(MAKE_DIRECTORY "${NT_TEST_DIR}/source/qml")
file(WRITE "${NT_TEST_DIR}/source/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.21)\nproject(MarkerDiscovery NONE)\ninclude(\"${NT_DISCOVERY}\")\n")
function(configure_marker marker expected)
    file(WRITE "${NT_TEST_DIR}/source/qml/Probe.qml" "${marker}\nimport QtQuick\nItem {}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${NT_TEST_DIR}/source" -B "${NT_TEST_DIR}/build"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(REMOVE "${NT_TEST_DIR}/source/qml/Probe.qml")
    if(expected STREQUAL "accept")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Valid camelCase marker refused: ${output}${error}")
        endif()
        file(READ "${NT_TEST_DIR}/build/nt_qml_panels.cpp" generated)
        if(NOT generated MATCHES "clipBody" OR NOT generated MATCHES "probe")
            message(FATAL_ERROR "Panel discovery generated no camelCase registration")
        endif()
    elseif(status EQUAL 0 OR NOT error MATCHES "malformed nt-panel marker")
        message(FATAL_ERROR "Malformed marker configure did not fail: ${status}: ${output}${error}")
    endif()
    message(STATUS "Marker ${expected}: configure exit ${status}")
endfunction()
configure_marker("// nt-panel: slot=clipBody id=probe order=0 title=\"Probe\"" accept)
configure_marker("// nt-panel: slot=bad-slot id=probe order=0 title=\"Probe\"" reject)
configure_marker("// nt-panel: slot=Upper id=probe order=0 title=\"Probe\"" reject)
configure_marker("// nt-panel: slot=clipBody id=probe order=0" reject)
file(REMOVE_RECURSE "${NT_TEST_DIR}")
