function(nt_assets_tests)
    qt_add_executable(nt_assets_oracle src/assets/AssetOracle.cpp src/assets/AssetRegistration.cpp)
    set_target_properties(nt_assets_oracle PROPERTIES MACOSX_BUNDLE FALSE)
    target_link_libraries(nt_assets_oracle PRIVATE timeline_core)
    qt_add_executable(tst_assets src/assets/tst_assets.cpp src/assets/AssetRegistration.cpp
        src/model/TimelineModel.h src/model/TimelineModel.cpp
        src/model/TrackListModel.h src/model/TrackListModel.cpp)
    target_link_libraries(tst_assets PRIVATE timeline_core Qt6::Gui Qt6::Qml Qt6::Test)
    add_test(NAME tst_assets COMMAND tst_assets)
    set_tests_properties(tst_assets PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    qt_add_executable(nt_assets_import src/assets/AssetImportCli.cpp)
    target_link_libraries(nt_assets_import PRIVATE timeline_server)
    add_test(NAME assets_import_server COMMAND node ${CMAKE_CURRENT_SOURCE_DIR}/src/assets/import-server.test.mjs $<TARGET_FILE:nt_assets_import> $<TARGET_FILE:tst_assetbrowser>)
    set_tests_properties(assets_import_server PROPERTIES SKIP_RETURN_CODE 77 ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 360)
    qt_add_executable(tst_assetbrowser src/assets/tst_assetbrowser.cpp src/assets/AssetPanels.cpp)
    set_target_properties(tst_assetbrowser PROPERTIES MACOSX_BUNDLE FALSE)
    target_link_libraries(tst_assetbrowser PRIVATE timeline_core timeline_decode timeline_server
        Qt6::Gui Qt6::GuiPrivate Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::Test PkgConfig::FFMPEG ${NT_APP_PLATFORM_LIBS})
    nt_add_timeline_qml(tst_assetbrowser OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/tst_assetbrowser_qml/NodeTool/Timeline)
    if(UNIX AND NOT APPLE)
        target_sources(tst_assetbrowser PRIVATE src/preview/hw/HwWindow.h src/preview/hw/HwWindow.cpp)
    endif()
    add_test(NAME tst_assetbrowser COMMAND tst_assetbrowser)
    set_tests_properties(tst_assetbrowser PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software")
endfunction()
nt_tests(nt_assets_tests)
