function(nt_motion_control_ui_tests)
    find_package(Qt6 6.12 REQUIRED COMPONENTS QuickTest)
    qt_add_executable(tst_followpathui src/motion/controls/tst_followpathui.cpp)
    target_compile_options(tst_followpathui PRIVATE ${NT_WARNINGS})
    target_link_libraries(tst_followpathui PRIVATE timeline_core timeline_decode timeline_server
        Qt6::Gui Qt6::GuiPrivate Qt6::Qml Qt6::Quick Qt6::QuickControls2 Qt6::QuickTest PkgConfig::FFMPEG ${NT_APP_PLATFORM_LIBS})
    nt_add_timeline_qml(tst_followpathui OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/tst_followpathui_qml/NodeTool/Timeline)
    if(UNIX AND NOT APPLE)
        target_sources(tst_followpathui PRIVATE src/preview/hw/HwWindow.h src/preview/hw/HwWindow.cpp)
    endif()
    add_test(NAME tst_followpathui COMMAND tst_followpathui -input ${CMAKE_CURRENT_SOURCE_DIR}/src/motion/controls/qmltests)
    set_tests_properties(tst_followpathui PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen;QT_QUICK_BACKEND=software")
endfunction()
nt_tests(nt_motion_control_ui_tests)
