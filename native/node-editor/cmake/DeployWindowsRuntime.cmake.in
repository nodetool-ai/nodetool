cmake_minimum_required(VERSION 3.24)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
if(NOT EXISTS "${EDITOR_BINARY}")
    message(FATAL_ERROR "Editor executable does not exist: ${EDITOR_BINARY}")
endif()
if(NOT EXISTS "@guest_bundle@")
    message(FATAL_ERROR "Build the guest first with node native/graph-runner/guest/build.mjs")
endif()
get_filename_component(destination "${EDITOR_BINARY}" DIRECTORY)
set(compiler_runtime "@CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS@")
if(NOT compiler_runtime)
    message(FATAL_ERROR "The MSVC redistributable runtime was not found")
endif()
foreach(dependency IN LISTS compiler_runtime)
    get_filename_component(name "${dependency}" NAME)
    file(COPY_FILE "${dependency}" "${destination}/${name}" ONLY_IF_DIFFERENT)
endforeach()
execute_process(COMMAND "@NODETOOL_WINDEPLOYQT@" --no-translations --no-compiler-runtime
    --qmldir "@CMAKE_CURRENT_SOURCE_DIR@/qml" "${EDITOR_BINARY}"
    COMMAND_ERROR_IS_FATAL ANY)

# Imported pkg-config libraries do not populate TARGET_RUNTIME_DLLS. Inspect
# their PE imports, including the dynamically loaded Qt plugins deployed above.
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@NODETOOL_DUMPBIN@")
file(GLOB_RECURSE plugins "${destination}/*.dll")
set(runtime_directories "@runtime_directories@")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${EDITOR_BINARY}"
    LIBRARIES ${plugins}
    DIRECTORIES "${destination}" ${runtime_directories}
    RESOLVED_DEPENDENCIES_VAR resolved
    UNRESOLVED_DEPENDENCIES_VAR unresolved
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES "^[A-Za-z]:[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\]")
if(unresolved)
    message(FATAL_ERROR "Missing Windows runtime dependencies: ${unresolved}")
endif()
foreach(dependency IN LISTS resolved)
    get_filename_component(name "${dependency}" NAME)
    file(COPY_FILE "${dependency}" "${destination}/${name}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "@guest_bundle@" "${destination}/guest.js" ONLY_IF_DIFFERENT)
