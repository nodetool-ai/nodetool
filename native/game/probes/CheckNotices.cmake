if(NOT DEFINED GAME_NOTICES)
  set(GAME_NOTICES QuickJS-LICENSE Jolt-LICENSE)
endif()
foreach(notice IN LISTS GAME_NOTICES)
  if(NOT EXISTS "${GAME_LICENSE_DIR}/${notice}")
    message(FATAL_ERROR "Missing dependency notice: ${notice}")
  endif()
  file(READ "${GAME_LICENSE_DIR}/${notice}" text)
  if(NOT text MATCHES "Permission is hereby granted")
    message(FATAL_ERROR "Invalid dependency notice: ${notice}")
  endif()
endforeach()
