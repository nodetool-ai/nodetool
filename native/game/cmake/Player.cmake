find_package(Qt6 6.12 REQUIRED COMPONENTS Core Gui GuiPrivate Quick Qml ShaderTools Test)
if(Qt6_VERSION VERSION_GREATER_EQUAL 6.13)
  message(FATAL_ERROR "Native game QRhi renderer requires the tested Qt 6.12 minor version")
endif()
set(CMAKE_AUTOMOC ON)
add_library(game_render src/render/GameViewport.cpp src/render/GameViewport.h src/render/Scene2D.cpp src/render/Scene2D.h)
target_include_directories(game_render PUBLIC src)
target_link_libraries(game_render PUBLIC game_document Qt6::Quick Qt6::GuiPrivate)
qt_add_shaders(game_render game_shaders PREFIX "/game" BASE "${CMAKE_CURRENT_SOURCE_DIR}/src/render" FILES
  src/render/shaders/sprite.vert src/render/shaders/sprite.frag src/render/shaders/shadow.vert src/render/shaders/shadow.frag src/render/shaders/mesh.vert src/render/shaders/mesh.frag src/render/shaders/hud.vert src/render/shaders/hud.frag)
if(TARGET game_assets)
  target_link_libraries(game_render PUBLIC game_assets)
endif()
add_executable(game-player src/player/Main.cpp)
target_link_libraries(game-player PRIVATE game_render game_core game_player_audio game_assets Qt6::Qml Threads::Threads)
if(BUILD_TESTING)
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  add_executable(game-render-tests tests/RenderTest.cpp)
  target_link_libraries(game-render-tests PRIVATE game_render Qt6::Test)
  add_test(NAME native-game-player-unit COMMAND game-render-tests)
  set_tests_properties(native-game-player-unit PROPERTIES LABELS player ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
  add_test(NAME native-game-player2d-audio COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/player2d_audio_test.py $<TARGET_FILE:game-player>)
  set_tests_properties(native-game-player2d-audio PROPERTIES LABELS "player;2d;audio")
  add_test(NAME native-game-player2d COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/player2d_test.py $<TARGET_FILE:game-player>)
  set_tests_properties(native-game-player2d PROPERTIES LABELS "player;2d")
  add_test(NAME native-game-player2d-live-input COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/player2d_live_input_test.py $<TARGET_FILE:game-player>)
  set_tests_properties(native-game-player2d-live-input PROPERTIES LABELS "player;2d;input")
  if(UNIX AND NOT APPLE)
    add_test(NAME native-game-player-camera-input COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/player_camera_input_test.py $<TARGET_FILE:game-player>)
    set_tests_properties(native-game-player-camera-input PROPERTIES LABELS "player;camera;input")
  endif()
  add_test(NAME native-game-player-camera COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/player_camera_test.py $<TARGET_FILE:game-player>)
  set_tests_properties(native-game-player-camera PROPERTIES LABELS "player;camera")
  add_test(NAME native-game-player COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/player_test.py $<TARGET_FILE:game-player>)
  set_tests_properties(native-game-player PROPERTIES LABELS player)
endif()

# The environment renderer is opt-in; the established fixed renderer and 2D
# renderer retain their existing pipelines for documents without this contract.
target_sources(game_render PRIVATE
  src/render/Scene3D.cpp src/render/Scene3D.h
  src/render/Sky3D.cpp src/render/Sky3D.h
  src/render/Hud3D.cpp src/render/Hud3D.h
  src/render/Effects3D.cpp src/render/Effects3D.h
  src/render/Decals3D.cpp src/render/Decals3D.h
  src/render/PostFX3D.cpp src/render/PostFX3D.h)
qt_add_shaders(game_render game_pbr_shaders GLSL "300 es,330" PREFIX "/game" BASE "${CMAKE_CURRENT_SOURCE_DIR}/src/render" FILES
  src/render/shaders/sky_filter.vert src/render/shaders/sky_cube_to_uv.frag src/render/shaders/sky_pmrem.frag
  src/render/shaders/sky_background.vert src/render/shaders/sky_background.frag
  src/render/shaders/pbr.vert src/render/shaders/pbr.frag src/render/shaders/pbr_transparent.frag
  src/render/shaders/pbr_shadow.vert src/render/shaders/pbr_shadow.frag
  src/render/shaders/scene_copy.vert src/render/shaders/scene_copy.frag src/render/shaders/scene_hud.frag
  src/render/shaders/particles.vert src/render/shaders/particles.frag
  src/render/shaders/postfx.vert src/render/shaders/postfx.frag
  src/render/shaders/postfx_smaa_edges.vert src/render/shaders/postfx_smaa_edges.frag
  src/render/shaders/postfx_smaa_weights.vert src/render/shaders/postfx_smaa_weights.frag
  src/render/shaders/postfx_smaa_blend.vert src/render/shaders/postfx_smaa_blend.frag)
qt_add_resources(game_render game_postfx_assets PREFIX "/game" BASE "${CMAKE_CURRENT_SOURCE_DIR}/assets" FILES
  assets/native-smaa-area.png assets/native-smaa-search.png assets/native-smaa.json assets/native-dfg.rg16f assets/native-dfg.json)
