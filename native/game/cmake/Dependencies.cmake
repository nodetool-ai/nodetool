# Dependency probes deliberately use the same pins for native and Emscripten.
enable_language(C)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../dependencies.json" GAME_DEPENDENCIES)
foreach(dependency quickjs jolt)
  string(JSON dependency_url GET "${GAME_DEPENDENCIES}" ${dependency} url)
  string(JSON dependency_hash GET "${GAME_DEPENDENCIES}" ${dependency} sha256)
  FetchContent_Declare(${dependency} URL "${dependency_url}" URL_HASH "SHA256=${dependency_hash}" SOURCE_SUBDIR nodetool-no-autoload)
  FetchContent_MakeAvailable(${dependency})
endforeach()
add_library(game_quickjs STATIC
  ${quickjs_SOURCE_DIR}/quickjs.c ${quickjs_SOURCE_DIR}/dtoa.c
  ${quickjs_SOURCE_DIR}/libregexp.c ${quickjs_SOURCE_DIR}/libunicode.c
  ${quickjs_SOURCE_DIR}/cutils.c)
target_include_directories(game_quickjs SYSTEM PUBLIC ${quickjs_SOURCE_DIR})
if(MSVC)
  target_compile_options(game_quickjs PRIVATE /w)
else()
  target_compile_options(game_quickjs PRIVATE -w)
  if(GAME_SANITIZERS)
    # Pinned QuickJS packs opcode bytes with signed shifts in its M4 macro.
    # Keep ASan and the other UBSan checks on the dependency and all checks on our code.
    target_compile_options(game_quickjs PRIVATE -fno-sanitize=shift)
  endif()
endif()
target_compile_definitions(game_quickjs PRIVATE _GNU_SOURCE CONFIG_VERSION="2025-09-13")
if(UNIX)
  target_link_libraries(game_quickjs PUBLIC m)
endif()
set(OVERRIDE_CXX_FLAGS OFF CACHE BOOL "" FORCE)
set(INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "" FORCE)
set(ENABLE_ALL_WARNINGS OFF CACHE BOOL "" FORCE)
set(GENERATE_DEBUG_SYMBOLS OFF CACHE BOOL "" FORCE)
set(CROSS_PLATFORM_DETERMINISTIC ON CACHE BOOL "" FORCE)
set(DEBUG_RENDERER_IN_DEBUG_AND_RELEASE OFF CACHE BOOL "" FORCE)
set(PROFILER_IN_DEBUG_AND_RELEASE OFF CACHE BOOL "" FORCE)
foreach(feature SSE4_1 SSE4_2 AVX AVX2 AVX512 LZCNT TZCNT F16C FMADD)
  set(USE_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory(${jolt_SOURCE_DIR}/Build ${jolt_BINARY_DIR} EXCLUDE_FROM_ALL)
if(EMSCRIPTEN)
  target_compile_definitions(game_quickjs PRIVATE EMSCRIPTEN)
endif()
if(GAME_BUILD_DEPENDENCY_PROBES)
  add_executable(game-dependency-probe "${CMAKE_CURRENT_LIST_DIR}/../probes/Dependencies.cpp")
  target_link_libraries(game-dependency-probe PRIVATE game_quickjs Jolt)
  if(EMSCRIPTEN)
    set_target_properties(game-dependency-probe PROPERTIES SUFFIX ".js")
    target_link_options(game-dependency-probe PRIVATE -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 -sINITIAL_MEMORY=33554432 -sENVIRONMENT=node)
    if(BUILD_TESTING)
      find_program(GAME_NODE_EXECUTABLE node REQUIRED)
      add_test(NAME native-game-dependencies COMMAND ${GAME_NODE_EXECUTABLE} $<TARGET_FILE:game-dependency-probe>)
    endif()
  elseif(BUILD_TESTING)
    add_test(NAME native-game-dependencies COMMAND game-dependency-probe)
  endif()
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/licenses")
configure_file(${quickjs_SOURCE_DIR}/LICENSE "${CMAKE_BINARY_DIR}/licenses/QuickJS-LICENSE" COPYONLY)
configure_file(${jolt_SOURCE_DIR}/LICENSE "${CMAKE_BINARY_DIR}/licenses/Jolt-LICENSE" COPYONLY)
if(BUILD_TESTING)
  add_test(NAME native-game-dependency-notices COMMAND ${CMAKE_COMMAND}
    -DGAME_LICENSE_DIR=${CMAKE_BINARY_DIR}/licenses
    -P ${CMAKE_CURRENT_LIST_DIR}/../probes/CheckNotices.cmake)
endif()

if(DEFINED json_SOURCE_DIR)
  configure_file(${json_SOURCE_DIR}/LICENSE.MIT "${CMAKE_BINARY_DIR}/licenses/nlohmann-json-LICENSE" COPYONLY)
  if(BUILD_TESTING)
    add_test(NAME native-game-json-notice COMMAND ${CMAKE_COMMAND}
      -DGAME_LICENSE_DIR=${CMAKE_BINARY_DIR}/licenses -DGAME_NOTICES=nlohmann-json-LICENSE
      -P ${CMAKE_CURRENT_LIST_DIR}/../probes/CheckNotices.cmake)
  endif()
endif()
