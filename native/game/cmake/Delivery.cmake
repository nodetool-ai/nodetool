include(GNUInstallDirs)
foreach(target game-worker game-player game-editor)
  if(TARGET ${target})
    target_compile_definitions(${target} PRIVATE GAME_BUILD_CONFIGURATION="$<CONFIG>")
  endif()
endforeach()
install(TARGETS game-worker RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(DIRECTORY "${CMAKE_BINARY_DIR}/licenses/" DESTINATION share/nodetool-game/licenses)
install(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/licenses/" DESTINATION share/nodetool-game/licenses)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/src/render/Sky3D-LICENSE.txt"
  DESTINATION share/nodetool-game/licenses RENAME three-sky-PMREM-LICENSE.txt)
install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.json" DESTINATION share/nodetool-game)
if(TARGET game-player)
  set_target_properties(game-player PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
  install(TARGETS game-player RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} BUNDLE DESTINATION .)
  qt_generate_deploy_app_script(TARGET game-player OUTPUT_SCRIPT game_player_deploy NO_TRANSLATIONS)
  install(SCRIPT ${game_player_deploy})
endif()
if(TARGET game-editor)
  set_target_properties(game-editor PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
  install(TARGETS game-editor RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} BUNDLE DESTINATION .)
  qt_generate_deploy_qml_app_script(TARGET game-editor OUTPUT_SCRIPT game_editor_deploy NO_TRANSLATIONS)
  install(SCRIPT ${game_editor_deploy})
endif()
add_executable(game-bench src/bench/Main.cpp)
target_link_libraries(game-bench PRIVATE game_core)
target_compile_definitions(game-bench PRIVATE GAME_BUILD_CONFIGURATION="$<CONFIG>")
if(WIN32)
  target_link_libraries(game-bench PRIVATE Psapi)
endif()
install(TARGETS game-bench RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
if(BUILD_TESTING)
  add_executable(game-timing-tests tests/TimingTest.cpp)
  target_link_libraries(game-timing-tests PRIVATE game_core)
  add_test(NAME native-game-timings COMMAND game-timing-tests)
  add_test(NAME native-game-bench COMMAND game-bench "${CMAKE_CURRENT_SOURCE_DIR}/benchmarks/course.json" --ticks 12 --warmup 2)
  add_test(NAME native-game-bench-budget-rejection COMMAND game-bench "${CMAKE_CURRENT_SOURCE_DIR}/benchmarks/course.json" --ticks 2 --warmup 0 --max-p95-ms 0.000000001)
  set_tests_properties(native-game-bench-budget-rejection PROPERTIES WILL_FAIL TRUE)
  set_tests_properties(native-game-bench native-game-bench-budget-rejection PROPERTIES LABELS bench)
endif()
