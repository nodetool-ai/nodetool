find_package(Qt6 6.12 REQUIRED COMPONENTS QuickControls2 Network)
add_library(game_editor_model src/editor/EditorController.cpp src/editor/EditorController.h)
target_include_directories(game_editor_model PUBLIC src)
target_link_libraries(game_editor_model PUBLIC game_core game_render Qt6::Network)
add_executable(game-editor src/editor/Main.cpp)
target_link_libraries(game-editor PRIVATE game_editor_model Qt6::QuickControls2)
set_source_files_properties(qml/Editor.qml PROPERTIES QT_RESOURCE_ALIAS Editor.qml)
qt_add_qml_module(game-editor URI NodeTool.GameEditor VERSION 1.0
  RESOURCE_PREFIX "/game-editor" NO_RESOURCE_TARGET_PATH NO_CACHEGEN
  QML_FILES qml/Editor.qml)
if(BUILD_TESTING)
 add_executable(game-editor-tests tests/EditorTest.cpp)
 target_link_libraries(game-editor-tests PRIVATE game_editor_model Qt6::Test)
 add_test(NAME native-game-editor COMMAND game-editor-tests)
 set_tests_properties(native-game-editor PROPERTIES LABELS "player;editor" ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
 add_test(NAME native-game-editor-ui COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/editor_ui_test.py $<TARGET_FILE:game-editor>)
 set_tests_properties(native-game-editor-ui PROPERTIES LABELS "player;editor")
endif()
if(BUILD_TESTING)
 add_executable(game-editor-gesture-tests tests/EditorGestureTest.cpp)
 target_link_libraries(game-editor-gesture-tests PRIVATE game_editor_model Qt6::QuickControls2 Qt6::Test)
 qt_add_resources(game-editor-gesture-tests game_editor_test_qml PREFIX "/game-editor" BASE "${CMAKE_CURRENT_SOURCE_DIR}/qml" FILES qml/Editor.qml)
 add_test(NAME native-game-editor-gestures COMMAND game-editor-gesture-tests)
 set_tests_properties(native-game-editor-gestures PROPERTIES LABELS "player;editor")
endif()
qt_finalize_target(game-editor)
