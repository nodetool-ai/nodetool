set(GAME_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
add_library(game_document ${GAME_SOURCE_DIR}/src/document/Document.cpp ${GAME_SOURCE_DIR}/src/core/VisualHierarchy3D.cpp ${GAME_SOURCE_DIR}/src/document/Schema.cpp ${GAME_SOURCE_DIR}/src/physics/World2D.cpp)
target_include_directories(game_document PUBLIC ${GAME_SOURCE_DIR}/src)
target_link_libraries(game_document PUBLIC nlohmann_json::nlohmann_json)
file(READ "${GAME_SOURCE_DIR}/generated/document.schema.json" GAME_DOCUMENT_SCHEMA)
file(READ "${GAME_SOURCE_DIR}/generated/transaction.schema.json" GAME_TRANSACTION_SCHEMA)
file(READ "${GAME_SOURCE_DIR}/generated/transaction2d.schema.json" GAME_TRANSACTION2D_SCHEMA)
configure_file(${GAME_SOURCE_DIR}/src/document/EmbeddedSchemas.h.in generated/EmbeddedSchemas.h @ONLY)
target_include_directories(game_document PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
set(OBJECT_LAYER_BITS 32 CACHE STRING "Native game collision layer encoding" FORCE)
option(GAME_BUILD_DEPENDENCY_PROBES "Build QuickJS and Jolt dependency probes" ON)
include(${GAME_SOURCE_DIR}/cmake/Dependencies.cmake)
include(${GAME_SOURCE_DIR}/cmake/Scripts.cmake)
include(${GAME_SOURCE_DIR}/cmake/Assets.cmake)
add_library(game_core ${GAME_SOURCE_DIR}/src/core/Session.cpp ${GAME_SOURCE_DIR}/src/presentation/Particles3D.cpp ${GAME_SOURCE_DIR}/src/physics/World.cpp ${GAME_SOURCE_DIR}/src/physics/WorldRtti.cpp ${GAME_SOURCE_DIR}/src/physics/SpatialWorld.cpp)
# Jolt disables C++ RTTI. Match its virtual-type interface in the owning source.
if(MSVC)
  set_source_files_properties(${GAME_SOURCE_DIR}/src/physics/World.cpp PROPERTIES COMPILE_OPTIONS /GR-)
else()
  set_source_files_properties(${GAME_SOURCE_DIR}/src/physics/World.cpp PROPERTIES COMPILE_OPTIONS -fno-rtti)
endif()
target_include_directories(game_core PUBLIC ${GAME_SOURCE_DIR}/src)
target_link_libraries(game_core PUBLIC game_document game_scripts game_assets Jolt)

add_library(game_service ${GAME_SOURCE_DIR}/src/service/Dispatcher.cpp)
target_link_libraries(game_service PUBLIC game_core)
add_library(game_browser_bridge ${GAME_SOURCE_DIR}/src/browser/Bridge.cpp ${GAME_SOURCE_DIR}/src/browser/Model.cpp)
target_link_libraries(game_browser_bridge PUBLIC game_service)
if(BUILD_TESTING)
  add_executable(game-particles3d-tests ${GAME_SOURCE_DIR}/tests/Particles3DTest.cpp)
  target_link_libraries(game-particles3d-tests PRIVATE game_core)
  add_test(NAME native-game-particles3d COMMAND game-particles3d-tests)
  set_tests_properties(native-game-particles3d PROPERTIES LABELS "core;visual")
endif()
