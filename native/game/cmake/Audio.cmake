add_library(game_audio src/audio/Audio.cpp src/audio/AudioDevice.cpp)
target_include_directories(game_audio PUBLIC src)
target_include_directories(game_audio SYSTEM PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../timeline/third_party")
target_link_libraries(game_audio PUBLIC nlohmann_json::nlohmann_json PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
if(APPLE)
  target_link_libraries(game_audio PRIVATE "-framework CoreAudio" "-framework AudioToolbox" "-framework CoreFoundation")
endif()
if(BUILD_TESTING)
  add_executable(game-audio-tests tests/AudioTest.cpp)
  target_link_libraries(game-audio-tests PRIVATE game_audio)
  add_test(NAME native-game-audio COMMAND game-audio-tests)
endif()
if(TARGET game_assets)
  add_library(game_player_audio src/player/PlayerAudio.cpp)
  target_include_directories(game_player_audio PUBLIC src)
  target_link_libraries(game_player_audio PUBLIC game_audio game_assets)
  if(BUILD_TESTING)
    add_executable(game-player-audio-tests tests/PlayerAudioTest.cpp)
    target_link_libraries(game-player-audio-tests PRIVATE game_player_audio)
    add_test(NAME native-game-player-audio COMMAND game-player-audio-tests)
  endif()
endif()
