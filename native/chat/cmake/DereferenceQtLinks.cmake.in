# Homebrew's merged Qt prefix contains relative links into its Cellar. Qt's
# deploy helper copies those links, which are invalid inside an app bundle.
set(bundle "${CMAKE_INSTALL_PREFIX}/nodetool-chat.app/Contents")
set(qml_source "@CHAT_QT_QML_DIR@")
file(GLOB_RECURSE deployed_qml LIST_DIRECTORIES FALSE "${bundle}/Resources/qml/*")
foreach(file IN LISTS deployed_qml)
    if(IS_SYMLINK "${file}")
        file(RELATIVE_PATH relative "${bundle}/Resources/qml" "${file}")
        file(REAL_PATH "${qml_source}/${relative}" source)
        if(NOT EXISTS "${source}")
            message(FATAL_ERROR "Missing deployed QML source for ${relative}")
        endif()
        file(REMOVE "${file}")
        file(COPY_FILE "${source}" "${file}")
    endif()
endforeach()
file(GLOB_RECURSE source_plugins LIST_DIRECTORIES FALSE "${qml_source}/*.dylib")
file(GLOB deployed_plugins LIST_DIRECTORIES FALSE "${bundle}/PlugIns/*.dylib")
foreach(file IN LISTS deployed_plugins)
    if(IS_SYMLINK "${file}")
        get_filename_component(name "${file}" NAME)
        set(found "")
        foreach(candidate IN LISTS source_plugins)
            get_filename_component(candidate_name "${candidate}" NAME)
            if(candidate_name STREQUAL name)
                file(REAL_PATH "${candidate}" found)
                break()
            endif()
        endforeach()
        if(NOT EXISTS "${found}")
            message(FATAL_ERROR "Missing deployed plugin source for ${name}")
        endif()
        file(REMOVE "${file}")
        file(COPY_FILE "${found}" "${file}")
    endif()
endforeach()
