{
  "name": "nodetool-chrome-extension",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Nodetool Chrome extension (MV3): a side-panel chat UI for a Nodetool server, plus a thin CDP relay between the user's logged-in Chrome and that server's live browser agent.",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.0",
    "msgpackr": "1.12.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
