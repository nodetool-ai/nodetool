    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/plotly.js": "^3.0.15",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tabulator-tables": "^6.3.6",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "browserslist-to-esbuild": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "mock-socket": "^9.3.1",
    "storybook": "^10.6.1",
    "ts-jest": "^29.4.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^4.5.0"
  }
}
