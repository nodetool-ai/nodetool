  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort --clearScreen false",
    "dev:fast": "npm run dev",
    "start": "npm run dev",
    "prebuild": "node scripts/ensure-packages-built.mjs",
    "build": "vite build",
    "prebuild:staging": "node scripts/ensure-packages-built.mjs",
    "build:staging": "vite build --mode staging",
    "prebuild:debug": "node scripts/ensure-packages-built.mjs",
    "build:debug": "NODE_OPTIONS=--max-old-space-size=16384 vite build --mode debug --sourcemap --minify false",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "lint:eslint": "eslint src",
    "lint:eslint:fix": "eslint src --fix",
    "lint:design": "eslint --config eslint.design.config.mjs src && node scripts/test-motion-rule.mjs && node scripts/test-media-src-rule.mjs && node scripts/lint-spacing-css.mjs && node scripts/lint-font-color-css.mjs && node scripts/lint-radius-css.mjs && node scripts/lint-motion-css.mjs",
    "lint:design:fix": "eslint --config eslint.design.config.mjs src --fix && node scripts/test-motion-rule.mjs && node scripts/test-media-src-rule.mjs && node scripts/test-media-src-rule.mjs && node scripts/lint-spacing-css.mjs && node scripts/lint-font-color-css.mjs && node scripts/lint-radius-css.mjs && node scripts/lint-motion-css.mjs",
    "check": "node ../scripts/run-tsc.mjs && eslint src && jest",
    "test": "node ../scripts/run-jest-utc.mjs --forceExit",
    "test:summary": "node ../scripts/run-jest-utc.mjs --reporters=\"summary\" --forceExit",
    "test:watch": "node ../scripts/run-jest-utc.mjs --watch",
    "test:coverage": "node ../scripts/run-jest-utc.mjs --coverage --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e-runner": "playwright test -c playwright.e2e-runner.config.ts",
    "test:e2e-runner:headed": "playwright test -c playwright.e2e-runner.config.ts --headed",
    "test:benchmark": "playwright test -c playwright.benchmark.config.ts",
    "test:benchmark:editor": "playwright test -c playwright.editor-benchmark.config.ts",
    "test:benchmark:chat-history": "playwright test -c playwright.benchmark.config.ts tests/benchmarks/chat-history-scroll.spec.ts",
    "test:debug-harness": "playwright test -c playwright.debug-harness.config.ts",
    "e2e-suite:prepare": "tsx tests/e2e-runner/prepareSuite.ts",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:journeys": "playwright test -c playwright.journeys.config.ts",
    "test:journeys:headed": "playwright test -c playwright.journeys.config.ts --headed",
    "test:journeys:ui": "playwright test -c playwright.journeys.config.ts --ui",
    "test:agentic-qa": "tsx --test tests/agentic-qa/originGuard.test.ts",
    "typecheck:journeys": "node ../scripts/run-tsc.mjs --noEmit -p tsconfig.journeys.json",
    "typecheck:smoke": "node ../scripts/run-tsc.mjs --noEmit -p tsconfig.smoke.json",
    "typecheck:playwright": "node ../scripts/run-tsc.mjs --noEmit -p tsconfig.playwright.json",
    "typecheck": "node ../scripts/run-tsc.mjs --noEmit",
    "upload-stock-images": "node scripts/upload-stock-images.js",
    "chat-shots": "node scripts/build-chat-cast-assets.mjs && node scripts/screenshot-chat-casts.mjs",
    "storyboard-stills": "node scripts/build-storyboard-cast-stills.mjs",
    "project-shots": "node scripts/build-project-shots.mjs",
    "project-shots:check": "node scripts/build-project-shots.mjs --check",
    "screenshots": "playwright test tests/benchmarks/screenshots.spec.ts --project=chromium",
    "screenshots:force": "FORCE_SCREENSHOTS=true playwright test tests/benchmarks/screenshots.spec.ts --project=chromium",
    "lint:spacing-css": "node scripts/lint-spacing-css.mjs",
    "lint:font-color-css": "node scripts/lint-font-color-css.mjs",
    "lint:radius-css": "node scripts/lint-radius-css.mjs",
    "lint:motion-css": "node scripts/lint-motion-css.mjs",
    "lint:motion-rule": "node scripts/test-motion-rule.mjs",
    "lint:media-src-rule": "node scripts/test-media-src-rule.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "timeline-fonts": "node scripts/generate-timeline-fonts-css.mjs",
    "timeline-fonts:check": "node scripts/generate-timeline-fonts-css.mjs --check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "rollup": "^4.61.0",
    "minimatch": ">=3.1.4",
    "flatted": ">=3.4.2",
    "ajv": ">=6.14.0"
  },
  "devDependencies": {
