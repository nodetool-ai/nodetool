{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "oxc"],
  "jsPlugins": ["./tools/oxlint/keyboard.ts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-unused-vars": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "no-unsafe-optional-chaining": "warn",
    "react/jsx-key": "warn",
    "typescript/no-unnecessary-parameter-property-assignment": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "keyboard/no-window-key-listener": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "jest.config.ts",
    "vite.config.ts",
    "vitest.*.config.ts",
    "playwright.config.ts",
    "**/*.d.ts",
    "src/api.ts"
  ],
  "overrides": [
    {
      "files": [
        "**/__tests__/**/*.{ts,tsx}",
        "**/__mocks__/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "src/setupTests.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["src/stores/KeyPressedStore.ts", "src/hooks/useKeyPressed*.ts"],
      "rules": {
        "keyboard/no-window-key-listener": "off"
      }
    },
    {
      "files": ["src/components/node/PropertyInput.types.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
