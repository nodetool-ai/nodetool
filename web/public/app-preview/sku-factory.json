{
  "slug": "sku-factory",
  "name": "SKU Factory",
  "emoji": "🏷️",
  "description": "The E-commerce SKU Visual Factory chain behind one surface. Drop a product photo once and the cutout, the studio scene, the seasonal relight and the listing copy all read the same image; motion and print resolution stay on their own buttons because they cost more.",
  "tagline": "One packshot in, the whole channel set out.",
  "note": "🔑 Needs a FAL key for the image steps and an OpenAI key for the listing. The turntable is a video model and is metered per second.",
  "featured": false,
  "image": "/app-preview/img/sku-factory.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🏷️ SKU Factory",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "One packshot in, the whole channel set out."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs a FAL key for the image steps and an OpenAI key for the listing. The turntable is a video model and is metered per second."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-the-still-set",
