{
  "slug": "viral-ad-engine",
  "name": "Viral Ad Engine",
  "emoji": "📈",
  "description": "The Viral Video Ad Engine chain behind one surface. The offer drives both the copy registers and the hook-and-thumbnail set, so the line you pick and the thumbnails you test come from the same brief.",
  "tagline": "Settle the line, fan it into a test set, then put the product in motion.",
  "note": "🔑 Needs an OpenAI key for the writing and a FAL key for the thumbnails. The ad loop is a video model; the vertical cut runs locally.",
  "featured": false,
  "image": "/app-preview/img/viral-ad-engine.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "📈 Viral Ad Engine",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Settle the line, fan it into a test set, then put the product in motion."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs an OpenAI key for the writing and a FAL key for the thumbnails. The ad loop is a video model; the vertical cut runs locally."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-the-line",
            "gap": 24,
            "left": [
