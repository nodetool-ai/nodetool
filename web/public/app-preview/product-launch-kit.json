{
  "slug": "product-launch-kit",
  "name": "Product Launch Kit",
  "emoji": "📦",
  "description": "Stage a product photo into lifestyle mockups, then — deliberately, because it costs real money — turn the same photo into a launch video.",
  "tagline": "One product photo in, mockups and a launch video out.",
  "note": "💸 Mockups and launch video use configured cloud models. Video generation is billed per run, so it has its own button.",
  "featured": false,
  "image": "/app-preview/img/product-launch-kit.jpg",
  "app": {
    "schemaVersion": 3,
