          "props": {
            "id": "title",
            "text": "📦 Product Launch Kit",
            "level": "1",
            "subtitle": "One product photo in, mockups and a launch video out."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "💸 Mockups and launch video use configured cloud models. Video generation is billed per run, so it has its own button.",
