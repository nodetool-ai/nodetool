                              "modelKind": "language_model",
                              "events": []
                            }
                          },
                          {
                            "type": "ModelSelect",
                            "props": {
                              "id": "model-mockups-8-model",
                              "binding": "op:mockups/prop:8#model",
                              "label": "Scene concept agent model",
                              "modelKind": "language_model",
                              "events": []
                            }
                          },
                          {
                            "type": "ModelSelect",
                            "props": {
                              "id": "model-mockups-15-model",
                              "binding": "op:mockups/prop:15#model",
                              "label": "Render scene model",
                              "modelKind": "image_model",
                              "events": []
