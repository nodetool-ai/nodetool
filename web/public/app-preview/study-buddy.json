{
  "slug": "study-buddy",
  "name": "Study Buddy",
  "emoji": "🃏",
  "description": "Structured data an app renders better than a graph does: the cards land in a table, the explanation beside them.",
  "tagline": "A deck of flashcards and the concept behind it, side by side.",
  "note": "🔑 Needs an OpenAI key. Your topic persists between sessions.",
  "featured": false,
  "image": "/app-preview/img/study-buddy.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🃏 Study Buddy",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "A deck of flashcards and the concept behind it, side by side."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs an OpenAI key. Your topic persists between sessions."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-your-deck",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-your-deck",
                  "title": "Your deck",
                  "content": [
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-topic",
                        "binding": "var:topic",
                        "label": "Study topic",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "NumberInput",
                      "props": {
                        "id": "in-cards-num-cards",
                        "binding": "op:cards/in:num_cards_input",
                        "label": "How many cards?",
                        "min": 3,
                        "max": 30,
                        "events": []
                      }
                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "in-explain-audience",
                        "binding": "op:explain/in:input_audience",
                        "label": "Explain it to…",
                        "options": [
                          {
                            "value": "a curious 10-year-old"
                          },
                          {
                            "value": "a new teammate"
                          },
                          {
                            "value": "an expert"
                          },
                          {
                            "value": "someone in a hurry"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-cards",
                        "label": "Make flashcards",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "cards",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-explain",
                        "label": "Explain the concept",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "explain",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-your-deck-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-cards",
                        "binding": "op:cards/exec#progress",
                        "label": "Writing cards…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-cards-flashcards",
                        "text": "Flashcards",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Table",
                      "props": {
                        "id": "out-cards-flashcards",
                        "binding": "op:cards/out:flashcards_output"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-explain-explanation",
                        "text": "The concept behind this deck",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-explain-explanation",
                        "binding": "op:explain/out:explanation_output",
                        "text": ""
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
        "id": "cards",
        "name": "Cards",
        "workflowId": "cards",
        "inputs": {
          "topic_input": {
            "from": "variable",
            "variableId": "topic"
          }
        },
        "outputs": {},
        "policy": "replace"
      },
      {
        "id": "explain",
        "name": "Explain",
        "workflowId": "explain",
        "inputs": {
          "input_topic": {
            "from": "variable",
            "variableId": "topic"
          }
        },
        "outputs": {},
        "policy": "replace"
      }
    ],
    "resources": [],
