{
  "slug": "trailer-room",
  "name": "Trailer Room",
  "emoji": "🎞️",
  "description": "The Storyboard to Trailer chain behind one surface. Rewrite the beat sheet and the shot list while they still cost one text call each, then spend once on the footage and lay a score under the cut.",
  "tagline": "Premise to beat sheet to shot list to a scored teaser, on one page.",
  "note": "💸 Beats and shots are text calls. Shoot spends on a per-second video model and Score on one audio generation.",
  "featured": false,
  "image": "/app-preview/img/trailer-room.jpg",
  "app": {
