{
  "slug": "upscale-image",
  "name": "Upscale Image",
  "emoji": "🔍",
  "description": "Two upscalers behind one drop zone. ESRGAN reconstructs the detail that is there, which is what you want for a photo. Clarity invents plausible detail, which is what you want when the source is small.",
  "tagline": "Enlarge an image without the softness of a plain resize.",
  "note": "🔑 Needs a FAL key. One call per upscale.",
  "featured": false,
  "image": "/app-preview/img/upscale-image.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🔍 Upscale Image",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Enlarge an image without the softness of a plain resize."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs a FAL key. One call per upscale."
          }
        },
        {
          "type": "Container",
          "props": {
            "id": "panel-your-image",
            "title": "Your image",
            "content": [
              {
                "type": "ImageInput",
                "props": {
                  "id": "in-picture",
                  "binding": "var:picture",
                  "label": "The image to enlarge",
                  "events": []
                }
              }
            ]
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-faithful",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-faithful",
                  "title": "Faithful",
                  "content": [
                    {
                      "type": "Slider",
                      "props": {
                        "id": "slider-faithful-up-scale",
                        "binding": "op:faithful/prop:up#scale",
                        "label": "Scale",
                        "min": 2,
                        "max": 4,
                        "step": 1,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-faithful",
                        "label": "Upscale (ESRGAN)",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "faithful",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-faithful-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-faithful",
                        "binding": "op:faithful/exec#progress",
                        "label": "Reconstructing detail…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-faithful-enlarged",
                        "text": "Enlarged",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-faithful-enlarged",
                        "binding": "op:faithful/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-clarity",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-clarity",
                  "title": "Clarity",
                  "content": [
                    {
                      "type": "Slider",
                      "props": {
                        "id": "slider-clarity-up-scale",
                        "binding": "op:clarity/prop:up#scale",
                        "label": "Scale",
                        "min": 2,
                        "max": 4,
                        "step": 1,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-clarity",
                        "label": "Upscale (Clarity)",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "clarity",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-clarity-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-clarity",
                        "binding": "op:clarity/exec#progress",
                        "label": "Adding detail…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-clarity-print-ready",
                        "text": "Print-ready",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-clarity-print-ready",
                        "binding": "op:clarity/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
        "id": "faithful",
        "name": "Faithful",
        "workflowId": "faithful",
        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "picture"
          }
        },
        "outputs": {},
        "policy": "replace"
      },
      {
        "id": "clarity",
        "name": "Clarity",
        "workflowId": "clarity",
        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "picture"
          }
        },
        "outputs": {},
        "policy": "replace"
      }
    ],
    "resources": [],
    "variables": [
      {
        "id": "picture",
        "name": "Your image",
        "type": {
          "type": "image",
          "optional": true
        },
        "scope": "instance",
        "persist": false
      }
    ]
  },
