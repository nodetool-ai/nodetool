{
  "slug": "product-shot-video",
  "name": "Product Shot Video",
  "emoji": "🎥",
  "description": "Keep the product reference fixed and choose one camera move for a looping ad or a turntable clip for the product page.",
  "tagline": "Turn a product photo into a controlled moving shot.",
  "note": "Choose an ad loop or turntable model. Review the motion before exporting the shot.",
  "featured": true,
  "image": "/app-preview/img/product-shot-video.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "Product Shot Video",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Turn a product photo into a controlled moving shot."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "Choose an ad loop or turntable model. Review the motion before exporting the shot."
          }
        },
        {
          "type": "Container",
          "props": {
            "id": "panel-your-product",
            "title": "Your product",
            "content": [
              {
                "type": "ImageInput",
                "props": {
                  "id": "in-productphoto",
                  "binding": "var:productPhoto",
                  "label": "A clean product photo",
                  "events": []
                }
              }
            ]
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-make-a-hero-loop",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-make-a-hero-loop",
                  "title": "Make a hero loop",
                  "content": [
                    {
                      "type": "ModelSelect",
                      "props": {
                        "id": "model-loop-animate-model",
                        "binding": "op:loop/prop:animate#model",
                        "label": "Video model",
                        "modelKind": "video_model",
                        "task": "image_to_video",
                        "events": []
                      }
                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "in-loop-motion",
                        "binding": "op:loop/in:in-motion",
                        "label": "Camera move",
                        "options": [
                          {
                            "value": "Slow orbit around the product as a soft highlight travels across its surface"
                          },
                          {
                            "value": "Slow push in toward the product as the background falls out of focus"
                          },
                          {
                            "value": "Gentle dolly from left to right, product fixed, light sweeping across"
                          },
                          {
                            "value": "Rise from a low angle to eye level, product centered, soft reflections"
                          },
                          {
                            "value": "Hold still while steam and light drift around the product"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-loop",
                        "label": "Render the hero loop",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "loop",
                            "key": "",
                            "value": ""
                          }
                        ],
                        "disabledWhen": {
                          "binding": "op:loop/exec#running",
                          "op": "notEmpty"
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-make-a-hero-loop-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-loop",
                        "binding": "op:loop/exec#progress",
                        "label": "Animating…"
                      }
                    },
                    {
                      "type": "Alert",
                      "props": {
                        "id": "error-loop",
                        "binding": "op:loop/exec#error",
                        "title": "The hero loop failed",
                        "text": "",
                        "severity": "error",
                        "visibleWhen": {
                          "binding": "op:loop/exec#error",
                          "op": "notEmpty"
                        }
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "id": "note",
                        "text": "Check the first and last frame for a clean loop and stable product geometry."
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-loop-ad-loop",
                        "text": "Rendered hero loop",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-loop-ad-loop",
                        "binding": "op:loop/out:output-loop",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-make-a-turntable",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-make-a-turntable",
                  "title": "Make a turntable",
                  "content": [
                    {
                      "type": "ModelSelect",
                      "props": {
                        "id": "model-turntable-v-model",
                        "binding": "op:turntable/prop:v#model",
                        "label": "Video model",
                        "modelKind": "video_model",
                        "task": "image_to_video",
                        "events": []
                      }
                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "select-turntable-v-prompt",
                        "binding": "op:turntable/prop:v#prompt",
                        "label": "Turntable direction",
                        "options": [
                          {
                            "value": "slow orbit around the product, fixed lighting, product stays centered"
                          },
                          {
                            "value": "full 360 degree turntable rotation, product centered, studio lighting fixed"
                          },
                          {
                            "value": "slow half turn revealing the back of the product, fixed lighting"
                          },
                          {
                            "value": "gentle rocking turn, product centered, soft studio light"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-turntable",
                        "label": "Render the turntable",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "turntable",
                            "key": "",
                            "value": ""
                          }
                        ],
                        "disabledWhen": {
                          "binding": "op:turntable/exec#running",
                          "op": "notEmpty"
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-make-a-turntable-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-turntable",
                        "binding": "op:turntable/exec#progress",
                        "label": "Rendering the turntable…"
                      }
                    },
                    {
                      "type": "Alert",
                      "props": {
                        "id": "error-turntable",
                        "binding": "op:turntable/exec#error",
                        "title": "The turntable failed",
                        "text": "",
                        "severity": "error",
                        "visibleWhen": {
                          "binding": "op:turntable/exec#error",
                          "op": "notEmpty"
                        }
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "id": "note-2",
                        "text": "Use the turntable when the product page needs a clear view around the packshot."
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-turntable-turntable",
                        "text": "Rendered turntable",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-turntable-turntable",
                        "binding": "op:turntable/out:out",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
        "id": "loop",
        "name": "Ad loop",
        "workflowId": "loop",
        "inputs": {
          "in-photo": {
            "from": "variable",
            "variableId": "productPhoto"
          }
        },
        "outputs": {},
        "policy": "replace"
      },
      {
        "id": "turntable",
        "name": "Turntable",
        "workflowId": "turntable",
        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "productPhoto"
          }
        },
        "outputs": {},
        "policy": "replace"
      }
    ],
    "resources": [],
    "variables": [
      {
        "id": "productPhoto",
        "name": "Product photo",
        "type": {
          "type": "image",
          "optional": true
        },
        "scope": "instance",
        "persist": false
      }
    ]
  },
