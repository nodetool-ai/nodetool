{
  "slug": "shot-director",
  "name": "Shot Director",
  "emoji": "🎬",
  "description": "Turn one still into a cinematic take with an open camera preset, rendered on Comfy Cloud with a pinned Wan 2.2 workflow. Revise into Take B without losing Take A, compare them side by side, and open the workflow behind both.",
  "tagline": "Pick a camera move, direct the shot, keep every take.",
  "note": "Renders on Comfy Cloud and needs `COMFY_API_KEY`. Comfy Cloud bills GPU time on your plan.",
  "featured": true,
  "image": null,
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🎬 Shot Director",
            "level": "1",
            "subtitle": "Pick a camera move, direct the shot, keep every take."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "Renders on Comfy Cloud and needs `COMFY_API_KEY`. Comfy Cloud bills GPU time on your plan.",
            "tone": "hint"
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-take-a",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-take-a",
                  "title": "Take A",
                  "content": [
                    {
                      "type": "ImageInput",
                      "props": {
                        "id": "in-sourceimage",
                        "binding": "var:sourceImage",
                        "label": "Source still",
                        "events": []
                      }
                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "in-takea-camera-move",
                        "binding": "op:takeA/in:camera_move",
                        "label": "Camera move",
                        "options": [
                          {
                            "value": "dolly in"
                          },
                          {
                            "value": "orbit"
                          },
                          {
                            "value": "crane up"
                          },
                          {
                            "value": "pull back reveal"
                          },
                          {
                            "value": "handheld"
                          },
                          {
                            "value": "static"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-takea-direction",
                        "binding": "op:takeA/in:direction",
                        "label": "Direction",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "NumberInput",
                      "props": {
                        "id": "in-takea-seed",
                        "binding": "op:takeA/in:seed",
                        "label": "Seed",
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-takea",
                        "label": "Generate Take A",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "takeA",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-take-a-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-takea",
                        "binding": "op:takeA/exec#progress",
                        "label": "Rendering on Comfy Cloud (about 1 to 3 minutes)…"
                      }
                    },
                    {
                      "type": "Alert",
                      "props": {
                        "id": "error-takea",
                        "binding": "op:takeA/exec#error",
                        "title": "Generation failed",
                        "text": "",
                        "severity": "error",
                        "visibleWhen": {
                          "binding": "op:takeA/exec#error",
                          "op": "notEmpty"
                        }
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-takea-take",
                        "text": "Take A",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-takea-take",
                        "binding": "op:takeA/out:take",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-takea-run-settings",
                        "text": "Run settings",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-takea-run-settings",
                        "binding": "op:takeA/out:settings",
                        "text": ""
                      }
                    }
                  ]
                }
              }
            ]
