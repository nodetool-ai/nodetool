{
  "slug": "ask-your-documents",
  "name": "Ask Your Documents",
  "emoji": "📄",
  "description": "Retrieval-augmented answers with citations, and a fully local fallback that reads one pasted document instead of the vector store.",
  "tagline": "Ask your own documents — with a local mode that never leaves your machine.",
  "note": "🖥️ The retrieval mode embeds with Ollama `nomic-embed-text` and answers with OpenAI, so it needs **both**. Local mode needs only Ollama.",
  "featured": false,
  "image": "/app-preview/img/ask-your-documents.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "📄 Ask Your Documents",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Ask your own documents — with a local mode that never leaves your machine."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🖥️ The retrieval mode embeds with Ollama `nomic-embed-text` and answers with OpenAI, so it needs **both**. Local mode needs only Ollama."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-ask",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-ask",
                  "title": "Ask",
                  "content": [
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-question",
                        "binding": "var:question",
                        "label": "Your question",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "Switch",
                      "props": {
                        "id": "in-localonly",
                        "binding": "var:localOnly",
                        "label": "Local only (no cloud)",
                        "events": []
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-ask-search",
                        "binding": "op:ask/in:search_input",
                        "label": "Search keyword",
                        "multiline": false,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-ask",
                        "label": "Search my documents",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "ask",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-pasteddoc",
                        "binding": "var:pastedDoc",
                        "label": "Or paste one document",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "in-asklocal-tone",
                        "binding": "op:askLocal/in:tone_input",
                        "label": "Answer tone",
                        "options": [
                          {
                            "value": "concise and neutral"
                          },
                          {
                            "value": "friendly and warm"
                          },
                          {
                            "value": "professional"
                          },
                          {
                            "value": "detailed and thorough"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-asklocal",
                        "label": "Ask locally",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "askLocal",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-ask-results",
