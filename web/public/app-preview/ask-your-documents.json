                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-ask",
                        "binding": "op:ask/exec#progress",
                        "label": "Searching your knowledge base…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-ask-answer",
                        "text": "Answer",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-ask-answer",
                        "binding": "op:ask/out:answer_output",
                        "text": ""
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-ask-retrieved-passages",
                        "text": "Sources used",
                        "level": "3"
