                  "events": []
                }
              },
              {
                "type": "TextInput",
                "props": {
                  "id": "in-ask-doc-warranty",
                  "binding": "op:ask/in:doc_warranty",
                  "label": "Document: warranty",
                  "multiline": true,
                  "events": []
                }
              }
            ]
          }
        }
