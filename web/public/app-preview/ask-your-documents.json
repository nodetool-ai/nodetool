                        "label": "Thinking locally…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-asklocal-answer",
                        "text": "Local answer",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-asklocal-answer",
                        "binding": "op:askLocal/out:output-answer",
                        "text": ""
                      }
                    }
                  ]
                }
              }
            ]
