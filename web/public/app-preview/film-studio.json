{
  "slug": "film-studio",
  "name": "Film Studio",
  "emoji": "🎬",
  "description": "The showcase run: one brief drives a directed short, an editable rough cut, and the poster that sells it.",
  "tagline": "Brief → direction → storyboard → cut → key art.",
  "note": "💸 This app spends real money — Veo 3.1 video and Replicate MusicGen. Run it once, deliberately.",
  "featured": true,
  "image": "/app-preview/img/film-studio.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🎬 Film Studio",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Brief → direction → storyboard → cut → key art."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "💸 This app spends real money — Veo 3.1 video and Replicate MusicGen. Run it once, deliberately."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-the-film",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-the-film",
                  "title": "The film",
                  "content": [
                    {
                      "type": "Text",
                      "props": {
                        "id": "note",
                        "text": "💸 Each run of Produce or Rough cut uses Veo and Replicate credits."
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-brief",
                        "binding": "var:brief",
                        "label": "Your film in one line",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-style",
                        "binding": "var:style",
                        "label": "Visual style",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-produce-shot-count",
                        "binding": "op:produce/in:shot_count",
                        "label": "Number of shots",
                        "multiline": false,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-produce",
                        "label": "Shoot my film",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "produce",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-cut",
                        "label": "Give me the rough cut",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "cut",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-the-film-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-produce",
                        "binding": "op:produce/exec#progress",
                        "label": "Directing, storyboarding & shooting…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-produce-direction",
                        "text": "Direction document",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-produce-direction",
                        "binding": "op:produce/out:direction_out",
                        "text": ""
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-produce-storyboard",
                        "text": "Storyboard keyframes",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-produce-storyboard",
                        "binding": "op:produce/out:storyboard_out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-produce-film",
                        "text": "Finished film",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-produce-film",
                        "binding": "op:produce/out:film_out",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    },
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-cut",
                        "binding": "op:cut/exec#progress",
                        "label": "Cutting the timeline…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-cut-film",
                        "text": "Editable rough cut",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-cut-film",
                        "binding": "op:cut/out:film_out",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    }
                  ]
                }
              }
            ]
