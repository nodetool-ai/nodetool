{
  "slug": "product-reshoot",
  "name": "Product Reshoot",
  "emoji": "📦",
  "description": "Start with one product photo and make three production-ready passes: a new set, a seasonal relight, or a clean cutout for compositing.",
  "tagline": "Relight the product. Change the set. Keep the product fixed.",
  "note": "Choose a treatment, review the result, then reuse the same product reference for another pass.",
  "featured": true,
  "image": "/app-preview/img/product-reshoot.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "Product Reshoot",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Relight the product. Change the set. Keep the product fixed."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "Choose a treatment, review the result, then reuse the same product reference for another pass."
          }
