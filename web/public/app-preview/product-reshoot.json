                        "options": [
                          {
                            "value": "Keep the product as it is. Change only what is around it: warm concrete plinth, soft studio key from upper left, blurred background."
                          },
                          {
                            "value": "Keep the product as it is. Change only what is around it: white marble surface, bright daylight from a window, soft shadow."
                          },
                          {
                            "value": "Keep the product as it is. Change only what is around it: dark slate table, single hard spotlight, deep black background."
                          },
                          {
                            "value": "Keep the product as it is. Change only what is around it: pale oak shelf, morning light, out-of-focus plants behind."
                          },
                          {
                            "value": "Keep the product as it is. Change only what is around it: wet black rock at the shoreline, overcast sky, sea spray."
                          }
