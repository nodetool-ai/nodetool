        "scope": "user",
        "persist": true
      },
      {
        "id": "visualBrief",
        "name": "Visual brief",
        "type": {
          "type": "str",
          "optional": true
        },
        "default": "Olive Travel Cup on a pale limestone cafe counter at warm sunrise. Editorial 50mm product photography, restrained sage, charcoal, and cream palette, clean negative space on the upper left, no text in the image.",
        "scope": "instance",
        "persist": false
      }
    ]
  },
