{
  "slug": "ad-maker",
  "name": "Ad Maker",
  "emoji": "📣",
  "description": "Start with one offer, compare copy routes and headline angles, then direct a campaign hero with the approved message beside the visual brief.",
  "tagline": "Settle the message. Direct the campaign image.",
  "note": "The hero render only runs after you approve the visual brief.",
  "featured": true,
  "image": "/app-preview/img/ad-maker.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "Ad Maker",
            "level": "1",
            "subtitle": "Settle the message. Direct the campaign image."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "The hero render only runs after you approve the visual brief.",
            "tone": "hint"
          }
        },
        {
          "type": "Stepper",
          "props": {
            "id": "steps",
            "binding": "var:step",
            "steps": [
              {
                "value": "settle-the-message",
                "title": "Settle the message"
              },
              {
                "value": "direct-the-campaign-image",
                "title": "Direct the campaign image"
              }
            ],
            "allowBack": true
          }
        },
        {
          "type": "Container",
          "props": {
            "id": "step-settle-the-message",
            "variant": "plain",
            "visibleWhen": {
              "binding": "var:step",
              "op": "eq",
              "value": "settle-the-message"
            },
            "content": [
              {
                "type": "Heading",
                "props": {
                  "id": "heading-settle-the-message",
                  "text": "Settle the message",
                  "level": "2"
                }
              },
              {
                "type": "Columns",
                "props": {
                  "id": "cols-settle-the-message",
                  "gap": 24,
                  "left": [
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-offer",
                        "binding": "var:offer",
                        "label": "Offer or product brief",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "ModelSelect",
                      "props": {
                        "id": "model-copy-ag-model",
                        "binding": "op:copy/prop:ag#model",
                        "label": "Writing model",
                        "modelKind": "language_model",
                        "events": []
                      }
                    },
                    {
                      "type": "ModelSelect",
                      "props": {
                        "id": "model-headlines-ag-model",
                        "binding": "op:headlines/prop:ag#model",
                        "label": "Headline model",
                        "modelKind": "language_model",
                        "events": []
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "id": "note",
                        "text": "Start with the cheap decision point. Compare the writing before generating an image."
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-copy-headlines",
                        "label": "Write the routes",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "copy",
                            "key": "",
                            "value": ""
                          },
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "headlines",
                            "key": "",
                            "value": ""
                          }
                        ],
                        "disabledWhen": {
                          "binding": "op:copy/exec#running",
                          "op": "notEmpty"
                        }
                      }
                    }
                  ],
                  "right": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-copy",
                        "binding": "op:copy/exec#progress",
                        "label": "Writing three registers…"
                      }
                    },
                    {
                      "type": "Alert",
                      "props": {
                        "id": "error-copy",
                        "binding": "op:copy/exec#error",
                        "title": "The copy routes failed",
                        "text": "",
                        "severity": "error",
                        "visibleWhen": {
                          "binding": "op:copy/exec#error",
                          "op": "notEmpty"
                        }
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-copy-variants",
                        "text": "Three copy routes",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-copy-variants",
                        "binding": "op:copy/out:out",
                        "text": ""
                      }
                    },
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-headlines",
                        "binding": "op:headlines/exec#progress",
                        "label": "Testing five angles…"
                      }
                    },
                    {
                      "type": "Alert",
                      "props": {
                        "id": "error-headlines",
                        "binding": "op:headlines/exec#error",
                        "title": "The headline angles failed",
                        "text": "",
                        "severity": "error",
                        "visibleWhen": {
                          "binding": "op:headlines/exec#error",
                          "op": "notEmpty"
                        }
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-headlines-headlines",
                        "text": "Five headline angles",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-headlines-headlines",
                        "binding": "op:headlines/out:out",
                        "text": ""
                      }
                    }
                  ]
                }
              },
              {
                "type": "Divider",
                "props": {
                  "id": "divider-settle-the-message"
                }
              },
              {
                "type": "Columns",
                "props": {
                  "id": "nav-settle-the-message",
                  "gap": 16,
                  "left": [],
                  "right": [
                    {
                      "type": "Button",
                      "props": {
                        "id": "next-settle-the-message",
                        "label": "Next: Direct the campaign image",
                        "variant": "contained",
                        "color": "primary",
                        "fullWidth": false,
                        "align": "end",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "setVariable",
                            "key": "var:step",
                            "value": "direct-the-campaign-image"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Container",
          "props": {
            "id": "step-direct-the-campaign-image",
            "variant": "plain",
            "visibleWhen": {
              "binding": "var:step",
              "op": "eq",
              "value": "direct-the-campaign-image"
            },
            "content": [
              {
                "type": "Heading",
                "props": {
                  "id": "heading-direct-the-campaign-image",
                  "text": "Direct the campaign image",
                  "level": "2"
                }
              },
              {
                "type": "Columns",
                "props": {
                  "id": "cols-direct-the-campaign-image",
                  "gap": 24,
                  "left": [
                    {
                      "type": "ModelSelect",
                      "props": {
                        "id": "model-visual-ag-model",
                        "binding": "op:visual/prop:ag#model",
                        "label": "Prompt-writing model",
                        "modelKind": "language_model",
                        "events": []
                      }
                    },
                    {
                      "type": "ModelSelect",
                      "props": {
                        "id": "model-visual-gen-model",
                        "binding": "op:visual/prop:gen#model",
                        "label": "Image model",
                        "modelKind": "image_model",
                        "task": "text_to_image",
                        "events": []
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "id": "note-2",
                        "text": "Carry the approved promise into the scene. State what the product is doing, where it sits, and what must not appear."
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-visualbrief",
                        "binding": "var:visualBrief",
                        "label": "Visual brief",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-visual",
                        "label": "Render the campaign hero",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "visual",
                            "key": "",
                            "value": ""
                          }
                        ],
                        "disabledWhen": {
                          "binding": "op:visual/exec#running",
                          "op": "notEmpty"
                        }
                      }
                    }
                  ],
                  "right": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-visual",
                        "binding": "op:visual/exec#progress",
                        "label": "Writing the prompt and rendering…"
                      }
                    },
                    {
                      "type": "Alert",
                      "props": {
                        "id": "error-visual",
                        "binding": "op:visual/exec#error",
                        "title": "The campaign hero failed",
                        "text": "",
                        "severity": "error",
                        "visibleWhen": {
                          "binding": "op:visual/exec#error",
                          "op": "notEmpty"
                        }
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-visual-prompt-used",
                        "text": "Prompt sent to the image model",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-visual-prompt-used",
                        "binding": "op:visual/out:op",
                        "text": ""
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-visual-image",
                        "text": "Campaign hero",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-visual-image",
                        "binding": "op:visual/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    }
                  ]
                }
              },
              {
                "type": "Divider",
                "props": {
                  "id": "divider-direct-the-campaign-image"
                }
              },
              {
                "type": "Columns",
                "props": {
                  "id": "nav-direct-the-campaign-image",
                  "gap": 16,
                  "left": [
                    {
                      "type": "Button",
                      "props": {
                        "id": "back-direct-the-campaign-image",
                        "label": "Back: Settle the message",
                        "variant": "outlined",
                        "fullWidth": false,
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "setVariable",
                            "key": "var:step",
                            "value": "settle-the-message"
                          }
                        ]
                      }
                    }
                  ],
                  "right": []
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
