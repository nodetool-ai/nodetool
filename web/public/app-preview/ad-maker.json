        "type": {
          "type": "str",
          "optional": true
        },
        "default": "Aurora Trail running shoes on wet black rock after rain. Low camera, restrained slate palette, sharp side light, visible water grip, no text in the image.",
        "scope": "instance",
        "persist": false
      }
    ]
  },
