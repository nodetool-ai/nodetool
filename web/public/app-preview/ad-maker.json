{
  "slug": "ad-maker",
  "name": "Ad Maker",
  "emoji": "📣",
  "description": "Type the offer once. Three agents run side by side: ad copy written plain, playful and premium; five headlines each taking a different angle; and a hero image whose prompt stays visible so it can be corrected rather than guessed at.",
  "tagline": "One offer, three registers of copy, five headlines and a hero image.",
  "note": "🔑 Needs an OpenAI key for the writing and a FAL key for the image.",
  "featured": false,
  "image": "/app-preview/img/ad-maker.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "📣 Ad Maker",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "One offer, three registers of copy, five headlines and a hero image."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs an OpenAI key for the writing and a FAL key for the image."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-the-offer",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-the-offer",
                  "title": "The offer",
                  "content": [
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-offer",
                        "binding": "var:offer",
                        "label": "What are you advertising?",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-copy-headlines-visual",
                        "label": "Make the ad",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "copy",
                            "key": "",
                            "value": ""
                          },
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "headlines",
                            "key": "",
                            "value": ""
                          },
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "visual",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-the-offer-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-copy",
                        "binding": "op:copy/exec#progress",
                        "label": "Writing copy…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-copy-variants",
                        "text": "Ad copy",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-copy-variants",
                        "binding": "op:copy/out:out",
                        "text": ""
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-headlines-headlines",
                        "text": "Headlines",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-headlines-headlines",
                        "binding": "op:headlines/out:out",
                        "text": ""
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-visual-image",
                        "text": "Hero image",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-visual-image",
                        "binding": "op:visual/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-visual-prompt-used",
                        "text": "Prompt used",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-visual-prompt-used",
                        "binding": "op:visual/out:op",
                        "text": ""
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
