        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "visualBrief"
          }
        },
        "outputs": {},
        "policy": "replace",
        "timeoutMs": 600000
      }
    ],
    "resources": [],
    "variables": [
      {
        "id": "offer",
        "name": "The offer",
        "type": {
          "type": "str",
          "optional": true
        },
        "default": "Aurora Trail running shoes: a third lighter than last season, grip that holds on wet rock, launching this Friday",
        "scope": "user",
        "persist": true
      },
      {
