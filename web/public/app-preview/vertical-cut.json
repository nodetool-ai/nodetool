{
  "slug": "vertical-cut",
  "name": "Vertical Cut",
  "emoji": "📱",
  "description": "Resize a 16:9 clip to the vertical frame and pull a still at the timestamp you choose for the cover. Both run locally through ffmpeg.",
  "tagline": "Landscape footage in, a 9:16 post and its cover frame out.",
  "note": "✨ Keyless. Both steps run on your machine.",
  "featured": false,
  "image": "/app-preview/img/vertical-cut.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "📱 Vertical Cut",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Landscape footage in, a 9:16 post and its cover frame out."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "✨ Keyless. Both steps run on your machine."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-cut-for-vertical",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-cut-for-vertical",
                  "title": "Cut for vertical",
                  "content": [
                    {
                      "type": "VideoInput",
                      "props": {
                        "id": "in-clip",
                        "binding": "var:clip",
                        "label": "Landscape clip",
                        "events": []
                      }
                    },
                    {
                      "type": "Slider",
                      "props": {
                        "id": "slider-cover-frame-time",
                        "binding": "op:cover/prop:frame#time",
                        "label": "Cover frame at (seconds)",
                        "min": 0,
                        "max": 30,
                        "step": 0.5,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-vertical-cover",
                        "label": "Cut it",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "vertical",
                            "key": "",
                            "value": ""
                          },
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "cover",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-cut-for-vertical-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-vertical",
                        "binding": "op:vertical/exec#progress",
                        "label": "Resizing…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-vertical-vertical",
                        "text": "Vertical clip",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-vertical-vertical",
                        "binding": "op:vertical/out:out",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-cover-still",
                        "text": "Cover frame",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-cover-still",
                        "binding": "op:cover/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
        "id": "vertical",
        "name": "Vertical",
        "workflowId": "vertical",
        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "clip"
          }
        },
        "outputs": {},
        "policy": "parallel"
      },
      {
        "id": "cover",
        "name": "Cover",
        "workflowId": "cover",
        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "clip"
          }
        },
        "outputs": {},
        "policy": "parallel"
      }
    ],
    "resources": [],
    "variables": [
      {
        "id": "clip",
        "name": "The clip",
        "type": {
          "type": "video",
          "optional": true
        },
        "scope": "instance",
        "persist": false
      }
    ]
  },
  "workflows": [
    {
      "key": "vertical",
      "name": "Cut a Landscape Clip for Vertical",
      "graph": {
        "nodes": [
          {
            "id": "in",
            "type": "nodetool.input.VideoInput",
            "data": {
              "name": "clip",
              "value": null,
              "description": "The landscape clip"
            },
            "ui_properties": {
              "position": {
                "x": 0,
                "y": 120
              },
              "zIndex": 0,
              "width": 300,
              "selectable": true,
              "title": "1  Clip"
            },
            "dynamic_properties": {},
            "dynamic_outputs": {}
          },
          {
            "id": "out",
            "type": "nodetool.output.Output",
            "data": {
              "name": "vertical"
            },
            "ui_properties": {
              "position": {
                "x": 660,
                "y": 120
              },
              "zIndex": 0,
              "width": 300,
              "selectable": true,
              "title": "3  Vertical"
            },
            "dynamic_properties": {},
            "dynamic_outputs": {}
          }
        ],
        "edges": []
      }
    },
    {
      "key": "cover",
      "name": "Pull a Still from a Clip",
      "graph": {
        "nodes": [
          {
            "id": "in",
            "type": "nodetool.input.VideoInput",
            "data": {
              "name": "clip",
              "value": null,
              "description": "The clip to sample"
            },
            "ui_properties": {
              "position": {
                "x": 0,
                "y": 180
              },
              "zIndex": 0,
              "width": 280,
              "selectable": true,
              "title": "1  Clip"
            },
            "dynamic_properties": {},
            "dynamic_outputs": {}
          },
          {
            "id": "out",
            "type": "nodetool.output.Output",
            "data": {
              "name": "still"
            },
            "ui_properties": {
              "position": {
                "x": 720,
                "y": 200
              },
              "zIndex": 0,
              "width": 240,
              "selectable": true,
              "title": "3  Still"
            },
            "dynamic_properties": {},
            "dynamic_outputs": {}
          }
        ],
        "edges": []
      }
    }
  ],
  "values": {
    "op:cover/prop:frame#time": 2,
    "op:vertical/out:out": {
      "$demo": "video"
    },
    "op:cover/out:out": {
      "$demo": "image"
    }
  }
}
