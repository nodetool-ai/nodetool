{
  "slug": "video-restyle",
  "name": "Video Restyle",
  "emoji": "🎨",
  "description": "Upload footage, name the look and what must survive, and a video-to-video model applies the style. Strength is the dial: low keeps the original read, high commits to the new look.",
  "tagline": "Repaint a clip in a new style while its motion stays put.",
  "note": "🔑 Needs a FAL key (Lucy Edit). Billed per clip.",
  "featured": false,
  "image": "/app-preview/img/video-restyle.jpg",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🎨 Video Restyle",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Repaint a clip in a new style while its motion stays put."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs a FAL key (Lucy Edit). Billed per clip."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-restyle-a-clip",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-restyle-a-clip",
                  "title": "Restyle a clip",
                  "content": [
                    {
                      "type": "WorkflowInput",
                      "props": {
                        "id": "in-restyle-source-video",
                        "binding": "op:restyle/in:in-video",
                        "label": "The clip",
                        "events": []
                      }
                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "in-restyle-style",
                        "binding": "op:restyle/in:in-style",
                        "label": "The look",
                        "options": [
                          {
                            "value": "1980s anime cel animation, hand-inked outlines, flat gouache colour, visible film grain"
                          },
                          {
                            "value": "claymation, soft studio light, fingerprints in the clay, stop-motion cadence"
                          },
                          {
                            "value": "black and white 16mm documentary, heavy grain, high contrast"
                          },
                          {
                            "value": "oil painting, thick impasto brushwork, warm gallery light"
                          },
                          {
                            "value": "neon cyberpunk, wet reflections, magenta and cyan rim light"
                          },
                          {
                            "value": "pencil sketch on paper, cross-hatched shading, visible paper grain"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-restyle-preserve",
                        "binding": "op:restyle/in:in-keep",
                        "label": "What must survive",
                        "multiline": false,
                        "events": []
                      }
                    },
                    {
                      "type": "Slider",
                      "props": {
                        "id": "slider-restyle-restyle-strength",
                        "binding": "op:restyle/prop:restyle#strength",
                        "label": "Strength",
                        "min": 0.1,
                        "max": 1,
                        "step": 0.05,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-restyle",
                        "label": "Restyle the clip",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "restyle",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-restyle-a-clip-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-restyle",
                        "binding": "op:restyle/exec#progress",
                        "label": "Repainting every frame…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-restyle-restyled",
                        "text": "Restyled clip",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Video",
                      "props": {
                        "id": "out-restyle-restyled",
                        "binding": "op:restyle/out:output-video",
                        "height": 320,
                        "placeholder": "Your video appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
        "id": "restyle",
        "name": "Restyle",
        "workflowId": "restyle",
        "inputs": {},
        "outputs": {},
        "policy": "replace"
      }
    ],
    "resources": [],
    "variables": []
  },
