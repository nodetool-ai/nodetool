              "description": "A still to bring to life"
            },
            "ui_properties": {
              "position": {
                "x": 0,
                "y": 180
              },
              "zIndex": 0,
              "width": 280,
              "selectable": true,
              "title": "1  Still"
            },
            "dynamic_properties": {},
            "dynamic_outputs": {}
          },
          {
            "id": "mo",
            "type": "nodetool.input.StringInput",
            "data": {
              "name": "motion",
              "value": "Slow push in with a gentle parallax drift",
              "description": "How the camera should move"
            },
            "ui_properties": {
              "position": {
                "x": 0,
                "y": 340
              },
              "zIndex": 0,
              "width": 280,
              "selectable": true,
              "title": "2  Motion"
            },
            "dynamic_properties": {},
            "dynamic_outputs": {}
          },
          {
            "id": "out",
            "type": "nodetool.output.Output",
            "data": {
              "name": "animated"
            },
            "ui_properties": {
              "position": {
                "x": 1160,
                "y": 220
              },
              "zIndex": 0,
              "width": 240,
              "selectable": true,
              "title": "5  Clip"
