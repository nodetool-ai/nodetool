  ],
  "values": {
    "op:look/in:in": "A lone lighthouse on a basalt cliff under moving storm light",
    "var:still": {
      "$demo": "image"
    },
    "op:motion/in:mo": "Slow push in with a gentle parallax drift",
    "op:motion/prop:vid#duration": 6,
    "op:motion/out:out": {
      "$demo": "video"
    }
  }
}
