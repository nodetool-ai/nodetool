{
  "extends": "./tsconfig.e2e.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": [
      "@playwright/test",
      "@testing-library/jest-dom",
      "@webgpu/types",
      "jest",
      "node"
    ]
  },
  "include": [
    "playwright*.config.ts",
    "src/**/*.d.ts",
    "src/components/themes/paletteDark.ts",
    "src/perf/realtimePerfHarness.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
