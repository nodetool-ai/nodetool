{
  "name": "@nodetool-ai/cli-game",
  "version": "0.8.10",
  "description": "Independent game command feature for NodeTool",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nodetool-game": "dist/nodetool.js"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "nodetool-dev": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/cli-common": "*",
    "@nodetool-ai/game-renderer": "*",
    "@nodetool-ai/game-runtime": "*",
    "@nodetool-ai/node-catalog": "*",
    "@nodetool-ai/pack-manager": "*",
    "@nodetool-ai/protocol": "*",
    "commander": "^12.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nodetool-ai/agents": "*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/cli-game"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
