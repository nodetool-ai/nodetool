{
  "name": "@nodetool-ai/fal-codegen",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "version": "0.1.0",
  "private": true,
  "description": "Code generator for FAL AI nodes",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "generate": "tsx src/generate.ts",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:watch": "node ../../scripts/run-vitest.mjs",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "devDependencies": {
    "@nodetool-ai/node-sdk": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  }
}
