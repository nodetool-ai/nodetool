{
  "name": "@nodetool-ai/higgsfield-nodes",
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "description": "Curated Higgsfield image and video generation nodes for NodeTool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs && node -e \"require('node:fs').cpSync('src/higgsfield-manifest.json', 'dist/higgsfield-manifest.json'); require('node:fs').cpSync('src/schema-fixtures', 'dist/schema-fixtures', { recursive: true })\"",
    "test": "node ../../scripts/run-vitest.mjs run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/config": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/runtime": "*",
    "@nodetool-ai/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./higgsfield-manifest.json": "./dist/higgsfield-manifest.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT"
}
