{
  "name": "@nodetool-ai/kie-codegen",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "version": "0.1.0",
  "private": true,
  "description": "Code generator for Kie.ai nodes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "generate:configs": "tsx src/generate-configs.ts",
    "generate": "tsx src/generate.ts",
    "test": "node ../../scripts/run-vitest.mjs run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "devDependencies": {
    "@nodetool-ai/kie-nodes": "*",
    "@nodetool-ai/node-sdk": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1",
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}
