{
  "name": "@nodetool-ai/model-pricing",
  "version": "0.8.4",
  "description": "Unit-price lookup for models selected on generic nodes, shared by the web cost preview and the server-side run estimate",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs && node -e \"const fs=require('node:fs');fs.cpSync('src/generated','dist/generated',{recursive:true})\"",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:watch": "node ../../scripts/run-vitest.mjs",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/protocol": "*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nodetool-ai/atlascloud-nodes": "*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./genspend-catalog": {
      "nodetool-dev": "./src/genspend-catalog.ts",
      "types": "./dist/genspend-catalog.d.ts",
      "import": "./dist/genspend-catalog.js",
      "default": "./dist/genspend-catalog.js"
    },
    "./model-rankings": {
      "nodetool-dev": "./src/model-rankings.ts",
      "types": "./dist/model-rankings.d.ts",
      "import": "./dist/model-rankings.js",
      "default": "./dist/model-rankings.js"
    },
    "./fal-unit-pricing-catalog": {
      "nodetool-dev": "./src/fal-unit-pricing-catalog.ts",
      "types": "./dist/fal-unit-pricing-catalog.d.ts",
      "import": "./dist/fal-unit-pricing-catalog.js",
      "default": "./dist/fal-unit-pricing-catalog.js"
    },
    "./kie-unit-pricing-catalog": {
      "nodetool-dev": "./src/kie-unit-pricing-catalog.ts",
      "types": "./dist/kie-unit-pricing-catalog.d.ts",
      "import": "./dist/kie-unit-pricing-catalog.js",
      "default": "./dist/kie-unit-pricing-catalog.js"
    },
    "./kie-pricing-api": {
      "nodetool-dev": "./src/kie-pricing-api.ts",
      "types": "./dist/kie-pricing-api.d.ts",
      "import": "./dist/kie-pricing-api.js",
      "default": "./dist/kie-pricing-api.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/model-pricing"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "pricing",
    "cost-estimate",
    "typescript"
  ]
}
