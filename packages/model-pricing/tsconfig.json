{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // The GenSpend catalog is imported as a module (see src/genspend-catalog.ts);
    // JSON import attributes need node18+.
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": [
    "src",
    "src/generated/genspend-pricing.json",
    "src/generated/model-rankings.json"
  ],
  "exclude": [
    "dist",
    "tests"
  ],
  "references": [
    {
      "path": "../fal-nodes"
    },
    {
      "path": "../kie-nodes"
    },
    {
      "path": "../node-sdk"
    }
  ]
}
