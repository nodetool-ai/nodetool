{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nodetool-ai/nodetool",
  "title": "NodeTool",
  "description": "Image, video and audio generation, workflows, a video timeline and a game engine over MCP",
