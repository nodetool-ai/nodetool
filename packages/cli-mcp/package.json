{
  "name": "@nodetool-ai/cli-mcp",
  "version": "0.8.4",
  "description": "Independent NodeTool mcp command module",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "nodetool-dev": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/cli": "*",
    "@nodetool-ai/cli-common": "*",
    "@nodetool-ai/cli-execution": "*",
    "@nodetool-ai/cli-local": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/pack-manager": "*",
    "@nodetool-ai/websocket": "*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1",
    "tsx": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/cli-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "bin": {
    "nodetool-mcp": "dist/nodetool.js"
  },
  "mcpName": "io.github.nodetool-ai/nodetool"
}
