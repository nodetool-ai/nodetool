{
  "name": "@nodetool-ai/config",
  "version": "0.8.4",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:mutation": "node ../mutator/dist/cli.js --root ../.. src",
    "test:mutation:stryker": "stryker run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1",
    "@types/js-yaml": "^4.0.9"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sd-cpp-runtime": {
      "nodetool-dev": "./src/sd-cpp-runtime.ts",
      "types": "./dist/sd-cpp-runtime.d.ts",
      "import": "./dist/sd-cpp-runtime.js",
      "default": "./dist/sd-cpp-runtime.js"
    },
    "./threadpool": {
      "nodetool-dev": "./src/threadpool.ts",
      "types": "./dist/threadpool.d.ts",
      "import": "./dist/threadpool.js",
      "default": "./dist/threadpool.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/config"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "Configuration and environment loading for NodeTool — settings, paths, logging, byte limits, and cross-runtime module loading",
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "configuration",
    "settings",
    "environment",
    "logging"
  ]
}
