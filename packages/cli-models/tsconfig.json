{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../cli-common"
    },
    {
      "path": "../huggingface"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../cli-local"
    },
    {
      "path": "../cli-providers"
    },
    {
      "path": "../protocol"
    },
    {
      "path": "../pack-manager"
    },
    {
      "path": "../presets"
    },
    {
      "path": "../config"
    },
    {
      "path": "../pack-core"
    }
  ]
}
