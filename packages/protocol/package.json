{
  "name": "@nodetool-ai/protocol",
  "version": "0.7.0-rc.38",
  "description": "Shared message types and protocol definitions for the NodeTool workflow runtime",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs && npm run generate:processing-messages-schema",
    "generate:sdk-protocol": "tsx scripts/generate-sdk-protocol.ts",
    "check:sdk-protocol": "tsx scripts/generate-sdk-protocol.ts --check",
    "build:sdk-contract-bundle": "tsx scripts/build-sdk-contract-bundle.ts",
    "diff:sdk-contract": "tsx scripts/diff-sdk-contract.ts",
    "generate:processing-messages-schema": "tsx scripts/generate-processing-messages-schema.ts",
    "check:processing-messages-schema": "tsx scripts/generate-processing-messages-schema.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./blend-modes": {
      "nodetool-dev": "./src/blend-modes.ts",
      "types": "./dist/blend-modes.d.ts",
      "import": "./dist/blend-modes.js",
      "default": "./dist/blend-modes.js"
    },
    "./zod-schema": {
      "nodetool-dev": "./src/zod-schema.ts",
      "types": "./dist/zod-schema.d.ts",
      "import": "./dist/zod-schema.js",
      "default": "./dist/zod-schema.js"
    },
    "./triggers": {
      "nodetool-dev": "./src/triggers.ts",
      "types": "./dist/triggers.d.ts",
      "import": "./dist/triggers.js",
      "default": "./dist/triggers.js"
    },
    "./builtin-packs": {
      "nodetool-dev": "./src/builtin-packs.ts",
      "types": "./dist/builtin-packs.d.ts",
      "import": "./dist/builtin-packs.js",
      "default": "./dist/builtin-packs.js"
    },
    "./bridge-protocol": {
      "nodetool-dev": "./src/bridge-protocol.ts",
      "types": "./dist/bridge-protocol.d.ts",
      "import": "./dist/bridge-protocol.js",
      "default": "./dist/bridge-protocol.js"
    },
    "./sandbox-package": {
      "nodetool-dev": "./src/sandbox-package.ts",
      "types": "./dist/sandbox-package.d.ts",
      "import": "./dist/sandbox-package.js",
      "default": "./dist/sandbox-package.js"
    },
    "./sandbox-capability": {
      "nodetool-dev": "./src/sandbox-capability.ts",
      "types": "./dist/sandbox-capability.d.ts",
      "import": "./dist/sandbox-capability.js",
      "default": "./dist/sandbox-capability.js"
    },
    "./sandbox-host": {
      "nodetool-dev": "./src/sandbox-host.ts",
      "types": "./dist/sandbox-host.d.ts",
      "import": "./dist/sandbox-host.js",
      "default": "./dist/sandbox-host.js"
    },
    "./sandbox-wasm": {
      "nodetool-dev": "./src/sandbox-wasm.ts",
      "types": "./dist/sandbox-wasm.d.ts",
      "import": "./dist/sandbox-wasm.js",
      "default": "./dist/sandbox-wasm.js"
    },
    "./api-schemas": {
      "nodetool-dev": "./src/api-schemas/index.ts",
      "types": "./dist/api-schemas/index.d.ts",
      "import": "./dist/api-schemas/index.js",
      "default": "./dist/api-schemas/index.js"
    },
    "./api-schemas/*.js": {
      "nodetool-dev": "./src/api-schemas/*.ts",
      "types": "./dist/api-schemas/*.d.ts",
      "import": "./dist/api-schemas/*.js",
      "default": "./dist/api-schemas/*.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "message-types",
    "msgpack",
    "protocol",
    "websocket"
  ]
}
