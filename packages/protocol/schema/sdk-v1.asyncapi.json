{
  "asyncapi": "3.0.0",
  "channels": {
    "sdkRpc": {
      "address": "/ws",
      "messages": {
        "executionCommand": {
          "contentType": "application/msgpack",
          "description": "An authenticated SDK workflow-execution command encoded as MessagePack.",
          "name": "SdkExecutionCommand",
          "payload": {
            "$ref": "./sdk-v1.execution.schema.json#/$defs/ExecutionCommand"
          }
        },
        "executionEvent": {
          "contentType": "application/msgpack",
          "description": "An execution target, replay header, live job event, terminal result, or protocol rejection.",
          "name": "SdkExecutionEvent",
          "payload": {
            "$ref": "./sdk-v1.execution.schema.json#/$defs/ExecutionEvent"
          }
        },
        "lifecycleRpcRequest": {
          "contentType": "application/msgpack",
          "description": "Capabilities and preflight commands behind the lifecycle feature flag.",
          "name": "LifecycleRpcRequest",
          "payload": {
            "$ref": "./sdk-v1.lifecycle.schema.json#/$defs/LifecycleRpcRequest"
          }
        },
        "lifecycleRpcResponse": {
          "contentType": "application/msgpack",
          "description": "A correlated capabilities or preflight response.",
          "name": "LifecycleRpcResponse",
          "payload": {
            "$ref": "./sdk-v1.lifecycle.schema.json#/$defs/LifecycleRpcResponse"
          }
        },
        "sdkRpcRequest": {
          "contentType": "application/msgpack",
          "description": "A correlated read-only SDK command. request_id must be non-empty.",
          "name": "SdkRpcRequest",
          "payload": {
            "$ref": "./sdk-v1.discovery.schema.json#/$defs/RpcRequest"
          }
        },
        "sdkRpcResponse": {
          "contentType": "application/msgpack",
          "description": "Exactly one result or error response correlated by request_id.",
          "name": "SdkRpcResponse",
          "payload": {
            "$ref": "./sdk-v1.discovery.schema.json#/$defs/RpcResponse"
          }
        }
      }
    }
  },
  "info": {
    "description": "MessagePack WebSocket contract for NodeTool SDK v1 RPC and workflow execution. JSON text remains diagnostic compatibility behavior.",
    "title": "NodeTool SDK WebSocket API",
    "version": "1"
  },
  "operations": {
    "receiveExecutionEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/sdkRpc"
      },
      "messages": [
        {
          "$ref": "#/channels/sdkRpc/messages/executionEvent"
        }
      ]
    },
    "receiveLifecycleRpcResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/sdkRpc"
      },
      "messages": [
        {
          "$ref": "#/channels/sdkRpc/messages/lifecycleRpcResponse"
        }
      ]
    },
    "receiveSdkRpcResponse": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/sdkRpc"
      },
      "messages": [
        {
          "$ref": "#/channels/sdkRpc/messages/sdkRpcResponse"
        }
      ]
    },
    "sendExecutionCommand": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/sdkRpc"
      },
      "messages": [
        {
          "$ref": "#/channels/sdkRpc/messages/executionCommand"
        }
      ]
    },
    "sendLifecycleRpcRequest": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/sdkRpc"
      },
      "messages": [
        {
          "$ref": "#/channels/sdkRpc/messages/lifecycleRpcRequest"
        }
      ]
    },
    "sendSdkRpcRequest": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/sdkRpc"
      },
      "messages": [
        {
          "$ref": "#/channels/sdkRpc/messages/sdkRpcRequest"
        }
      ]
    }
  },
  "servers": {
    "local": {
      "description": "Local trusted connections may omit credentials; remote deployments authenticate the WebSocket upgrade.",
      "host": "127.0.0.1:7777",
      "pathname": "/ws",
      "protocol": "ws"
    }
  },
  "x-nodetool-default-encoding": "messagepack",
  "x-nodetool-status": "draft"
}
