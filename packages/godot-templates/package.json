{
  "name": "@nodetool-ai/godot-templates",
  "version": "0.7.0-rc.40",
  "description": "Godot 4.3 game project templates with asset-slot manifests, plus a headless Godot runner for import, script check, and smoke tests",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "check": "npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "placeholders": "node scripts/make-placeholders.mjs"
  },
  "dependencies": {
    "@nodetool-ai/protocol": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/godot-templates"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "godot",
    "game",
    "templates",
    "typescript"
  ]
}
