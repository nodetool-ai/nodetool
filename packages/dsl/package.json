{
  "name": "@nodetool-ai/dsl",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "0.8.0",
  "description": "Type-safe TypeScript DSL for defining NodeTool workflows",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./flow": {
      "nodetool-dev": "./src/flow/index.ts",
      "types": "./dist/flow/index.d.ts",
      "import": "./dist/flow/index.js",
      "default": "./dist/flow/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "pretest": "node scripts/ensure-deps-built.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "pretest:watch": "node scripts/ensure-deps-built.mjs",
    "test:watch": "node ../../scripts/run-vitest.mjs",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/codegen.ts --check"
  },
  "dependencies": {
    "@nodetool-ai/base-nodes": "*",
    "@nodetool-ai/config": "*",
    "@nodetool-ai/elevenlabs-nodes": "*",
    "@nodetool-ai/huggingface-nodes": "*",
    "@nodetool-ai/kernel": "*",
    "@nodetool-ai/minimax-nodes": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/protocol": "*",
    "@nodetool-ai/reve-nodes": "*",
    "@nodetool-ai/runtime": "*",
    "@nodetool-ai/storage": "*",
    "@nodetool-ai/transformers-js-nodes": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/dsl"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "dsl",
    "typescript-dsl",
    "workflow-dsl",
    "type-safe"
  ]
}
