{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../server-minimal"
    },
    {
      "path": "../nodes-core"
    },
    {
      "path": "../runtime-core"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../database-sqlite"
    },
    {
      "path": "../security-core"
    },
    {
      "path": "../pack-manager"
    },
    {
      "path": "../server-features"
    }
  ]
}
