{
  "name": "@nodetool-ai/cli",
  "version": "0.8.4",
  "description": "Lean NodeTool command line client and execution server",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "nodetool-chat": "dist/chat.js",
    "nodetool": "dist/nodetool.js"
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "dev": "node ../../scripts/run-with-tsc-version.mjs 6 node ../../scripts/run-tsc.mjs --watch",
    "start": "node dist/index.js",
    "test": "node ../../scripts/run-vitest.mjs run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@nodetool-ai/server-minimal": "*",
    "@nodetool-ai/nodes-core": "*",
    "@nodetool-ai/runtime-core": "*",
    "@nodetool-ai/database-sqlite": "*",
    "@nodetool-ai/security-core": "*",
    "zod": "^4.4.3",
    "@nodetool-ai/pack-manager": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/cli"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "workflow",
    "cli",
    "execution"
  ]
}
