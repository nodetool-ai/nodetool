{
  "name": "@nodetool-ai/game-renderer",
  "version": "0.8.0",
  "description": "Native 2D renderer for NodeTool games",
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:watch": "node ../../scripts/run-vitest.mjs",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.31.0",
    "@napi-rs/canvas": "^0.1.65",
    "@nodetool-ai/gpu": "*",
    "@nodetool-ai/game-runtime": "*",
    "@nodetool-ai/protocol": "*",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.70",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "nodetool-dev": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "nodetool-dev": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./build": {
      "nodetool-dev": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    }
  },
  "files": ["dist"],
  "license": "MIT"
}
