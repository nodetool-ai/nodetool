{
  "name": "@nodetool-ai/transformers-js-provider",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "0.7.0-rc.40",
  "description": "Local-models BaseProvider backed by @huggingface/transformers and kokoro-js (chat, TTS, ASR, embeddings)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:watch": "node ../../scripts/run-vitest.mjs",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/config": "*",
    "@nodetool-ai/protocol": "*",
    "@nodetool-ai/runtime": "*",
    "@nodetool-ai/transformers-js-nodes": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/transformers-js-provider"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "transformers-js",
    "local-models",
    "onnx",
    "tts",
    "asr",
    "embeddings",
    "kokoro"
  ]
}
