)c.push({kind:'emit',event:'land'});s.grounded=input.entity.grounded;\n if(input.tick<=1)c.push({kind:'hud',id:'score',text:' ',x:0,y:0},{kind:'hud',id:'win',text:' ',x:0,y:0});\n if(input.tick%30===0&&!s.won){let t='Approach the amber core, then hold E to push it';if(s.cp===1)t='Wait at the mint dock lights, then ride the shuttle';if(s.cp===2)t=s.stage<2?'Right-hand coolant terminal · approach and hold E':'Coolant active · cross the raised bridge';if(s.cp===3)t=s.stage<3?'Left-hand reactor terminal · approach and hold E':'Final gate open · reach the descending reactor core';c.push({kind:'ui',id:'hint',text:t});}\n return {state:s,commands:c};\n}","maxCommands":24,"maxTickMs":50}]},{"id":"arrival-deck","name":"Arrival Deck","templateOnly":false,"transform3d":{"position":{"x":0,"y":-0.5,"z":-2},"rotation":[0,0,0,1],"scale":{"x":1,"y":1,"z":1}},"body3d":{"type":"static","velocity":{"x":0,"y":0,"z":0},"angularVelocity":{"x":0,"y":0,"z":0},"gravityScale":1,"linearDamping":0,"angularDamping":0,"ccd":false},"collider3d":{"kind":"box","halfExtents":{"x":6,"y":0.5,"z":8},"offset":{"x":0,"y":0,"z":0},"rotation":[0,0,0,1],"sensor":false,"category":1,"mask":65535,"physicsMaterial":"stone","friction":0.5,"restitution":0},"behaviors":[]},{"id":"beacon-deck","name":"Beacon Deck","templateOnly":false,"transform3d":{"position":{"x":0,"y":-0.5,"z":-18},"rotation":[0,0,0,1],"scale":{"x":1,"y":1,"z":1}},"body3d":{"type":"static","velocity":{"x":0,"y":0,"z":0},"angularVelocity":{"x":0,"y":0,"z":0},"gravityScale":1,"linearDamping":0,"angularDamping":0,"ccd":false},"collider3d":{"kind":"box","halfExtents":{"x":5,"y":0.5,"z":4},"offset":{"x":0,"y":0,"z":0},"rotation":[0,0,0,1],"sensor":false,"category":1,"mask":65535,"physicsMaterial":"stone","friction":0.5,"restitution":0},"behaviors":[]},{"id":"column--1-0","name":"Column  1 0","templateOnly":false,"transform3d":{"position":{"x":-5.2,"y":1.8,"z":3},"rotation":[0,0,0,1],"scale":{"x":1,"y":1,"z":1}},"body3d":{"type":"static","velocity":{"