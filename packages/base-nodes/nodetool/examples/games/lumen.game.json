entity, world, state, random }) => {\n  const s = state ?? { vx: 0, vy: 0, invuln: 60, collected: 0, hud: \"\" };\n  const commands = [];\n  const burst = (count, speed) => {\n    for (let i = 0; i < count; i += 1) {\n      const a = random() * Math.PI * 2;\n      const v = speed * (0.4 + random() * 0.6);\n      commands.push({ kind: \"spawn\", prefabId: \"ember\", x: entity.x, y: entity.y, velocityX: Math.cos(a) * v, velocityY: Math.sin(a) * v });\n    }\n  };\n  let won = false;\n  for (const event of events) {\n    if (event.kind === \"collected\" && event.byId === entity.id) {\n      s.collected += 1;\n      burst(10, 5);\n    }\n    if (event.kind === \"win\") won = true;\n  }\n  if (won) burst(24, 9);\n\n  if (s.invuln > 0) s.invuln -= 1;\n  else {\n    for (const event of events) {\n      if (event.kind !== \"contact\" || event.phase === \"exit\") continue;\n      // A pair reports one contact per tick, so either side may name the firefly.\n      const other = event.entityId === entity.id ? event.otherId : event.otherId === entity.id ? event.entityId : \"\";\n      if (!other.startsWith(\"wisp\")) continue;\n      const wisp = world.find((item) => item.id === other);\n      const dx = entity.x - (wisp ? wisp.x : entity.x - 1);\n      const dy = entity.y - (wisp ? wisp.y : entity.y);\n      const d = Math.hypot(dx, dy) || 1;\n      s.vx = (dx / d) * 14;\n      s.vy = (dy / d) * 14;\n      s.invuln = 80;\n      commands.push({ kind: \"emit\", event: \"hurt\" });\n      break;\n    }\n  }\n\n  const ax = (pressed.includes(\"right\") ? 1 : 0) - (pressed.includes(\"left\") ? 1 : 0);\n  const ay = (pressed.includes(\"up\") ? 1 : 0) - (pressed.includes(\"down\") ? 1 : 0);\n  const length = Math.hypot(ax, ay) || 1;\n  s.vx = s.vx * 0.93 + (ax / length) * 0.55;\n  s.vy = s.vy * 0.93 + (ay / length) * 0.55;\n  // A gentle hover wobble keeps the firefly alive when idle.\n  const wobbleX = Math.sin(tick * 0.05) * 0.35;\n  const wobbleY = Math.cos(tick * 0.07) * 0.45;\n  let x = entity.x;\n  let y = entity.y;\n  if (Math.abs(x) > 35.4) { x = Math.sign(x) * 35.4; s.vx *= -0.3; commands.push({ kind: \"setPosition\", x, y }); }\n  if (y < -3.2 || y > 4.2) { y = Math.max(-3.2, Math.min(4.2, y)); s.vy *= -0.3; commands.push({ kind: \"setPosition\", x, y }); }\n  commands.push({ kind: \"setVelocity\", x: s.vx + wobbleX, y: s.vy + wobbleY });\n  const flicker = 0.85 + Math.sin(tick * 0.3) * 0.08 + random() * 0.07;\n  commands.push({ kind: \"setVisual\", opacity: s.invuln > 0 && Math.floor(s.invuln / 5) % 2 === 0 ? 0.35 : flicker });\n  if (tick % 3 === 0) {\n    commands.push({ kind: \"spawn\", prefabId: \"trail\", x: x + (random() - 0.5) * 0.2, y: y + (random() - 0.5) * 0.2,\n      velocityX: -s.vx * 0.15 + (random() - 0.5) * 0.4, velocityY: -s.vy * 0.15 + 0.3 });\n  }\n  const hud = `${s.collected}`;\n  if (hud !== s.hud) {\n    s.hud = hud;\n    commands.push({ kind: \"hud\", id: \"score\", text: `light  ${s.collected} / 30`, x: 40, y: 24, size: 34, color: \"#e8ffb0\", align: \"left\", fontId: \"display\" });\n  }\n  return { state: s, commands };\n}","maxCommands":40,"maxTickMs":20},{"kind":"winWhenCollected","count":30}],"sprite":{"assetId":"firefly","width":1.5,"height":1.5,"layer":2,"blend":"additive","unlit":true},"body2d":{"type":"kinematic","velocity":{"x":0,"y":0}},"collider2d":{"width":0.6,"height":0.6,"sensor":false,"category":1,"mask":6}},{"id":"darkness","name":"darkness","transform2d":{"x":-32,"y":0,"rotation":0,"scaleX":1,"scaleY":1},"behaviors":[{"kind":"script","source":"({ events, world, state }) => {\n  const s = state ?? { level: 0, scale: 0.8, opacity: 1, won: false, x: 0, y: 0 };\n  for (const event of events) {\n    if (event.kind === \"collected\") s.level += 1;\n    if (event.kind === \"trigger\" && event.event === \"hurt\") s.level = Math.max(0, s.level - 2);\n    if (event.kind === \"win\") s.won = true;\n  }\n  const player = world.find((item) => item.source === \"player\");\n  if (player) { s.x = player.x; s.y = player.y; }\n  const target = 0.8 + s.level * 0.035;\n  s.scale += (target - s.scale) * 0.04;\n  if (s.won) s.opacity = Math.max(0, s.opacity - 1 / 150);\n  return { state: s, commands: [\n    { kind: \"setPosition\", x: s.x, y: s.y },\n    { kind: \"setVisual\", scaleX: s.scale, scaleY: s.scale, opacity: s.opacity }\n  ] };\n}","maxCommands":2,"maxTickMs":20}],"sprite":{"assetId":"darkness","width":44,"height":24.75,"layer":5,"unlit":true}},{"id":"ambience","name":"ambience","transform2d":{"x":0,"y":0,"rotation":0,"scaleX":1,"scaleY":1},"behaviors":[{"kind":"script","source":"({ tick, events, world, state, random }) => {\n  const s = state ?? { level: 0, won: false };\n  for (const event of events) {\n    if (event.kind === \"collected\") s.level += 1;\n    if (event.kind === \"win\") s.won = true;\n  }\n  const commands = [];\n  const interval = s.won ? 2 : Math.max(4, 16 - s.level);\n  if (tick % interval === 0) {\n    const camera = world.find((item) => item.source === \"camera\");\n    const cx = camera ? camera.x : 0;\n    commands.push({ kind: \"spawn\", prefabId: \"wander\", x: cx + (random() * 2 - 1) * 9, y: -3.5 + random() * 7.5,\n      velocityX: (random() - 0.5) * 0.9, velocityY: 0.15 + random() * 0.5 });\n  }\n  if (s.won && !s.shown) {\n    s.shown = true;\n    commands.push({ kind: \"hud\", id: \"win\", text: \"the forest remembers the light\", x: 640, y: 290, size: 58, color: \"#f2ffd0\", align: \"center\", fontId: \"display\" });\n  }\n  return { state: s, commands };\n}","maxCommands":3,"maxTickMs":20}]},{"id":"trail","name":"trail","transform2d":{"x":0,"y":0,"rotation":0,"scaleX":1,"scaleY":1},"behaviors":[{"kind":"lifetime","ticks":40,"fade":true,"endScale":0.2}],"templateOnly":true,"sprite":{"assetId":"ember","width":0.45,"height":0.45,"layer":3,"blend":"additive","unlit":true},"body2d":{"type":"kinematic","velocity":{"x":0,"y":0}}},{"id":"ember","name":"ember","transform2d":{"x":0,"y":0,"rotation":0,"scaleX":1,"scaleY":1},"behaviors":[{"kin