      {
        "id": "intro-comment",
        "type": "nodetool.workflows.base_node.Comment",
        "data": {
          "comment": "# Watch a Folder, Act on What Lands\n\nUses a drop folder as an interface. The graph wakes whenever a matching file is created or modified, so you can process files as they arrive.\n\n**How it works:** \"1 Watch ./inbox\" watches for CSV and JSON files, with a short debounce because editors often write a file twice. It sends the event kind to \"2 Event\" and the file path to \"3 Describe it\", which names the file and suggests a next step in \"4 Note\".\n\n**Try this:** Point path on \"1 Watch ./inbox\" at your own folder and add *.pdf to patterns."
        },
        "ui_properties": {
          "position": {
            "x": 0,
            "y": 0
          },
          "zIndex": 0,
          "width": 560,
          "selectable": true,
          "height": 286
        },
        "dynamic_properties": {},
        "dynamic_outputs": {}
      },
      {
        "id": "watch",
        "type": "nodetool.triggers.FileWatchTrigger",
        "data": {
          "path": "./inbox",
          "recursive": false,
          "patterns": [
            "*.csv",
            "*.json"
          ],
          "ignore_patterns": [],
          "events": [
            "created",
            "modified"
          ],
          "debounce_seconds": 0.5,
          "max_events": 0
        },
        "ui_properties": {
