        "id": "cw",
        "type": "nodetool.code.Code",
        "data": {
          "code": "const text = String(inputs.text ?? \"\");\nconst preserveNewlines = Boolean(inputs.preserve_newlines ?? false);\nconst replacement = String(inputs.replacement ?? \" \");\nconst trimEdges = inputs.trim_edges === undefined ? true : Boolean(inputs.trim_edges);\nconst value = trimEdges ? text.trim() : text;\nconst pattern = preserveNewlines ? /[^\\S\\r\\n]+/g : /\\s+/g;\nreturn { output: value.replace(pattern, replacement) };",
          "packages": []
        },
        "ui_properties": {
          "position": {
