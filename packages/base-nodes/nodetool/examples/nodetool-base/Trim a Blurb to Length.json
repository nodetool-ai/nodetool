          "title": "1  Blurb"
        },
        "dynamic_properties": {},
        "dynamic_outputs": {}
      },
      {
        "id": "tr",
        "type": "nodetool.code.Code",
        "data": {
          "code": "const text = String(inputs.text ?? \"\");\nconst maxLen = Number(inputs.max_length ?? 100);\nconst ellipsis = String(inputs.ellipsis ?? \"\");\nif (text.length <= maxLen) return { output: text };\nreturn { output: text.slice(0, maxLen - ellipsis.length) + ellipsis };",
          "packages": []
        },
        "ui_properties": {
