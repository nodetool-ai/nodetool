      {
        "id": "store_cards",
        "parent_id": null,
        "type": "nodetool.code.Code",
        "data": {
          "code": "const file = \"flashcards.json\";\nconst before = await workspace.stat(file);\nconst deck = before.exists ? JSON.parse(await workspace.read(file)) : [];\n\nconst added = (inputs.cards?.rows ?? []).map((card) => ({\n  front: card.front,\n  back: card.back,\n  category: card.category\n}));\ndeck.push(...added);\nawait workspace.write(file, JSON.stringify(deck, null, 2));\n\nreturn { saved: added.length, deck: deck.slice(-10).reverse() };\n",
          "packages": [],
          "timeout": 30,
          "max_response_mb": 8,
          "allow_local_network": false,
          "allow_host_filesystem": false
        },
        "ui_properties": {
          "selected": false,
          "position": {
            "x": 1126,
            "y": 400
          },
          "zIndex": 0,
          "width": 320,
          "selectable": true,
          "title": "5️⃣ Save the deck and read it back"
