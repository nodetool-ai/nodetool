      {
        "id": "plan_study",
        "parent_id": null,
        "type": "nodetool.code.Code",
        "data": {
          "code": "// The generator hands over rows, not prose — so the deck can be computed on.\nconst cards = inputs.cards?.rows ?? [];\n\n// One card per question: a model asked for fifteen repeats itself.\nconst seen = new Set();\nconst unique = cards.filter((card) => {\n  const key = String(card.front ?? \"\").trim().toLowerCase();\n  if (!key || seen.has(key)) return false;\n  seen.add(key);\n  return true;\n});\n\n// Group by category, then deal one card from each pile in turn, so a study run\n// never asks four questions about the same sub-topic back to back.\nconst piles = new Map();\nfor (const card of unique) {\n  const category = String(card.category ?? \"General\").trim() || \"General\";\n  if (!piles.has(category)) piles.set(category, []);\n  piles.get(category).push({ ...card, category });\n}\nconst dealt = [...piles.values()];\nconst order = [];\nfor (let i = 0; dealt.some((pile) => i < pile.length); i++) {\n  for (const pile of dealt) {\n    if (i < pile.length) order.push(pile[i]);\n  }\n}\n\n// Leitner box 1: review today, then in two days, then in five.\nconst study_plan = order.map((card, index) => ({\n  position: index + 1,\n  front: card.front,\n  back: card.back,\n  category: card.category,\n  review_after_days: [0, 2, 5]\n}));\n\nreturn { study_plan };\n",
          "packages": [],
          "timeout": 30,
          "max_response_mb": 8,
          "allow_local_network": false,
          "allow_host_filesystem": false
        },
