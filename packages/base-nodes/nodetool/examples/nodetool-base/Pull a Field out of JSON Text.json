        "id": "ej",
        "type": "nodetool.code.Code",
        "data": {
          "code": "const data = JSON.parse(inputs.text);\nconst value = String(inputs.path).split(\".\").reduce(\n  (acc, k) => (acc == null ? acc : acc[k]),\n  data\n);\nreturn { output: value };",
