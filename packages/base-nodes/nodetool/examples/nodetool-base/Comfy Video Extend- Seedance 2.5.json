        "data": {
          "model": "Seedance 2.5",
          "model.prompt": "Continuing from the previous shot, live-action western rodeo, dusty arena, golden hour. The raging bull calms down and stops, the buzzer rings. The sloth in the cowboy hat hops off the bull's back, lands steadily in the dust, slowly dusts off his hat, then strolls away unhurriedly with a deadpan expression. Slow motion, dust floating in warm sunlight, cheering crowd roars and waves hats in the background. Steadicam follow shot. Western arena music swells. No black frames, no text overlays.",
          "model.resolution": "720p",
          "model.ratio": "adaptive",
          "model.duration": 5,
          "model.generate_audio": true,
          "model.task_type": "extend",
          "model.output_format": "mp4",
