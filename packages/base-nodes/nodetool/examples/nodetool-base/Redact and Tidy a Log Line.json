        "data": {
          "code": "let flags = \"g\";\nif (inputs.ignorecase) flags += \"i\";\nif (inputs.multiline) flags += \"m\";\nif (inputs.dotall) flags += \"s\";\nconst matches = [...inputs.text.matchAll(new RegExp(inputs.pattern, flags))].map(m => m[0]);\nreturn { output: matches };",
