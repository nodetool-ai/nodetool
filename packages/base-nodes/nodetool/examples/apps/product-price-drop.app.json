            "label": "Approve exact sources and copy",
            "description": "Changing any input requires a new plan and approval."
          }
        },
        {
          "type": "Button",
          "props": {
            "id": "finish",
            "label": "Build editable ad",
            "disabledWhen": {
              "binding": "op:finish/exec#running",
              "op": "notEmpty"
            },
            "events": [
              {
                "trigger": "click",
                "kind": "run",
                "operationId": "finish"
              }
            ]
          }
        },
        {
          "type": "Timeline",
          "props": {
            "id": "result",
            "binding": "var:timeline"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "plan-error",
            "binding": "op:plan/exec#error"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "finish-error",
            "binding": "op:finish/exec#error"
          }
        }
      ]
    }
  }
}
