                    },
                    {
                      "type": "Select",
                      "props": {
                        "id": "in-edit-instruction",
                        "binding": "op:edit/in:ins",
                        "label": "What should change?",
                        "options": [
                          {
                            "value": "Make it golden hour, warm low sun raking across the subject"
                          },
                          {
                            "value": "Relight it as an overcast studio shot, soft even light, no hard shadows"
                          },
                          {
                            "value": "Replace the background with a quiet city street at dusk, keep the subject exactly as is"
                          },
                          {
                            "value": "Change the subject's pose so they face the camera with arms relaxed"
                          },
                          {
                            "value": "Change the subject's outfit to a black tailored suit, keep face and pose"
                          },
                          {
                            "value": "Shift the colour palette to muted teal and sand tones"
                          },
                          {
                            "value": "Render it as a loose watercolour illustration, keep the composition"
                          },
                          {
                            "value": "Move the camera to a low angle looking up, same subject and setting"
                          }
                        ],
                        "events": []
                      }
                    },
                    {
                      "type": "Slider",
                      "props": {
                        "id": "slider-edit-ed-strength",
                        "binding": "op:edit/prop:ed#strength",
                        "label": "How far to go",
                        "min": 0.2,
                        "max": 1,
                        "step": 0.05,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-edit",
                        "label": "Vary the image",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "edit",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-vary-it-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-edit",
                        "binding": "op:edit/exec#progress",
                        "label": "Editing…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-edit-edited",
                        "text": "Varied image",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-edit-edited",
                        "binding": "op:edit/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
