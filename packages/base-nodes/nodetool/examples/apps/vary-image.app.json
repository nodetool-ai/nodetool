{
  "schemaVersion": 1,
  "name": "Vary Image",
  "description": "Pick what should change — lighting, background, pose, palette, camera angle — and an edit model alters only that. Composition and subject survive because the model edits in place instead of regenerating.",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "🪄 Vary Image",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Change one thing about a photo and keep the rest."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Needs a FAL key (Nano Banana edit). Billed per image."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-vary-it",
            "gap": 24,
