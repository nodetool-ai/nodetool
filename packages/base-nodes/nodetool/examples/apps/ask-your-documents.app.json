          {
            "id": "search_input",
            "parent_id": null,
            "type": "nodetool.input.StringInput",
            "data": {
              "name": "search",
              "value": "Aurora",
              "description": "Keyword used to pull matching documents from your knowledge base. 'Aurora' appears in every document, so it retrieves the whole corpus; narrow it (e.g. 'warranty') to scope retrieval to one topic."
            },
            "ui_properties": {
