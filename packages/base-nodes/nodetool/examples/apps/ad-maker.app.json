                      "type": "Button",
                      "props": {
                        "id": "btn-copy-headlines",
                        "label": "Write the routes",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "copy",
                            "key": "",
                            "value": ""
                          },
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "headlines",
                            "key": "",
                            "value": ""
                          }
                        ],
                        "disabledWhen": {
                          "binding": "op:copy/exec#running",
                          "op": "notEmpty"
