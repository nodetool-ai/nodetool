{
  "schemaVersion": 1,
  "name": "Ad Maker",
  "description": "Start with one offer and compare three copy registers with five headline angles. Only then write the visual brief and spend the image call. The final prompt stays beside the hero so the result can be directed instead of guessed at.",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "title",
            "text": "📣 Ad Maker",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Settle the words. Direct the image. Keep the brief."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "🔑 Writing uses OpenAI. The hero uses FAL and runs only when you ask for it."
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-1-write-the-routes",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-1-write-the-routes",
                  "title": "1 · Write the routes",
                  "content": [
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-offer",
                        "binding": "var:offer",
                        "label": "What are you advertising?",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "Text",
                      "props": {
                        "id": "note",
                        "text": "Start with the cheap decision point. Compare the writing before generating an image."
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-copy-headlines",
                        "label": "Write copy and headlines",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "copy",
                            "key": "",
                            "value": ""
                          },
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "headlines",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-1-write-the-routes-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-copy",
                        "binding": "op:copy/exec#progress",
                        "label": "Writing three registers…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-copy-variants",
                        "text": "Three copy routes",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-copy-variants",
                        "binding": "op:copy/out:out",
                        "text": ""
                      }
                    },
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-headlines",
                        "binding": "op:headlines/exec#progress",
                        "label": "Testing five angles…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-headlines-headlines",
                        "text": "Five headline angles",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-headlines-headlines",
                        "binding": "op:headlines/out:out",
                        "text": ""
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Columns",
          "props": {
            "id": "cols-2-direct-the-image",
            "gap": 24,
            "left": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-2-direct-the-image",
                  "title": "2 · Direct the image",
                  "content": [
                    {
                      "type": "Text",
                      "props": {
                        "id": "note-2",
                        "text": "Carry the strongest promise into the scene. State what the product is doing, where it sits, and what must not appear."
                      }
                    },
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-visualbrief",
                        "binding": "var:visualBrief",
                        "label": "Visual brief",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-visual",
                        "label": "Generate the hero",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "visual",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-2-direct-the-image-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-visual",
                        "binding": "op:visual/exec#progress",
                        "label": "Writing the prompt and rendering…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-visual-prompt-used",
                        "text": "Prompt sent to the image model",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Markdown",
                      "props": {
                        "id": "out-visual-prompt-used",
                        "binding": "op:visual/out:op",
                        "text": ""
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-visual-image",
                        "text": "Campaign hero",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Image",
                      "props": {
                        "id": "out-visual-image",
                        "binding": "op:visual/out:out",
                        "fit": "contain",
                        "height": 280,
                        "placeholder": "Your result appears here"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
    },
    "operations": [
      {
