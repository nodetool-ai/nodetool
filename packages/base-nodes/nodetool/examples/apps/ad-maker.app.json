            "text": "Ad Maker",
            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Settle the message. Direct the campaign image."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "The hero render only runs after you approve the visual brief."
