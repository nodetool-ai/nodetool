        "workflowId": "visual",
        "inputs": {
          "in": {
            "from": "variable",
            "variableId": "visualBrief"
          }
        },
        "outputs": {},
        "policy": "replace",
        "timeoutMs": 600000
      }
    ],
    "resources": [],
    "variables": [
      {
        "id": "offer",
        "name": "The offer",
        "type": {
          "type": "str",
          "optional": true
        },
        "default": "Olive Travel Cup: a matte muted-olive cup with a charcoal lid, launching this Friday",
        "scope": "user",
        "persist": true
      },
      {
        "id": "visualBrief",
