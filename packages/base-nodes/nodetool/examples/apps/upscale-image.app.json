            "level": "1"
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "tagline",
            "text": "Enlarge an image without the softness of a plain resize."
          }
        },
        {
          "type": "Text",
          "props": {
            "id": "app-note",
            "text": "One billed generation per upscale."
          }
        },
        {
