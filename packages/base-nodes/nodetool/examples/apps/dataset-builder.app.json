              {
                "type": "Container",
                "props": {
                  "id": "panel-the-dataset",
                  "title": "The dataset",
                  "content": [
                    {
                      "type": "TextInput",
                      "props": {
                        "id": "in-generate-topic",
                        "binding": "op:generate/in:topic_input",
                        "label": "What data do you need?",
                        "multiline": true,
                        "events": []
                      }
                    },
                    {
                      "type": "NumberInput",
                      "props": {
                        "id": "in-generate-row-count",
                        "binding": "op:generate/in:row_count_input",
                        "label": "How many rows?",
                        "min": 5,
                        "max": 50,
                        "events": []
                      }
                    },
                    {
                      "type": "Button",
                      "props": {
                        "id": "btn-generate",
                        "label": "Generate data",
                        "variant": "contained",
                        "color": "primary",
                        "events": [
                          {
                            "trigger": "click",
                            "kind": "run",
                            "operationId": "generate",
                            "key": "",
                            "value": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "right": [
              {
                "type": "Container",
                "props": {
                  "id": "panel-the-dataset-results",
                  "title": "Results",
                  "content": [
                    {
                      "type": "Progress",
                      "props": {
                        "id": "progress-generate",
                        "binding": "op:generate/exec#progress",
                        "label": "Generating rows…"
                      }
                    },
                    {
                      "type": "Heading",
                      "props": {
                        "id": "lbl-generate-generated-data",
                        "text": "Generated dataset",
                        "level": "3"
                      }
                    },
                    {
                      "type": "Table",
                      "props": {
                        "id": "out-generate-generated-data",
                        "binding": "op:generate/out:data_output"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "zones": {}
