{
  "schemaVersion": 1,
  "name": "Dataset Builder",
  "description": "The smallest app in the set, and the reference for the Table widget: a dataframe reads better as rows than as a Preview node.",
  "app": {
    "schemaVersion": 3,
    "ui": {
      "root": {
        "props": {}
