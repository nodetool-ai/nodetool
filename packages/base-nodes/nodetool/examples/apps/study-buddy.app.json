            "id": "num_cards_input",
            "parent_id": null,
            "type": "nodetool.input.IntegerInput",
            "data": {
              "name": "num_cards",
              "value": 5,
              "min": 3,
              "max": 15,
              "description": "How many flashcards to generate"
            },
            "ui_properties": {
              "selected": false,
              "position": {
                "x": 76,
                "y": 291
              },
              "zIndex": 0,
              "width": 280,
              "selectable": true,
              "title": "2️⃣ Card count"
