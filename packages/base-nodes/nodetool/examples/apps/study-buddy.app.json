              "max_tokens": 4096,
              "columns": {
                "type": "record_type",
                "columns": [
                  {
                    "name": "front",
                    "data_type": "string"
                  },
                  {
                    "name": "back",
                    "data_type": "string"
                  },
                  {
                    "name": "category",
                    "data_type": "string"
                  }
                ]
