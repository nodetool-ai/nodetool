  "description": "Framework-independent runtime core for NodeTool mini apps: application document, typed bindings, namespaced instance state, and the streaming message fold",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
