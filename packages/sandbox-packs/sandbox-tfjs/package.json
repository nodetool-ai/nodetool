{
  "name": "@nodetool-ai/sandbox-tfjs",
  "version": "0.7.0-rc.40",
  "description": "Classify images, detect objects and answer questions inside the NodeTool sandbox, from TensorFlow.js running on the host",
  "license": "MIT",
  "nodetool": {
    "apiVersion": 1,
    "recommended": true,
    "sandboxModules": [
      {
        "name": ".",
        "kind": "host",
        "host": "tfjs"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/sandbox-packs/sandbox-tfjs"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "SKILL.md"
  ],
  "keywords": [
    "nodetool",
    "nodetool-sandbox-pack",
    "sandbox",
    "tensorflow",
    "tfjs",
    "machine-learning",
    "image-classification",
    "object-detection"
  ]
}
