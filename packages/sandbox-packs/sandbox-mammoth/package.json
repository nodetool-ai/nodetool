{
  "name": "@nodetool-ai/sandbox-mammoth",
  "version": "0.7.0-rc.38",
  "description": "Read Word documents inside the NodeTool sandbox, from mammoth running on the host",
  "license": "MIT",
  "nodetool": {
    "apiVersion": 1,
    "recommended": true,
    "sandboxModules": [
      {
        "name": ".",
        "kind": "host",
