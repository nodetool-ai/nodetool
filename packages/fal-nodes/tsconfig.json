{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // The generated unit-pricing catalog is imported as a module (see
    // src/unit-pricing-catalog.ts); JSON import attributes need node18+.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src",
    "src/generated/*-unit-pricing.json"
  ],
  "exclude": [
    "dist",
    "tests",
    "node_modules"
  ],
  "references": [
    {
      "path": "../node-sdk"
    }
  ]
}
