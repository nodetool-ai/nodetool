{
  "name": "@nodetool-ai/cli-full",
  "version": "0.8.4",
  "description": "Explicitly installed full NodeTool command tree, interactive chat, MCP and authoring harnesses",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/runner.js",
  "bin": {
    "nodetool-full": "dist/nodetool.js",
    "nodetool-chat-full": "dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "dev": "node ../../scripts/run-with-tsc-version.mjs 6 node ../../scripts/run-tsc.mjs --watch",
    "start": "node dist/index.js",
    "test": "node ../../scripts/run-vitest.mjs run",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@nodetool-ai/agents": "*",
    "@nodetool-ai/analytics": "*",
    "@nodetool-ai/app-export": "*",
    "@nodetool-ai/app-runtime": "*",
    "@nodetool-ai/browser": "*",
    "@nodetool-ai/chat": "*",
    "@nodetool-ai/code-nodes": "*",
    "@nodetool-ai/compute": "*",
    "@nodetool-ai/config": "*",
    "@nodetool-ai/core-nodes": "*",
    "@nodetool-ai/data-nodes": "*",
    "@nodetool-ai/deploy": "*",
    "@nodetool-ai/dsl": "*",
    "@nodetool-ai/execution": "*",
    "@nodetool-ai/game-runtime": "*",
    "@nodetool-ai/huggingface": "*",
    "@nodetool-ai/kernel": "*",
    "@nodetool-ai/llm-nodes": "*",
    "@nodetool-ai/models": "*",
    "@nodetool-ai/node-catalog": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/protocol": "*",
    "@nodetool-ai/runtime": "*",
    "@nodetool-ai/sandbox-compiler": "*",
    "@nodetool-ai/security": "*",
    "@nodetool-ai/storage": "*",
    "@nodetool-ai/telegram": "*",
    "@nodetool-ai/text-nodes": "*",
    "@nodetool-ai/vectorstore": "*",
    "@nodetool-ai/websocket": "*",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^4.3.2",
    "marked": "^12.0.0",
    "marked-terminal": "^7.1.0",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "string-width": "^8.1.1",
    "tsx": "^4.0.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13",
    "@nodetool-ai/pack-core": "*",
    "@nodetool-ai/cli": "*",
    "@nodetool-ai/pack-manager": "*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "vitest": "^5.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@nodetool-ai/reliability-harness": "*"
  },
  "exports": {
    ".": {
      "nodetool-dev": "./src/runner.ts",
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js",
      "default": "./dist/runner.js"
    },
    "./runner": {
      "nodetool-dev": "./src/runner.ts",
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js",
      "default": "./dist/runner.js"
    },
    "./chat": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pack-verifier": {
      "nodetool-dev": "./src/pack-verifier.ts",
      "types": "./dist/pack-verifier.d.ts",
      "import": "./dist/pack-verifier.js",
      "default": "./dist/pack-verifier.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/cli-full"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "server.json"
  ],
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "cli",
    "command-line",
    "terminal",
    "agent-mode",
    "chat-cli",
    "mcp",
    "mcp-server",
    "claude-code",
    "image-generation",
    "video-editor",
    "game-engine"
  ],
  "types": "dist/runner.d.ts",
  "mcpName": "io.github.nodetool-ai/nodetool"
}
