{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(camera|look|effect|studio)\\.[a-z0-9-]+$"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "camera",
        "look",
        "effect",
        "studio"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slot": {
      "type": "string",
      "enum": [
        "move",
        "rig",
        "speed",
        "look",
        "effect"
      ]
    },
    "modes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "video",
          "image_to_video",
          "reference_to_video",
          "image",
          "image_edit"
        ]
      }
    },
    "inputs": {
      "default": [
        "text"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text",
          "image",
          "video"
        ]
      }
    },
    "stackable": {
      "default": false,
      "type": "boolean"
    },
    "conflicts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "suffix": {
                "type": "string"
              },
              "replace": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "required": [
        "default"
      ]
    },
    "params": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preview": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "poster": {
          "type": "string",
          "format": "uri"
        },
        "run": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "poster",
        "run"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "string"
    },
    "author": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "name",
    "description",
    "modes",
    "prompt"
  ],
  "additionalProperties": false
}
