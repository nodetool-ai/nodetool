{
  "name": "@nodetool-ai/game-nodes",
  "version": "0.7.0-rc.40",
  "description": "NodeTool game nodes — export a Godot 4 project from a template plus the slot fills a graph produced",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nodetool-ai/godot": "*",
    "@nodetool-ai/godot-templates": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/nodes-utils": "*",
    "@nodetool-ai/protocol": "*",
    "@nodetool-ai/runtime": "*",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nodes/*": {
      "types": "./dist/nodes/*.d.ts",
      "import": "./dist/nodes/*.js",
      "default": "./dist/nodes/*.js"
    },
    "./export-join": {
      "types": "./dist/export-join.d.ts",
      "import": "./dist/export-join.js",
      "default": "./dist/export-join.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/game-nodes"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "game",
    "godot",
    "gamedev"
  ]
}
