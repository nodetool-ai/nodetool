{
  "name": "@nodetool-ai/websocket",
  "version": "0.8.4",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Unified websocket runner for workflow and chat operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-typescript-workspace.mjs",
    "build:all": "node ../../scripts/build-websocket-workspaces.mjs",
    "build:stale": "node ../../scripts/build-stale-websocket-workspaces.mjs",
    "dev": "node ../../scripts/run-websocket-dev.mjs server",
    "dev:fast": "node ../../scripts/run-websocket-dev.mjs server stale",
    "test-ui": "node ../../scripts/run-websocket-dev.mjs test-ui",
    "devserver": "npm run test-ui",
    "test": "node ../../scripts/run-vitest.mjs run",
    "test:watch": "node ../../scripts/run-vitest.mjs",
    "lint": "node ../../scripts/run-tsc.mjs --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.1",
    "@hyzyla/pdfium": "^2.1.12",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nodetool-ai/agents": "*",
    "@nodetool-ai/analytics": "*",
    "@nodetool-ai/app-export": "*",
    "@nodetool-ai/app-runtime": "*",
    "@nodetool-ai/auth": "*",
    "@nodetool-ai/browser": "*",
    "@nodetool-ai/chat": "*",
    "@nodetool-ai/compute": "*",
    "@nodetool-ai/config": "*",
    "@nodetool-ai/dsl": "*",
    "@nodetool-ai/execution": "*",
    "@nodetool-ai/game-runtime": "*",
    "@nodetool-ai/huggingface": "*",
    "@nodetool-ai/image-editor": "*",
    "@nodetool-ai/kernel": "*",
    "@nodetool-ai/model-pricing": "*",
    "@nodetool-ai/models": "*",
    "@nodetool-ai/node-catalog": "*",
    "@nodetool-ai/node-sdk": "*",
    "@nodetool-ai/nodes-utils": "*",
    "@nodetool-ai/protocol": "*",
    "@nodetool-ai/runtime": "*",
    "@nodetool-ai/sandbox-compiler": "*",
    "@nodetool-ai/security": "*",
    "@nodetool-ai/storage": "*",
    "@nodetool-ai/timeline": "*",
    "@nodetool-ai/vectorstore": "*",
    "@opentelemetry/api": "^1.9.0",
    "@trpc/server": "^11.17.0",
    "fastify": "^5.12.7",
    "fflate": "^0.8.2",
    "msgpackr": "^1.11.2",
    "undici": "^7.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "exports": {
    "./server": {
      "nodetool-dev": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./pack-source": {
      "nodetool-dev": "./src/pack-source.ts",
      "types": "./dist/pack-source.d.ts",
      "import": "./dist/pack-source.js",
      "default": "./dist/pack-source.js"
    },
    ".": {
      "nodetool-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./trpc": {
      "nodetool-dev": "./src/trpc/router.ts",
      "types": "./dist/trpc/router.d.ts",
      "import": "./dist/trpc/router.js",
      "default": "./dist/trpc/router.js"
    },
    "./assets": {
      "nodetool-dev": "./src/lib/asset-model-interface.ts",
      "types": "./dist/lib/asset-model-interface.d.ts",
      "import": "./dist/lib/asset-model-interface.js",
      "default": "./dist/lib/asset-model-interface.js"
    },
    "./documents": {
      "nodetool-dev": "./src/lib/document-model-interfaces.ts",
      "types": "./dist/lib/document-model-interfaces.d.ts",
      "import": "./dist/lib/document-model-interfaces.js",
      "default": "./dist/lib/document-model-interfaces.js"
    },
    "./mcp-client-config": {
      "nodetool-dev": "./src/mcp-client-config.ts",
      "types": "./dist/mcp-client-config.d.ts",
      "import": "./dist/mcp-client-config.js",
      "default": "./dist/mcp-client-config.js"
    },
    "./error-traces": {
      "nodetool-dev": "./src/error-traces.ts",
      "types": "./dist/error-traces.d.ts",
      "import": "./dist/error-traces.js",
      "default": "./dist/error-traces.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodetool-ai/nodetool.git",
    "directory": "packages/websocket"
  },
  "homepage": "https://nodetool.ai",
  "bugs": {
    "url": "https://github.com/nodetool-ai/nodetool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nodetool",
    "ai",
    "workflow",
    "workflow-automation",
    "typescript",
    "websocket",
    "fastify",
    "server",
    "api",
    "realtime"
  ],
  "peerDependencies": {
    "sharp": "^0.35.3"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
